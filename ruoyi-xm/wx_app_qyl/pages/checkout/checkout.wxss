.checkout-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 236rpx;
  box-sizing: border-box;
  background: #f3f7fd;
}

.checkout-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 26rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(20, 69, 138, 0.07);
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  display: block;
  color: #20304a;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-desc {
  display: block;
  margin-top: 8rpx;
  color: #72839a;
  font-size: 24rpx;
  line-height: 1.45;
}

.edit-cart-btn,
.line-link {
  flex-shrink: 0;
  color: #237bc7;
  font-size: 25rpx;
  font-weight: 660;
  line-height: 1.4;
}

.checkout-product-list {
  margin-top: 20rpx;
}

.checkout-product-item {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(20, 54, 91, 0.08);
}

.checkout-product-item:first-child {
  border-top: none;
  padding-top: 0;
}

.checkout-product-item:last-child {
  padding-bottom: 0;
}

.product-image {
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: #dbeefa;
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-title {
  display: -webkit-box;
  color: #20304a;
  font-size: 29rpx;
  font-weight: 680;
  line-height: 1.45;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-meta {
  display: block;
  margin-top: 8rpx;
  color: #72839a;
  font-size: 24rpx;
}

.product-price-row {
  margin-top: 14rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
}

.product-price {
  color: #237bc7;
  font-size: 34rpx;
  font-weight: 780;
  line-height: 1;
}

.product-subtotal {
  color: #72839a;
  font-size: 23rpx;
  line-height: 1.2;
  text-align: right;
}

.line-row {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  color: #51657f;
  font-size: 26rpx;
}

.line-label {
  flex-shrink: 0;
  color: #667085;
}

.line-value,
.phone-text {
  flex: 1;
  min-width: 0;
  color: #20304a;
  text-align: right;
  word-break: break-all;
}

.quantity-box {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.quantity-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #eef5ff;
  color: #237bc7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.quantity-value {
  min-width: 38rpx;
  color: #20304a;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
}

.line-value-group {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.line-value-tip {
  color: #7c8ba1;
  font-size: 22rpx;
}

.total-row {
  padding-top: 18rpx;
  border-top: 1rpx solid #edf2fb;
}

.total-label {
  color: #20304a;
  font-size: 29rpx;
  font-weight: 700;
}

.pay-text,
.summary-price {
  color: #20304a;
  font-weight: 760;
}

.pay-text {
  font-size: 34rpx;
}

.rule-line {
  margin-top: 18rpx;
  color: #607089;
  font-size: 25rpx;
  line-height: 1.6;
}

.notice-strip {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f4f8ff;
}

.notice-text {
  color: #4d6586;
  font-size: 24rpx;
  line-height: 1.6;
}

.login-hint {
  display: block;
  margin-top: 18rpx;
  color: #95a3b7;
  font-size: 22rpx;
  line-height: 1.5;
}

.pay-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
  width: 100%;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 -8rpx 30rpx rgba(14, 52, 110, 0.08);
}

.pay-agreement,
.pay-row {
  width: 100%;
  box-sizing: border-box;
}

.pay-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.pay-summary {
  flex: 1;
  min-width: 0;
}

.summary-label {
  display: block;
  color: #72839a;
  font-size: 24rpx;
}

.summary-price {
  display: block;
  margin-top: 6rpx;
  font-size: 38rpx;
  line-height: 1;
}

.pay-btn {
  flex: none;
  width: 300rpx;
  height: 74rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(45, 143, 232, 0.24);
  border-radius: 999rpx;
  box-sizing: border-box;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  color: #2d8fe8;
  font-size: 28rpx;
  font-weight: 680;
  line-height: 72rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.pay-btn::after {
  border: none;
}

.pay-btn:active {
  opacity: 0.9;
  transform: translateY(1rpx) scale(0.985);
}

.pay-btn.is-disabled {
  color: #98a2b3;
  border-color: rgba(148, 163, 184, 0.2);
  background: #f2f4f7;
  box-shadow: none;
}
