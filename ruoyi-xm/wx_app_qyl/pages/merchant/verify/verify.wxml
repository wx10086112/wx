<view class="page-shell">
  <view class="page-head">
    <text class="page-title">到店核销</text>
  </view>

  <view class="scan-card" bindtap="scanCode">
    <view class="scan-icon">
      <view class="scan-corner corner-tl"></view>
      <view class="scan-corner corner-tr"></view>
      <view class="scan-corner corner-bl"></view>
      <view class="scan-corner corner-br"></view>
    </view>
    <view class="scan-copy">
      <text class="scan-title">扫码核销</text>
      <text class="scan-desc">打开相机扫描顾客二维码</text>
    </view>
    <text class="scan-arrow">›</text>
  </view>

  <view class="input-panel panel">
    <view class="panel-head">
      <text class="section-title">手动核销</text>
    </view>
    <input
      class="code-input"
      value="{{manualCode}}"
      placeholder="请输入核销码或订单号"
      bindinput="handleCodeInput"
    />
    <button class="ghost-btn manual-btn" bindtap="submitManualVerify">确认核销</button>
  </view>

  <view wx:if="{{verifyResult}}" class="result-panel panel">
    <text class="section-title">本次核销结果</text>
    <text class="result-title">{{verifyResult.title}}</text>
    <text class="result-meta">订单号 {{verifyResult.orderNo}}</text>
    <text class="result-meta">金额 ¥{{verifyResult.payAmountText}}</text>
    <text class="result-meta">核销人 {{verifyResult.verifyStaffName || '当前账号'}}</text>
    <text class="result-meta">核销时间 {{verifyResult.verifyTimeText}}</text>
  </view>

  <view class="panel recent-panel">
    <view class="panel-head">
      <text class="section-title">最近核销记录</text>
      <text class="head-link" bindtap="goVerifyRecords">查看全部</text>
    </view>
    <view wx:if="{{recentRecordList.length}}">
      <view wx:for="{{recentRecordList}}" wx:key="orderNo" class="recent-row">
        <view class="recent-main">
          <text class="recent-title">{{item.title}}</text>
          <text class="recent-meta">{{item.verifyStaffName || '当前账号'}} · {{item.verifyTimeText}}</text>
          <text wx:if="{{item.failureReason}}" class="recent-error">{{item.failureReason}}</text>
        </view>
        <view class="recent-side">
          <text class="recent-amount {{item.status === 'FAILED' ? 'failed' : ''}}">{{item.amountLabel}}</text>
          <text wx:if="{{item.displayCode}}" class="recent-code">{{item.displayCode}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="empty-inline">
      <text class="empty-text">暂时还没有核销记录</text>
    </view>
  </view>

  <view class="merchant-tabbar safe-area-bottom">
    <view
      wx:for="{{merchantNavList}}"
      wx:key="key"
      class="merchant-tabbar__item {{item.active ? 'active' : ''}}"
      bindtap="goMerchantTab"
      data-url="{{item.url}}"
    >
      <text class="merchant-tabbar__label">{{item.label}}</text>
    </view>
  </view>
</view>
