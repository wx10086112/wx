.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 42%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.panel {
  border-radius: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.76)),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
}

.primary-btn,
.ghost-btn {
  height: 62rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 660;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.primary-btn {
  color: #237bc7;
  border-color: rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
}

.ghost-btn {
  color: #475467;
  border-color: rgba(148, 163, 184, 0.18);
  background: rgba(255, 255, 255, 0.58);
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 660;
}

.status-tag.blue {
  background: #e7f4ff;
  color: #237bc7;
}

.status-tag.green {
  background: #e9f8f1;
  color: #168257;
}

.status-tag.orange {
  background: #fff5e8;
  color: #c76f12;
}

.status-tag.gray {
  background: #edf2f7;
  color: #667085;
}

.tabs-scroll {
  white-space: nowrap;
}

.tabs {
  padding: 8rpx;
  display: inline-flex;
  gap: 10rpx;
  min-width: 100%;
}

.tab-item {
  flex-shrink: 0;
  min-width: 118rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #667085;
  font-size: 24rpx;
}

.tab-item.active {
  color: #237bc7;
  background: #ffffff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.84), 0 8rpx 18rpx rgba(34, 73, 116, 0.08);
  font-weight: 680;
}

.order-card {
  margin-top: 18rpx;
  padding: 28rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.order-main {
  flex: 1;
  min-width: 0;
}

.order-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  text-align: right;
}

.order-no {
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 22rpx;
}

.order-title {
  color: #111827;
  font-size: 31rpx;
  font-weight: 720;
  line-height: 1.35;
}

.order-time {
  color: #667085;
  font-size: 22rpx;
  line-height: 1.4;
}

.order-meta {
  display: block;
  margin-top: 14rpx;
  color: #667085;
  font-size: 24rpx;
}

.order-remark {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.order-bottom {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-amount {
  color: #111827;
  font-size: 32rpx;
  font-weight: 780;
}

.order-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.action-btn {
  min-width: 126rpx;
}

.cancel-btn {
  flex: none;
  width: 156rpx;
  min-width: 0;
  padding: 0;
  box-sizing: border-box;
  color: #237bc7;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
}

.refund-btn {
  color: #237bc7;
}

.cancel-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(17, 24, 39, 0.34);
}

.cancel-modal-card {
  width: 100%;
  padding: 34rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 32rpx 76rpx rgba(34, 73, 116, 0.18);
}

.cancel-modal-title {
  display: block;
  color: #111827;
  font-size: 34rpx;
  font-weight: 760;
}

.cancel-modal-desc {
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.6;
}

.cancel-reason-input {
  margin-top: 24rpx;
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  border-radius: 26rpx;
  background: #f1f7fd;
  color: #111827;
  font-size: 28rpx;
}

.cancel-modal-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.cancel-modal-btn {
  flex: 1;
  height: 74rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  font-size: 27rpx;
  font-weight: 680;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.cancel-modal-btn::after {
  border: none;
}

.cancel-modal-btn.secondary {
  background: rgba(255, 255, 255, 0.58);
  border-color: rgba(148, 163, 184, 0.18);
  color: #475467;
}

.cancel-modal-btn.primary {
  color: #237bc7;
  border-color: rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  color: #667085;
  font-size: 26rpx;
}
