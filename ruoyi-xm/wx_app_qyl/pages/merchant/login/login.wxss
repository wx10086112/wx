.merchant-login-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 42%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 8rpx 6rpx 0;
}

.page-title {
  color: #111827;
  font-size: 40rpx;
  font-weight: 820;
  line-height: 1.25;
}

.page-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e7f4ff;
  color: #237bc7;
  font-size: 22rpx;
  line-height: 1.2;
}

.store-card {
  padding: 32rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.72)),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
}

.store-card__label {
  display: block;
  color: #237bc7;
  font-size: 24rpx;
  font-weight: 680;
  line-height: 1.4;
}

.store-card__body,
.store-card__empty {
  margin-top: 18rpx;
}

.store-card__body {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.store-card__image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f2f4f7;
}

.store-card__name {
  display: block;
  flex: 1;
  min-width: 0;
  color: #111827;
  font-size: 38rpx;
  font-weight: 780;
  line-height: 1.3;
}

.store-card__empty-text {
  display: block;
  color: #667085;
  font-size: 28rpx;
  line-height: 1.6;
}

.form-panel {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
}

.field-group + .field-group {
  margin-top: 20rpx;
}

.panel-label {
  display: block;
  margin-bottom: 12rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.4;
}

.login-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(45, 143, 232, 0.12);
  background: #f8fbfe;
  color: #111827;
  font-size: 28rpx;
}

.agreement-wrap {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(20, 54, 91, 0.08);
}

.login-btn {
  width: 100%;
  margin-top: 28rpx;
}

.login-btn[disabled] {
  opacity: 0.7;
}

.login-tip {
  display: block;
  margin-top: 20rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}
