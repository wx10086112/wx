.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 42%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.panel {
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.76)),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
}

.primary-btn {
  height: 76rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 1rpx solid rgba(45, 143, 232, 0.24);
  border-radius: 999rpx;
  color: #237bc7;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
  font-size: 26rpx;
  font-weight: 680;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn::after {
  border: none;
}

.form-panel {
  padding: 28rpx;
}

.image-uploader {
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 30rpx;
  overflow: hidden;
  background: #e7f4ff;
  border: 1rpx dashed rgba(45, 143, 232, 0.3);
}

.image-uploader.is-disabled,
.image-change-btn.is-disabled {
  opacity: 0.72;
  pointer-events: none;
}

.image-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #237bc7;
}

.image-plus {
  font-size: 64rpx;
  line-height: 1;
}

.image-tip {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 680;
}

.image-subtip {
  display: block;
  margin-top: 12rpx;
  color: #667085;
  font-size: 24rpx;
}

.image-editor {
  padding: 22rpx;
  border-radius: 30rpx;
  background: #f1f7fd;
  border: 1rpx solid rgba(45, 143, 232, 0.12);
}

.image-editor-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.image-editor-title {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 760;
}

.image-change-btn {
  flex-shrink: 0;
  width: 112rpx;
  height: 54rpx;
  line-height: 54rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  border: 1rpx solid rgba(45, 143, 232, 0.2);
  color: #237bc7;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 680;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.image-change-btn::after {
  border: none;
}

.crop-frame {
  position: relative;
  margin-top: 20rpx;
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 22rpx;
  overflow: hidden;
  background: #102a43;
  touch-action: none;
}

.crop-image {
  position: absolute;
  left: -15%;
  top: -15%;
  width: 130%;
  height: 130%;
  will-change: transform;
}

.crop-grid {
  pointer-events: none;
  position: absolute;
  inset: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.82);
}

.grid-line {
  position: absolute;
  background: rgba(255, 255, 255, 0.48);
}

.grid-line.vertical {
  top: 0;
  bottom: 0;
  width: 1rpx;
}

.grid-line.vertical.left {
  left: 33.333%;
}

.grid-line.vertical.right {
  left: 66.666%;
}

.grid-line.horizontal {
  left: 0;
  right: 0;
  height: 1rpx;
}

.grid-line.horizontal.top {
  top: 33.333%;
}

.grid-line.horizontal.bottom {
  top: 66.666%;
}

.crop-toolbar {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 26rpx;
  background: #ffffff;
}

.scale-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.scale-label {
  flex-shrink: 0;
  color: #667085;
  font-size: 24rpx;
  font-weight: 660;
}

.scale-slider {
  flex: 1;
}

.crop-actions {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.crop-action-btn {
  width: 100%;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  color: #475467;
  background: rgba(255, 255, 255, 0.58);
  font-size: 24rpx;
  font-weight: 660;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.crop-action-btn.reset {
  color: #237bc7;
}

.crop-action-btn::after {
  border: none;
}

.field {
  margin-top: 20rpx;
}

.field:first-child {
  margin-top: 0;
}

.field-label {
  display: block;
  color: #667085;
  font-size: 24rpx;
}

.field-input,
.field-textarea {
  width: 100%;
  margin-top: 12rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: #f1f7fd;
  color: #111827;
  font-size: 28rpx;
}

.field-input {
  height: 84rpx;
}

.field-textarea {
  min-height: 180rpx;
  padding-top: 18rpx;
}

.two-col {
  display: flex;
  gap: 14rpx;
}

.field-half {
  flex: 1;
}

.switch-row {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.save-btn {
  margin-top: 30rpx;
}
