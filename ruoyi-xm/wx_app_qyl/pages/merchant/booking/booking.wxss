.booking-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  background:
    radial-gradient(circle at 12% -8%, rgba(45, 143, 232, 0.2), transparent 34%),
    linear-gradient(180deg, #f8fbff 0%, #eef6ff 58%, #f7fbff 100%);
}

.panel {
  border-radius: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.76)),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
}

.tabs-scroll {
  white-space: nowrap;
}

.tabs {
  padding: 8rpx;
  display: inline-flex;
  gap: 10rpx;
  min-width: 100%;
}

.tab-item {
  flex-shrink: 0;
  min-width: 118rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #667085;
  font-size: 24rpx;
}

.tab-item.active {
  color: #237bc7;
  background: #ffffff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.84), 0 8rpx 18rpx rgba(34, 73, 116, 0.08);
  font-weight: 680;
}

.hint-card {
  margin-top: 18rpx;
  padding: 24rpx 28rpx;
}

.hint-title {
  display: block;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 760;
}

.hint-desc {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.55;
}

.booking-list {
  margin-top: 18rpx;
}

.booking-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.booking-top {
  display: flex;
  gap: 20rpx;
}

.booking-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 26rpx;
  background: #dceaf6;
  flex-shrink: 0;
}

.booking-main {
  flex: 1;
  min-width: 0;
}

.booking-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.booking-title {
  flex: 1;
  color: #111827;
  font-size: 31rpx;
  font-weight: 760;
  line-height: 1.35;
}

.status-tag {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 680;
}

.status-tag.blue {
  background: #e7f4ff;
  color: #237bc7;
}

.status-tag.green {
  background: #e9f8f1;
  color: #168257;
}

.status-tag.orange {
  background: #fff5e8;
  color: #c76f12;
}

.status-tag.gray {
  background: #edf2f7;
  color: #667085;
}

.booking-no {
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 22rpx;
}

.booking-price {
  display: block;
  margin-top: 12rpx;
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 780;
}

.booking-info {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 26rpx;
  background: rgba(238, 246, 255, 0.72);
}

.info-line,
.info-remark,
.info-create {
  display: block;
  color: #344054;
  font-size: 24rpx;
  line-height: 1.7;
}

.info-remark {
  color: #475467;
}

.info-create {
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
}

.booking-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  flex-wrap: wrap;
}

.action-btn {
  min-width: 126rpx;
  height: 62rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 680;
}

.action-btn.light {
  color: #475467;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: inset 0 0 0 1rpx rgba(148, 163, 184, 0.18);
}

.action-btn.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #2d8fe8, #1f74ce);
  box-shadow: 0 12rpx 28rpx rgba(45, 143, 232, 0.18);
}

.empty-state {
  margin-top: 18rpx;
  padding: 56rpx 24rpx;
  text-align: center;
}

.empty-title {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 720;
}

.empty-text {
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 25rpx;
}
