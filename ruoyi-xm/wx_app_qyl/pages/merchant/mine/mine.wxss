.mine-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 42%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.profile-card {
  padding: 34rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.72)),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.user-name {
  max-width: 250rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 780;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-pill,
.status-pill {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #237bc7;
  background: #e7f4ff;
  font-size: 22rpx;
  font-weight: 680;
}

.status-pill {
  color: #168257;
  background: #e9f8f1;
}

.user-meta {
  display: block;
  margin-top: 12rpx;
  color: #667085;
  font-size: 25rpx;
}

.store-block {
  margin-top: 30rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: #f1f7fd;
}

.store-name {
  display: block;
  color: #111827;
  font-size: 31rpx;
  font-weight: 720;
}

.store-desc {
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
}

.section-card {
  margin-top: 26rpx;
  padding: 12rpx 26rpx;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
}

.menu-item {
  min-height: 104rpx;
  padding: 20rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid rgba(20, 54, 91, 0.08);
}

.menu-item:active {
  opacity: 0.78;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-label {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 620;
}

.menu-arrow {
  margin-left: 20rpx;
  color: #98a2b3;
  font-size: 40rpx;
  font-weight: 300;
}

.logout-btn {
  margin: 40rpx 0 0;
  height: 78rpx;
  padding: 0;
  border: 1rpx solid rgba(217, 75, 75, 0.22);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d94b4b;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.92), rgba(255, 240, 240, 0.92)),
    #fff0f0;
  font-size: 28rpx;
  font-weight: 680;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.logout-btn:active {
  opacity: 0.9;
  transform: translateY(1rpx) scale(0.985);
}

.logout-btn::after {
  border: none;
}
