.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 42%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.panel {
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.76)),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
}

.primary-btn {
  height: 76rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 1rpx solid rgba(45, 143, 232, 0.24);
  border-radius: 999rpx;
  color: #237bc7;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
  font-size: 26rpx;
  font-weight: 680;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn::after {
  border: none;
}

.form-panel {
  padding: 28rpx;
}

.panel-title {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 760;
}

.panel-title.separator {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(20, 54, 91, 0.08);
}

.field {
  margin-top: 20rpx;
}

.field:first-child {
  margin-top: 0;
}

.field-label {
  display: block;
  color: #667085;
  font-size: 24rpx;
}

.field-input {
  width: 100%;
  height: 84rpx;
  margin-top: 12rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: #f1f7fd;
  color: #111827;
  font-size: 28rpx;
}

.switch-row {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.save-btn {
  margin-top: 30rpx;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  color: #667085;
  font-size: 26rpx;
}
