<view class="page-shell">
  <view class="tabs panel">
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="tab-item {{currentTab === item.value ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="{{item.value}}"
    >
      {{item.label}}
    </view>
  </view>

  <view wx:if="{{recordList.length}}">
    <view wx:for="{{recordList}}" wx:key="recordId" class="record-card panel">
      <view class="record-top">
        <view class="record-main">
          <text class="record-title">{{item.displayTitle}}</text>
          <text wx:if="{{item.codeMetaText}}" class="record-meta">{{item.codeMetaText}}</text>
        </view>
        <view class="status-tag {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="record-grid">
        <text>用户：{{item.customerName || '-'}}</text>
        <text>金额：¥{{item.payAmountText}}</text>
        <text>员工：{{item.verifyStaffName || '-'}}</text>
        <text>时间：{{item.verifyTimeText}}</text>
      </view>
      <text wx:if="{{item.failureReason}}" class="record-error">异常原因：{{item.failureReason}}</text>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-text">暂无核销记录</text>
  </view>
</view>
