<view class="profile-edit-page">
  <view class="edit-section">
    <view class="edit-item edit-item-avatar">
      <text class="edit-label">微信头像</text>
      <view class="edit-value">
        <button
          class="avatar-btn"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
          binderror="onOpenCapabilityError"
        >
          <image src="{{avatarUrl}}" class="edit-avatar" mode="aspectFill"></image>
          <text class="edit-arrow">›</text>
        </button>
      </view>
    </view>

    <view class="edit-item">
      <text class="edit-label">微信昵称</text>
      <view class="edit-value">
        <input
          class="edit-input"
          type="nickname"
          value="{{nickName}}"
          placeholder="点击选择微信昵称"
          bindinput="onNickNameInput"
          bindblur="onNickNameBlur"
          focus="{{nickNameFocus}}"
          maxlength="20"
        />
      </view>
    </view>

    <view class="edit-item">
      <text class="edit-label">手机号</text>
      <view class="edit-value">
        <button
          class="phone-btn"
          open-type="getPhoneNumber"
          bindgetphonenumber="onGetPhoneNumber"
          binderror="onOpenCapabilityError"
          disabled="{{phoneBinding}}"
          phone-number-no-quota-toast="{{true}}"
        >
          <text class="edit-phone">{{phone || '点击绑定手机号'}}</text>
          <text class="edit-arrow">›</text>
        </button>
      </view>
    </view>
  </view>

  <view class="edit-tip">
    <text class="tip-text">头像和昵称用于在小程序内展示，手机号用于到店服务通知</text>
  </view>

  <view wx:if="{{onboardingMode}}" class="save-section">
    <agreement-consent class="profile-agreement"></agreement-consent>
    <button class="save-btn save-btn-wide" bindtap="finishOnboarding" disabled="{{saving || phoneBinding}}">
      {{saving ? '保存中...' : '完成并进入'}}
    </button>
  </view>

  <view wx:elif="{{hasProfileChanged}}" class="save-section">
    <agreement-consent class="profile-agreement"></agreement-consent>
    <button class="save-btn" bindtap="saveProfile" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存'}}
    </button>
  </view>

  <view class="account-section">
    <text class="section-title">账号管理</text>
    <view class="account-card" bindtap="goAccountCancel">
      <text class="account-danger">注销账号</text>
      <text class="account-arrow">›</text>
    </view>
  </view>
</view>
