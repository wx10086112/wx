<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.wxmini.mapper.PlatformIncomeMapper">

    <resultMap type="PlatformIncome" id="PlatformIncomeResult">
        <result property="id" column="id"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="orderAmount" column="order_amount"/>
        <result property="commissionRate" column="commission_rate"/>
        <result property="commission" column="commission"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectPlatformIncomeVo">
        select id, merchant_id, order_no, order_amount, commission_rate, commission, create_time
        from platform_income
    </sql>

    <select id="selectPlatformIncomeList" parameterType="PlatformIncome" resultMap="PlatformIncomeResult">
        <include refid="selectPlatformIncomeVo"/>
        <where>
            <if test="merchantId != null">and merchant_id = #{merchantId}</if>
            <if test="orderNo != null and orderNo != ''">and order_no = #{orderNo}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectPlatformIncomeById" parameterType="Long" resultMap="PlatformIncomeResult">
        <include refid="selectPlatformIncomeVo"/>
        where id = #{id}
    </select>

    <select id="selectPlatformIncomeByMerchantId" parameterType="Long" resultMap="PlatformIncomeResult">
        <include refid="selectPlatformIncomeVo"/>
        where merchant_id = #{merchantId}
        order by create_time desc
    </select>

    <insert id="insertPlatformIncome" parameterType="PlatformIncome" useGeneratedKeys="true" keyProperty="id">
        insert into platform_income
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="orderAmount != null">order_amount,</if>
            <if test="commissionRate != null">commission_rate,</if>
            <if test="commission != null">commission,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="orderAmount != null">#{orderAmount},</if>
            <if test="commissionRate != null">#{commissionRate},</if>
            <if test="commission != null">#{commission},</if>
        </trim>
    </insert>

    <update id="updatePlatformIncome" parameterType="PlatformIncome">
        update platform_income
        <trim prefix="SET" suffixOverrides=",">
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="orderNo != null and orderNo != ''">order_no = #{orderNo},</if>
            <if test="orderAmount != null">order_amount = #{orderAmount},</if>
            <if test="commissionRate != null">commission_rate = #{commissionRate},</if>
            <if test="commission != null">commission = #{commission},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePlatformIncomeById" parameterType="Long">
        delete from platform_income where id = #{id}
    </delete>

    <delete id="deletePlatformIncomeByIds" parameterType="String">
        delete from platform_income where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
