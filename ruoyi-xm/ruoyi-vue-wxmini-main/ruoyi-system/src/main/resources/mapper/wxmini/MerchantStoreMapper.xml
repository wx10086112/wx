<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.wxmini.mapper.MerchantStoreMapper">

    <resultMap type="MerchantStore" id="MerchantStoreResult">
        <result property="id" column="id"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="name" column="name"/>
        <result property="contact" column="contact"/>
        <result property="phone" column="phone"/>
        <result property="address" column="address"/>
        <result property="longitude" column="longitude"/>
        <result property="latitude" column="latitude"/>
        <result property="businessHours" column="business_hours"/>
        <result property="avatar" column="avatar"/>
        <result property="status" column="status"/>
        <result property="isMain" column="is_main"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectMerchantStoreVo">
        select id, merchant_id, name, contact, phone, address, longitude, latitude,
               business_hours, avatar, status, is_main, create_time, update_time
        from merchant_store
    </sql>

    <select id="selectMerchantStoreList" parameterType="MerchantStore" resultMap="MerchantStoreResult">
        <include refid="selectMerchantStoreVo"/>
        <where>
            <if test="merchantId != null">and merchant_id = #{merchantId}</if>
            <if test="name != null and name != ''">and name like concat('%', #{name}, '%')</if>
            <if test="status != null">and status = #{status}</if>
        </where>
    </select>

    <select id="selectMerchantStoreById" parameterType="Long" resultMap="MerchantStoreResult">
        <include refid="selectMerchantStoreVo"/>
        where id = #{id}
    </select>

    <select id="selectMerchantStoreByMerchantId" parameterType="Long" resultMap="MerchantStoreResult">
        <include refid="selectMerchantStoreVo"/>
        where merchant_id = #{merchantId}
    </select>

    <insert id="insertMerchantStore" parameterType="MerchantStore" useGeneratedKeys="true" keyProperty="id">
        insert into merchant_store
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="contact != null">contact,</if>
            <if test="phone != null">phone,</if>
            <if test="address != null">address,</if>
            <if test="longitude != null">longitude,</if>
            <if test="latitude != null">latitude,</if>
            <if test="businessHours != null">business_hours,</if>
            <if test="avatar != null">avatar,</if>
            <if test="status != null">status,</if>
            <if test="isMain != null">is_main,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="contact != null">#{contact},</if>
            <if test="phone != null">#{phone},</if>
            <if test="address != null">#{address},</if>
            <if test="longitude != null">#{longitude},</if>
            <if test="latitude != null">#{latitude},</if>
            <if test="businessHours != null">#{businessHours},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="status != null">#{status},</if>
            <if test="isMain != null">#{isMain},</if>
        </trim>
    </insert>

    <update id="updateMerchantStore" parameterType="MerchantStore">
        update merchant_store
        <trim prefix="SET" suffixOverrides=",">
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="contact != null">contact = #{contact},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="address != null">address = #{address},</if>
            <if test="longitude != null">longitude = #{longitude},</if>
            <if test="latitude != null">latitude = #{latitude},</if>
            <if test="businessHours != null">business_hours = #{businessHours},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="status != null">status = #{status},</if>
            <if test="isMain != null">is_main = #{isMain},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMerchantStoreById" parameterType="Long">
        delete from merchant_store where id = #{id}
    </delete>

    <delete id="deleteMerchantStoreByIds" parameterType="String">
        delete from merchant_store where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
