            <if test="remark != null">remark,</if>
            <if test="cMiniAppId != null">c_mini_app_id,</if>
            <if test="cMiniAppSecret != null">c_mini_app_secret,</if>
            <if test="mMiniAppId != null">m_mini_app_id,</if>
            <if test="mMiniAppSecret != null">m_mini_app_secret,</if>
            <if test="wxPayMchId != null">wx_pay_mch_id,</if>
            <if test="wxPayApiKey != null">wx_pay_api_key,</if>
            <if test="receiverOpenid != null">receiver_openid,</if>
            <if test="receiverType != null">receiver_type,</if>
            <if test="mapClaimStatus != null">map_claim_status,</if>
            <if test="mapPoiId != null">map_poi_id,</if>
            <if test="mapClaimUrl != null">map_claim_url,</if>
            <if test="mapClaimTime != null">map_claim_time,</if>
            <if test="mapClaimRemark != null">map_claim_remark,</if>
            <if test="wxApplymentId != null">wx_applyment_id,</if>
            <if test="wxApplymentState != null">wx_applyment_state,</if>
            <if test="wxApplymentRejectReason != null">wx_applyment_reject_reason,</if>
            <if test="wxApplymentTime != null">wx_applyment_time,</if>
            <if test="wxApplymentFinishTime != null">wx_applyment_finish_time,</if>
            <if test="wxPaymentAccessType != null">wx_payment_access_type,</if>
            <if test="merchantWxMchId != null">merchant_wx_mch_id,</if>
            <if test="merchantWxMchName != null">merchant_wx_mch_name,</if>
            <if test="wxProfitSharingEnabled != null">wx_profit_sharing_enabled,</if>
            <if test="platformReceiverMchId != null">platform_receiver_mch_id,</if>
            <if test="distributorReceiverMchId != null">distributor_receiver_mch_id,</if>
            <if test="merchantShareRate != null">merchant_share_rate,</if>
            <if test="platformShareRate != null">platform_share_rate,</if>
            <if test="distributorShareRate != null">distributor_share_rate,</if>
            <if test="settlementCycle != null">settlement_cycle,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="distributorId != null">#{distributorId},</if>
            <if test="name != null">#{name},</if>
            <if test="logo != null">#{logo},</if>
            <if test="contact != null">#{contact},</if>
            <if test="phone != null">#{phone},</if>
            <if test="commissionRate != null">#{commissionRate},</if>
            <if test="status != null">#{status},</if>
            <if test="balance != null">#{balance},</if>
            <if test="totalIncome != null">#{totalIncome},</if>
            <if test="address != null">#{address},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="description != null">#{description},</if>
            <if test="businessHours != null">#{businessHours},</if>
            <if test="productCount != null">#{productCount},</if>
            <if test="storeCount != null">#{storeCount},</if>
            <if test="remark != null">#{remark},</if>
            <if test="cMiniAppId != null">#{cMiniAppId},</if>
            <if test="cMiniAppSecret != null">#{cMiniAppSecret},</if>
            <if test="mMiniAppId != null">#{mMiniAppId},</if>
            <if test="mMiniAppSecret != null">#{mMiniAppSecret},</if>
            <if test="wxPayMchId != null">#{wxPayMchId},</if>
            <if test="wxPayApiKey != null">#{wxPayApiKey},</if>
            <if test="receiverOpenid != null">#{receiverOpenid},</if>
            <if test="receiverType != null">#{receiverType},</if>
            <if test="mapClaimStatus != null">#{mapClaimStatus},</if>
            <if test="mapPoiId != null">#{mapPoiId},</if>
            <if test="mapClaimUrl != null">#{mapClaimUrl},</if>
            <if test="mapClaimTime != null">#{mapClaimTime},</if>
            <if test="mapClaimRemark != null">#{mapClaimRemark},</if>
            <if test="wxApplymentId != null">#{wxApplymentId},</if>
            <if test="wxApplymentState != null">#{wxApplymentState},</if>
            <if test="wxApplymentRejectReason != null">#{wxApplymentRejectReason},</if>
            <if test="wxApplymentTime != null">#{wxApplymentTime},</if>
            <if test="wxApplymentFinishTime != null">#{wxApplymentFinishTime},</if>
            <if test="wxPaymentAccessType != null">#{wxPaymentAccessType},</if>
            <if test="merchantWxMchId != null">#{merchantWxMchId},</if>
            <if test="merchantWxMchName != null">#{merchantWxMchName},</if>
            <if test="wxProfitSharingEnabled != null">#{wxProfitSharingEnabled},</if>
