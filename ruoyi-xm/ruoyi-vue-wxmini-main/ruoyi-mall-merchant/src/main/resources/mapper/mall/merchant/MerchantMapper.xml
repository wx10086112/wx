<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.merchant.mapper.MerchantMapper">

    <resultMap type="com.ruoyi.mall.merchant.domain.Merchant" id="MerchantResult">
        <result property="id" column="id"/>
        <result property="distributorId" column="distributor_id"/>
        <result property="name" column="name"/>
        <result property="logo" column="logo"/>
        <result property="contact" column="contact"/>
        <result property="phone" column="phone"/>
        <result property="commissionRate" column="commission_rate"/>
        <result property="status" column="status"/>
        <result property="balance" column="balance"/>
        <result property="totalIncome" column="total_income"/>
        <result property="address" column="address"/>
        <result property="avatar" column="avatar"/>
        <result property="description" column="description"/>
        <result property="businessHours" column="business_hours"/>
        <result property="productCount" column="product_count"/>
        <result property="storeCount" column="store_count"/>
        <result property="cMiniAppId" column="c_mini_app_id"/>
        <result property="cMiniAppSecret" column="c_mini_app_secret"/>
        <result property="mMiniAppId" column="m_mini_app_id"/>
        <result property="mMiniAppSecret" column="m_mini_app_secret"/>
        <result property="wxPayMchId" column="wx_pay_mch_id"/>
        <result property="wxPayApiKey" column="wx_pay_api_key"/>
        <result property="receiverOpenid" column="receiver_openid"/>
        <result property="receiverType" column="receiver_type"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectMerchantVo">
        select id, distributor_id, name, logo, contact, phone, commission_rate, status, balance,
               total_income, address, avatar, description, business_hours,
               product_count, store_count, c_mini_app_id, c_mini_app_secret,
               m_mini_app_id, m_mini_app_secret, wx_pay_mch_id, wx_pay_api_key,
               receiver_openid, receiver_type,
               create_time, update_time, remark
        from merchant
    </sql>

    <select id="selectMerchantList" parameterType="com.ruoyi.mall.merchant.domain.Merchant" resultMap="MerchantResult">
        <include refid="selectMerchantVo"/>
        <where>
            and del_flag = '0'
            <if test="distributorId != null">and distributor_id = #{distributorId}</if>
            <if test="name != null and name != ''">and name like concat('%', #{name}, '%')</if>
            <if test="contact != null and contact != ''">and contact like concat('%', #{contact}, '%')</if>
            <if test="phone != null and phone != ''">and phone = #{phone}</if>
            <if test="status != null">and status = #{status}</if>
            <if test="params.dataScopeBiz != null and params.dataScopeBiz != ''">${params.dataScopeBiz}</if>
        </where>
        order by id desc
    </select>

    <select id="selectMerchantById" parameterType="Long" resultMap="MerchantResult">
        <include refid="selectMerchantVo"/>
        where id = #{id} AND del_flag = '0'
    </select>

    <insert id="insertMerchant" parameterType="com.ruoyi.mall.merchant.domain.Merchant" useGeneratedKeys="true" keyProperty="id">
        insert into merchant
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="logo != null">logo,</if>
            <if test="contact != null">contact,</if>
            <if test="phone != null">phone,</if>
            <if test="commissionRate != null">commission_rate,</if>
            <if test="status != null">status,</if>
            <if test="balance != null">balance,</if>
            <if test="totalIncome != null">total_income,</if>
            <if test="address != null">address,</if>
            <if test="avatar != null">avatar,</if>
            <if test="description != null">description,</if>
            <if test="businessHours != null">business_hours,</if>
            <if test="productCount != null">product_count,</if>
            <if test="storeCount != null">store_count,</if>
            <if test="remark != null">remark,</if>
            <if test="cMiniAppId != null">c_mini_app_id,</if>
            <if test="cMiniAppSecret != null">c_mini_app_secret,</if>
            <if test="mMiniAppId != null">m_mini_app_id,</if>
            <if test="mMiniAppSecret != null">m_mini_app_secret,</if>
            <if test="wxPayMchId != null">wx_pay_mch_id,</if>
            <if test="wxPayApiKey != null">wx_pay_api_key,</if>
            <if test="receiverOpenid != null">receiver_openid,</if>
            <if test="receiverType != null">receiver_type,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="logo != null">#{logo},</if>
            <if test="contact != null">#{contact},</if>
            <if test="phone != null">#{phone},</if>
            <if test="commissionRate != null">#{commissionRate},</if>
            <if test="status != null">#{status},</if>
            <if test="balance != null">#{balance},</if>
            <if test="totalIncome != null">#{totalIncome},</if>
            <if test="address != null">#{address},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="description != null">#{description},</if>
            <if test="businessHours != null">#{businessHours},</if>
            <if test="productCount != null">#{productCount},</if>
            <if test="storeCount != null">#{storeCount},</if>
            <if test="remark != null">#{remark},</if>
            <if test="cMiniAppId != null">#{cMiniAppId},</if>
            <if test="cMiniAppSecret != null">#{cMiniAppSecret},</if>
            <if test="mMiniAppId != null">#{mMiniAppId},</if>
            <if test="mMiniAppSecret != null">#{mMiniAppSecret},</if>
            <if test="wxPayMchId != null">#{wxPayMchId},</if>
            <if test="wxPayApiKey != null">#{wxPayApiKey},</if>
            <if test="receiverOpenid != null">#{receiverOpenid},</if>
            <if test="receiverType != null">#{receiverType},</if>
        </trim>
    </insert>

    <update id="updateMerchant" parameterType="com.ruoyi.mall.merchant.domain.Merchant">
        update merchant
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="logo != null">logo = #{logo},</if>
            <if test="contact != null">contact = #{contact},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="commissionRate != null">commission_rate = #{commissionRate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="balance != null">balance = #{balance},</if>
            <if test="totalIncome != null">total_income = #{totalIncome},</if>
            <if test="address != null">address = #{address},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="description != null">description = #{description},</if>
            <if test="businessHours != null">business_hours = #{businessHours},</if>
            <if test="productCount != null">product_count = #{productCount},</if>
            <if test="storeCount != null">store_count = #{storeCount},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="cMiniAppId != null">c_mini_app_id = #{cMiniAppId},</if>
            <if test="cMiniAppSecret != null">c_mini_app_secret = #{cMiniAppSecret},</if>
            <if test="mMiniAppId != null">m_mini_app_id = #{mMiniAppId},</if>
            <if test="mMiniAppSecret != null">m_mini_app_secret = #{mMiniAppSecret},</if>
            <if test="wxPayMchId != null">wx_pay_mch_id = #{wxPayMchId},</if>
            <if test="wxPayApiKey != null">wx_pay_api_key = #{wxPayApiKey},</if>
            <if test="receiverOpenid != null">receiver_openid = #{receiverOpenid},</if>
            <if test="receiverType != null">receiver_type = #{receiverType},</if>
        </trim>
        where id = #{id}
    </update>

    <select id="selectMerchantByCAppId" parameterType="String" resultMap="MerchantResult">
        <include refid="selectMerchantVo"/>
        where c_mini_app_id = #{cMiniAppId} AND del_flag = '0'
    </select>

    <select id="selectMerchantByMAppId" parameterType="String" resultMap="MerchantResult">
        <include refid="selectMerchantVo"/>
        where m_mini_app_id = #{mMiniAppId} AND del_flag = '0'
    </select>

    <update id="deleteMerchantById" parameterType="Long">
        update merchant set del_flag = '2' where id = #{id}
    </update>

    <update id="deleteMerchantByIds" parameterType="String">
        update merchant set del_flag = '2' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
