        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.merchant.mapper.MerchantMapper">

    <resultMap type="com.ruoyi.mall.merchant.domain.Merchant" id="MerchantResult">
        <result property="id" column="id"/>
        <result property="distributorId" column="distributor_id"/>
        <result property="distributorName" column="distributor_name"/>
        <result property="name" column="name"/>
        <result property="logo" column="logo"/>
        <result property="contact" column="contact"/>
        <result property="phone" column="phone"/>
        <result property="commissionRate" column="commission_rate"/>
        <result property="status" column="status"/>
        <result property="balance" column="balance"/>
        <result property="totalIncome" column="total_income"/>
        <result property="address" column="address"/>
        <result property="avatar" column="avatar"/>
        <result property="description" column="description"/>
        <result property="businessHours" column="business_hours"/>
        <result property="productCount" column="product_count"/>
        <result property="storeCount" column="store_count"/>
        <result property="cMiniAppId" column="c_mini_app_id"/>
        <result property="cMiniAppSecret" column="c_mini_app_secret"/>
        <result property="mMiniAppId" column="m_mini_app_id"/>
        <result property="mMiniAppSecret" column="m_mini_app_secret"/>
        <result property="wxPayMchId" column="wx_pay_mch_id"/>
        <result property="wxPayApiKey" column="wx_pay_api_key"/>
