        <result property="mapClaimStatus" column="map_claim_status"/>
        <result property="mapPoiId" column="map_poi_id"/>
        <result property="mapClaimUrl" column="map_claim_url"/>
        <result property="mapClaimTime" column="map_claim_time"/>
        <result property="mapClaimRemark" column="map_claim_remark"/>
        <result property="wxApplymentId" column="wx_applyment_id"/>
        <result property="wxApplymentState" column="wx_applyment_state"/>
        <result property="wxApplymentRejectReason" column="wx_applyment_reject_reason"/>
        <result property="wxApplymentTime" column="wx_applyment_time"/>
        <result property="wxApplymentFinishTime" column="wx_applyment_finish_time"/>
        <result property="wxPaymentAccessType" column="wx_payment_access_type"/>
        <result property="merchantWxMchId" column="merchant_wx_mch_id"/>
        <result property="merchantWxMchName" column="merchant_wx_mch_name"/>
        <result property="wxProfitSharingEnabled" column="wx_profit_sharing_enabled"/>
        <result property="platformReceiverMchId" column="platform_receiver_mch_id"/>
        <result property="distributorReceiverMchId" column="distributor_receiver_mch_id"/>
        <result property="merchantShareRate" column="merchant_share_rate"/>
        <result property="platformShareRate" column="platform_share_rate"/>
        <result property="distributorShareRate" column="distributor_share_rate"/>
        <result property="settlementCycle" column="settlement_cycle"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectMerchantVo">
        select m.id, m.distributor_id, m.name, m.logo, m.contact, m.phone, m.commission_rate, m.status, m.balance,
               m.total_income, m.address, m.avatar, m.description, m.business_hours,
               m.product_count, m.store_count, m.c_mini_app_id, m.c_mini_app_secret,
               m.m_mini_app_id, m.m_mini_app_secret, m.wx_pay_mch_id, m.wx_pay_api_key,
               m.receiver_openid, m.receiver_type,
               m.map_claim_status, m.map_poi_id, m.map_claim_url, m.map_claim_time, m.map_claim_remark,
               m.wx_applyment_id, m.wx_applyment_state, m.wx_applyment_reject_reason,
               m.wx_applyment_time, m.wx_applyment_finish_time,
               m.wx_payment_access_type, m.merchant_wx_mch_id, m.merchant_wx_mch_name,
               m.wx_profit_sharing_enabled, m.platform_receiver_mch_id, m.distributor_receiver_mch_id,
               m.merchant_share_rate, m.platform_share_rate, m.distributor_share_rate, m.settlement_cycle,
               m.create_time, m.update_time, m.remark,
               d.name as distributor_name
        from merchant m
        left join distributor d on d.id = m.distributor_id and d.del_flag = '0'
    </sql>

    <select id="selectMerchantList" parameterType="com.ruoyi.mall.merchant.domain.Merchant" resultMap="MerchantResult">
        <include refid="selectMerchantVo"/>
        <where>
            and m.del_flag = '0'
            <if test="distributorId != null">and m.distributor_id = #{distributorId}</if>
            <if test="name != null and name != ''">and m.name like concat('%', #{name}, '%')</if>
            <if test="contact != null and contact != ''">and m.contact like concat('%', #{contact}, '%')</if>
            <if test="phone != null and phone != ''">and m.phone = #{phone}</if>
            <if test="status != null">and m.status = #{status}</if>
            <if test="params.dataScopeBiz != null and params.dataScopeBiz != ''">${params.dataScopeBiz}</if>
        </where>
        order by m.id desc
    </select>

    <select id="selectMerchantById" parameterType="Long" resultMap="MerchantResult">
        <include refid="selectMerchantVo"/>
        where m.id = #{id} AND m.del_flag = '0'
    </select>

    <insert id="insertMerchant" parameterType="com.ruoyi.mall.merchant.domain.Merchant" useGeneratedKeys="true" keyProperty="id">
        insert into merchant
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="distributorId != null">distributor_id,</if>
            <if test="name != null">name,</if>
            <if test="logo != null">logo,</if>
            <if test="contact != null">contact,</if>
            <if test="phone != null">phone,</if>
            <if test="commissionRate != null">commission_rate,</if>
