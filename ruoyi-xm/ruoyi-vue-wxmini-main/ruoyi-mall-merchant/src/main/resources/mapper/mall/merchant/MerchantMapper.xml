            <if test="merchantWxMchName != null">merchant_wx_mch_name = #{merchantWxMchName},</if>
            <if test="wxProfitSharingEnabled != null">wx_profit_sharing_enabled = #{wxProfitSharingEnabled},</if>
            <if test="platformReceiverMchId != null">platform_receiver_mch_id = #{platformReceiverMchId},</if>
            <if test="distributorReceiverMchId != null">distributor_receiver_mch_id = #{distributorReceiverMchId},</if>
            <if test="merchantShareRate != null">merchant_share_rate = #{merchantShareRate},</if>
            <if test="platformShareRate != null">platform_share_rate = #{platformShareRate},</if>
            <if test="distributorShareRate != null">distributor_share_rate = #{distributorShareRate},</if>
            <if test="settlementCycle != null">settlement_cycle = #{settlementCycle},</if>
        </trim>
        where id = #{id}
    </update>

    <select id="selectMerchantByCAppId" parameterType="String" resultMap="MerchantResult">
        <include refid="selectMerchantVo"/>
        where m.c_mini_app_id = #{cMiniAppId} AND m.del_flag = '0'
    </select>

    <select id="selectMerchantByMAppId" parameterType="String" resultMap="MerchantResult">
        <include refid="selectMerchantVo"/>
        where m.m_mini_app_id = #{mMiniAppId} AND m.del_flag = '0'
    </select>

    <update id="deleteMerchantById" parameterType="Long">
        update merchant set del_flag = '2' where id = #{id}
    </update>

    <update id="deleteMerchantByIds" parameterType="String">
        update merchant set del_flag = '2' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
