            <if test="wxApplymentState != null">wx_applyment_state = #{wxApplymentState},</if>
            <if test="wxApplymentRejectReason != null">wx_applyment_reject_reason = #{wxApplymentRejectReason},</if>
            <if test="wxApplymentTime != null">wx_applyment_time = #{wxApplymentTime},</if>
            <if test="wxApplymentFinishTime != null">wx_applyment_finish_time = #{wxApplymentFinishTime},</if>
