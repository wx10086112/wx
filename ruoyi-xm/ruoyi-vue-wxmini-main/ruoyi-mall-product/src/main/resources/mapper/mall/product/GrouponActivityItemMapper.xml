<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.product.mapper.GrouponActivityItemMapper">

    <resultMap type="com.ruoyi.mall.product.domain.GrouponActivityItem" id="GrouponActivityItemResult">
        <result property="id" column="id"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="grouponId" column="groupon_id"/>
        <result property="name" column="name"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="description" column="description"/>
        <result property="coverImage" column="cover_image"/>
        <result property="detailImages" column="detail_images"/>
        <result property="originalPrice" column="original_price"/>
        <result property="grouponPrice" column="groupon_price"/>
        <result property="discountRate" column="discount_rate"/>
        <result property="stock" column="stock"/>
        <result property="sales" column="sales"/>
        <result property="limitPerUser" column="limit_per_user"/>
        <result property="validDays" column="valid_days"/>
        <result property="storeIds" column="store_ids"/>
        <result property="dishGroups" column="dish_groups"/>
        <result property="dishTotalPrice" column="dish_total_price"/>
        <result property="directTotalPrice" column="direct_total_price"/>
        <result property="dishCount" column="dish_count"/>
        <result property="availableDishCount" column="available_dish_count"/>
        <result property="status" column="status"/>
        <result property="sort" column="sort"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectGrouponActivityItemVo">
        select gai.id, gai.merchant_id, gai.groupon_id, gai.name, gai.title, gai.content, gai.description,
               gai.cover_image, gai.detail_images, gai.original_price, gai.groupon_price, gai.discount_rate,
               gai.stock, gai.sales, gai.limit_per_user, gai.valid_days, gai.store_ids,
               gai.dish_groups, gai.dish_total_price, gai.direct_total_price, gai.dish_count, gai.available_dish_count,
               gai.status, gai.sort, gai.create_time, gai.update_time, gai.del_flag
        from groupon_activity_item gai
        left join merchant m on m.id = gai.merchant_id and m.del_flag = '0'
    </sql>

    <sql id="dataScopeBizFilter">
        <if test="params.dataScopeBizDistributorId != null">and m.distributor_id = #{params.dataScopeBizDistributorId}</if>
        <if test="params.dataScopeBizMerchantId != null">and gai.merchant_id = #{params.dataScopeBizMerchantId}</if>
    </sql>

    <select id="selectGrouponActivityItemById" parameterType="Long" resultMap="GrouponActivityItemResult">
        <include refid="selectGrouponActivityItemVo"/>
        where gai.id = #{id} AND gai.del_flag = '0'
    </select>

    <select id="selectGrouponActivityItemList" parameterType="com.ruoyi.mall.product.domain.GrouponActivityItem" resultMap="GrouponActivityItemResult">
        <include refid="selectGrouponActivityItemVo"/>
        <where>
            gai.del_flag = '0'
            <if test="name != null and name != ''">and gai.name like concat('%', #{name}, '%')</if>
            <if test="merchantId != null">and gai.merchant_id = #{merchantId}</if>
            <if test="grouponId != null">and gai.groupon_id = #{grouponId}</if>
            <if test="status != null">and gai.status = #{status}</if>
            <include refid="dataScopeBizFilter"/>
        </where>
        order by gai.sort desc, gai.create_time desc
    </select>

    <select id="selectByGrouponId" parameterType="Long" resultMap="GrouponActivityItemResult">
        <include refid="selectGrouponActivityItemVo"/>
        where gai.groupon_id = #{grouponId} AND gai.del_flag = '0'
        order by gai.sort desc, gai.create_time desc
    </select>

    <insert id="insertGrouponActivityItem" parameterType="com.ruoyi.mall.product.domain.GrouponActivityItem" useGeneratedKeys="true" keyProperty="id">
        insert into groupon_activity_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="grouponId != null">groupon_id,</if>
            <if test="name != null">name,</if>
            <if test="title != null">title,</if>
            <if test="content != null">content,</if>
            <if test="description != null">description,</if>
            <if test="coverImage != null">cover_image,</if>
            <if test="detailImages != null">detail_images,</if>
            <if test="originalPrice != null">original_price,</if>
            <if test="grouponPrice != null">groupon_price,</if>
            <if test="discountRate != null">discount_rate,</if>
            <if test="stock != null">stock,</if>
            <if test="sales != null">sales,</if>
            <if test="limitPerUser != null">limit_per_user,</if>
            <if test="validDays != null">valid_days,</if>
            <if test="storeIds != null">store_ids,</if>
            <if test="dishGroups != null">dish_groups,</if>
            <if test="dishTotalPrice != null">dish_total_price,</if>
            <if test="directTotalPrice != null">direct_total_price,</if>
            <if test="dishCount != null">dish_count,</if>
            <if test="availableDishCount != null">available_dish_count,</if>
            <if test="status != null">status,</if>
            <if test="sort != null">sort,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="grouponId != null">#{grouponId},</if>
            <if test="name != null">#{name},</if>
            <if test="title != null">#{title},</if>
            <if test="content != null">#{content},</if>
            <if test="description != null">#{description},</if>
            <if test="coverImage != null">#{coverImage},</if>
            <if test="detailImages != null">#{detailImages},</if>
            <if test="originalPrice != null">#{originalPrice},</if>
            <if test="grouponPrice != null">#{grouponPrice},</if>
            <if test="discountRate != null">#{discountRate},</if>
            <if test="stock != null">#{stock},</if>
            <if test="sales != null">#{sales},</if>
            <if test="limitPerUser != null">#{limitPerUser},</if>
            <if test="validDays != null">#{validDays},</if>
            <if test="storeIds != null">#{storeIds},</if>
            <if test="dishGroups != null">#{dishGroups},</if>
            <if test="dishTotalPrice != null">#{dishTotalPrice},</if>
            <if test="directTotalPrice != null">#{directTotalPrice},</if>
            <if test="dishCount != null">#{dishCount},</if>
            <if test="availableDishCount != null">#{availableDishCount},</if>
            <if test="status != null">#{status},</if>
            <if test="sort != null">#{sort},</if>
        </trim>
    </insert>

    <update id="updateGrouponActivityItem" parameterType="com.ruoyi.mall.product.domain.GrouponActivityItem">
        update groupon_activity_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="grouponId != null">groupon_id = #{grouponId},</if>
            <if test="name != null">name = #{name},</if>
            <if test="title != null">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="description != null">description = #{description},</if>
            <if test="coverImage != null">cover_image = #{coverImage},</if>
            <if test="detailImages != null">detail_images = #{detailImages},</if>
            <if test="originalPrice != null">original_price = #{originalPrice},</if>
            <if test="grouponPrice != null">groupon_price = #{grouponPrice},</if>
            <if test="discountRate != null">discount_rate = #{discountRate},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="sales != null">sales = #{sales},</if>
            <if test="limitPerUser != null">limit_per_user = #{limitPerUser},</if>
            <if test="validDays != null">valid_days = #{validDays},</if>
            <if test="storeIds != null">store_ids = #{storeIds},</if>
            <if test="dishGroups != null">dish_groups = #{dishGroups},</if>
            <if test="dishTotalPrice != null">dish_total_price = #{dishTotalPrice},</if>
            <if test="directTotalPrice != null">direct_total_price = #{directTotalPrice},</if>
            <if test="dishCount != null">dish_count = #{dishCount},</if>
            <if test="availableDishCount != null">available_dish_count = #{availableDishCount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sort != null">sort = #{sort},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deleteGrouponActivityItemById" parameterType="Long">
        update groupon_activity_item set del_flag = '2' where id = #{id}
    </update>

    <update id="deleteGrouponActivityItemByIds" parameterType="String">
        update groupon_activity_item set del_flag = '2' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="deleteByGrouponId" parameterType="Long">
        update groupon_activity_item set del_flag = '2' where groupon_id = #{grouponId}
    </update>

</mapper>
