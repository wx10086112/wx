<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.product.mapper.ProductCategoryMapper">

    <resultMap type="com.ruoyi.mall.product.domain.ProductCategory" id="ProductCategoryResult">
        <result property="id" column="id"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="name" column="name"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectProductCategoryVo">
        select id, merchant_id, name, sort, status, create_time, update_time, remark
        from product_category
    </sql>

    <select id="selectProductCategoryList" parameterType="com.ruoyi.mall.product.domain.ProductCategory" resultMap="ProductCategoryResult">
        <include refid="selectProductCategoryVo"/>
        <where>
            and del_flag = '0'
            <if test="name != null and name != ''">and name like concat('%', #{name}, '%')</if>
            <if test="merchantId != null">and merchant_id = #{merchantId}</if>
            <if test="status != null">and status = #{status}</if>
        </where>
        order by sort asc, create_time desc
    </select>

    <select id="selectProductCategoryById" parameterType="Long" resultMap="ProductCategoryResult">
        <include refid="selectProductCategoryVo"/>
        where id = #{id} AND del_flag = '0'
    </select>

    <select id="selectProductCategoryByMerchantId" parameterType="Long" resultMap="ProductCategoryResult">
        <include refid="selectProductCategoryVo"/>
        where merchant_id = #{merchantId} AND del_flag = '0'
        order by sort asc, create_time desc
    </select>

    <insert id="insertProductCategory" parameterType="com.ruoyi.mall.product.domain.ProductCategory" useGeneratedKeys="true" keyProperty="id">
        insert into product_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="name != null">name,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null">status,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="name != null">#{name},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null">#{status},</if>
        </trim>
    </insert>

    <update id="updateProductCategory" parameterType="com.ruoyi.mall.product.domain.ProductCategory">
        update product_category
        <trim prefix="SET" suffixOverrides=",">
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="name != null">name = #{name},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deleteProductCategoryById" parameterType="Long">
        update product_category set del_flag = '2' where id = #{id}
    </update>

    <update id="deleteProductCategoryByIds" parameterType="String">
        update product_category set del_flag = '2' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
