<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.product.mapper.ProductMapper">

    <resultMap type="com.ruoyi.mall.product.domain.Product" id="ProductResult">
        <result property="id" column="id"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="categoryName" column="category_name"/>
        <result property="grouponId" column="groupon_id"/>
        <result property="name" column="name"/>
        <result property="coverImage" column="cover_image"/>
        <result property="images" column="images"/>
        <result property="mainImage" column="main_image"/>
        <result property="price" column="price"/>
        <result property="originalPrice" column="original_price"/>
        <result property="stock" column="stock"/>
        <result property="sales" column="sales"/>
        <result property="status" column="status"/>
        <result property="verifyType" column="verify_type"/>
        <result property="validDays" column="valid_days"/>
        <result property="verifyNotice" column="verify_notice"/>
        <result property="description" column="description"/>
        <result property="storeIds" column="store_ids"/>
        <result property="sort" column="sort"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectProductVo">
        select p.id, p.merchant_id, p.category_id, pc.name as category_name, p.groupon_id, p.name, p.cover_image, p.images,
               p.main_image, p.price, p.original_price, p.stock, p.sales, p.status, p.verify_type,
               p.valid_days, p.verify_notice, p.description, p.store_ids, p.sort, p.create_time, p.update_time, p.remark
        from product p
        left join merchant m on m.id = p.merchant_id and m.del_flag = '0'
        left join product_category pc on pc.id = p.category_id and pc.del_flag = '0'
    </sql>

    <sql id="dataScopeBizFilter">
        <if test="params.dataScopeBizDistributorId != null">and m.distributor_id = #{params.dataScopeBizDistributorId}</if>
        <if test="params.dataScopeBizMerchantId != null">and p.merchant_id = #{params.dataScopeBizMerchantId}</if>
    </sql>

    <select id="selectProductList" parameterType="com.ruoyi.mall.product.domain.Product" resultMap="ProductResult">
        <include refid="selectProductVo"/>
        <where>
            and p.del_flag = '0'
            <if test="name != null and name != ''">and p.name like concat('%', #{name}, '%')</if>
            <if test="merchantId != null">and p.merchant_id = #{merchantId}</if>
            <if test="categoryId != null">and p.category_id = #{categoryId}</if>
            <if test="status != null">and p.status = #{status}</if>
            <include refid="dataScopeBizFilter"/>
        </where>
        order by p.sort asc, p.create_time desc
    </select>

    <select id="selectProductById" parameterType="Long" resultMap="ProductResult">
        <include refid="selectProductVo"/>
        where p.id = #{id} AND p.del_flag = '0'
    </select>

    <select id="selectProductByMerchantId" parameterType="Long" resultMap="ProductResult">
        <include refid="selectProductVo"/>
        where p.merchant_id = #{merchantId} AND p.del_flag = '0'
        order by p.sort asc, p.create_time desc
    </select>

    <insert id="insertProduct" parameterType="com.ruoyi.mall.product.domain.Product" useGeneratedKeys="true" keyProperty="id">
        insert into product
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="grouponId != null">groupon_id,</if>
            <if test="name != null">name,</if>
            <if test="coverImage != null">cover_image,</if>
            <if test="images != null">images,</if>
            <if test="mainImage != null">main_image,</if>
            <if test="price != null">price,</if>
            <if test="originalPrice != null">original_price,</if>
            <if test="stock != null">stock,</if>
            <if test="sales != null">sales,</if>
            <if test="status != null">status,</if>
            <if test="verifyType != null">verify_type,</if>
            <if test="validDays != null">valid_days,</if>
            <if test="verifyNotice != null">verify_notice,</if>
            <if test="description != null">description,</if>
            <if test="storeIds != null">store_ids,</if>
            <if test="sort != null">sort,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="grouponId != null">#{grouponId},</if>
            <if test="name != null">#{name},</if>
            <if test="coverImage != null">#{coverImage},</if>
            <if test="images != null">#{images},</if>
            <if test="mainImage != null">#{mainImage},</if>
            <if test="price != null">#{price},</if>
            <if test="originalPrice != null">#{originalPrice},</if>
            <if test="stock != null">#{stock},</if>
            <if test="sales != null">#{sales},</if>
            <if test="status != null">#{status},</if>
            <if test="verifyType != null">#{verifyType},</if>
            <if test="validDays != null">#{validDays},</if>
            <if test="verifyNotice != null">#{verifyNotice},</if>
            <if test="description != null">#{description},</if>
            <if test="storeIds != null">#{storeIds},</if>
            <if test="sort != null">#{sort},</if>
        </trim>
    </insert>

    <update id="updateProduct" parameterType="com.ruoyi.mall.product.domain.Product">
        update product
        <trim prefix="SET" suffixOverrides=",">
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="grouponId != null">groupon_id = #{grouponId},</if>
            <if test="name != null">name = #{name},</if>
            <if test="coverImage != null">cover_image = #{coverImage},</if>
            <if test="images != null">images = #{images},</if>
            <if test="mainImage != null">main_image = #{mainImage},</if>
            <if test="price != null">price = #{price},</if>
            <if test="originalPrice != null">original_price = #{originalPrice},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="sales != null">sales = #{sales},</if>
            <if test="status != null">status = #{status},</if>
            <if test="verifyType != null">verify_type = #{verifyType},</if>
            <if test="validDays != null">valid_days = #{validDays},</if>
            <if test="verifyNotice != null">verify_notice = #{verifyNotice},</if>
            <if test="description != null">description = #{description},</if>
            <if test="storeIds != null">store_ids = #{storeIds},</if>
            <if test="sort != null">sort = #{sort},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deleteProductById" parameterType="Long">
        update product set del_flag = '2' where id = #{id}
    </update>

    <update id="deleteProductByIds" parameterType="String">
        update product set del_flag = '2' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="countProductByMerchantId" parameterType="Long" resultType="int">
        select count(*) from product where merchant_id = #{merchantId} AND del_flag = '0'
    </select>

    <select id="selectProductVersion" resultType="long">
        select coalesce(unix_timestamp(max(coalesce(update_time, create_time))), 0)
        from product
        <where>
            <if test="merchantId != null">and merchant_id = #{merchantId}</if>
        </where>
    </select>

    <update id="batchUpdateProductStatus">
        UPDATE product SET status = #{status}
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND merchant_id = #{merchantId}
        AND del_flag = '0'
    </update>

    <update id="deductStock">
        UPDATE product SET stock = stock - #{quantity}
        WHERE id = #{id} AND stock >= #{quantity} AND del_flag = '0' AND status = 1
    </update>

    <update id="restoreStock">
        UPDATE product SET stock = stock + #{quantity}
        WHERE id = #{id} AND del_flag = '0'
    </update>

</mapper>
