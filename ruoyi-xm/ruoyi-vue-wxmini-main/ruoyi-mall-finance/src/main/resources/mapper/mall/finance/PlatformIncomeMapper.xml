<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.finance.mapper.PlatformIncomeMapper">

    <resultMap type="com.ruoyi.mall.finance.domain.PlatformIncome" id="PlatformIncomeResult">
        <result property="id" column="id"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="merchantName" column="merchant_name"/>
        <result property="orderNo" column="order_no"/>
        <result property="orderAmount" column="order_amount"/>
        <result property="commissionRate" column="commission_rate"/>
        <result property="commission" column="commission"/>
        <result property="createTime" column="create_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectPlatformIncomeVo">
        select p.id, p.merchant_id, m.name as merchant_name, p.order_no, p.order_amount, p.commission_rate, p.commission, p.create_time, p.del_flag
        from platform_income p
        LEFT JOIN merchant m ON p.merchant_id = m.id
    </sql>

    <select id="selectPlatformIncomeList" parameterType="com.ruoyi.mall.finance.domain.PlatformIncome" resultMap="PlatformIncomeResult">
        <include refid="selectPlatformIncomeVo"/>
        <where>
            and p.del_flag = '0'
            <if test="merchantId != null">and p.merchant_id = #{merchantId}</if>
            <if test="merchantName != null and merchantName != ''">and m.name like concat('%', #{merchantName}, '%')</if>
            <if test="orderNo != null and orderNo != ''">and p.order_no = #{orderNo}</if>
            <if test="params.beginTime != null">and p.create_time &gt;= #{params.beginTime}</if>
            <if test="params.endTime != null">and p.create_time &lt;= #{params.endTime}</if>
            <if test="params.dataScopeBiz != null and params.dataScopeBiz != ''">${params.dataScopeBiz}</if>
        </where>
        order by p.create_time desc
    </select>

    <select id="selectPlatformIncomeById" parameterType="Long" resultMap="PlatformIncomeResult">
        <include refid="selectPlatformIncomeVo"/>
        where p.id = #{id} and p.del_flag = '0'
    </select>

    <select id="selectPlatformIncomeByMerchantId" parameterType="Long" resultMap="PlatformIncomeResult">
        <include refid="selectPlatformIncomeVo"/>
        where p.merchant_id = #{merchantId} and p.del_flag = '0'
        order by p.create_time desc
    </select>

    <insert id="insertPlatformIncome" parameterType="com.ruoyi.mall.finance.domain.PlatformIncome" useGeneratedKeys="true" keyProperty="id">
        insert into platform_income
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="orderNo != null">order_no,</if>
            <if test="orderAmount != null">order_amount,</if>
            <if test="commissionRate != null">commission_rate,</if>
            <if test="commission != null">commission,</if>
            del_flag,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="orderNo != null">#{orderNo},</if>
            <if test="orderAmount != null">#{orderAmount},</if>
            <if test="commissionRate != null">#{commissionRate},</if>
            <if test="commission != null">#{commission},</if>
            '0',
        </trim>
    </insert>

    <update id="updatePlatformIncome" parameterType="com.ruoyi.mall.finance.domain.PlatformIncome">
        update platform_income
        <trim prefix="SET" suffixOverrides=",">
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="orderAmount != null">order_amount = #{orderAmount},</if>
            <if test="commissionRate != null">commission_rate = #{commissionRate},</if>
            <if test="commission != null">commission = #{commission},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deletePlatformIncomeById" parameterType="Long">
        update platform_income set del_flag = '2' where id = #{id}
    </update>

    <update id="deletePlatformIncomeByIds" parameterType="String">
        update platform_income set del_flag = '2' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
