<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.finance.mapper.TransactionRecordMapper">

    <resultMap type="com.ruoyi.mall.finance.domain.TransactionRecord" id="TransactionRecordResult">
        <result property="id" column="id"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="merchantName" column="merchant_name"/>
        <result property="type" column="type"/>
        <result property="amount" column="amount"/>
        <result property="balance" column="balance"/>
        <result property="orderNo" column="order_no"/>
        <result property="description" column="description"/>
        <result property="createTime" column="create_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectTransactionRecordVo">
        select t.id, t.merchant_id, m.name as merchant_name, t.type, t.amount, t.balance, t.order_no, t.description, t.create_time, t.del_flag
        from transaction_record t
        LEFT JOIN merchant m ON t.merchant_id = m.id
    </sql>

    <select id="selectTransactionRecordList" parameterType="com.ruoyi.mall.finance.domain.TransactionRecord" resultMap="TransactionRecordResult">
        <include refid="selectTransactionRecordVo"/>
        <where>
            and t.del_flag = '0'
            <if test="merchantId != null">and t.merchant_id = #{merchantId}</if>
            <if test="merchantName != null and merchantName != ''">and m.name like concat('%', #{merchantName}, '%')</if>
            <if test="type != null and type != ''">and t.type = #{type}</if>
            <if test="orderNo != null and orderNo != ''">and t.order_no = #{orderNo}</if>
            <if test="params.beginTime != null">and t.create_time &gt;= #{params.beginTime}</if>
            <if test="params.endTime != null">and t.create_time &lt;= #{params.endTime}</if>
            <if test="params.dataScopeBiz != null and params.dataScopeBiz != ''">${params.dataScopeBiz}</if>
        </where>
        order by t.create_time desc
    </select>

    <select id="selectTransactionRecordById" parameterType="Long" resultMap="TransactionRecordResult">
        <include refid="selectTransactionRecordVo"/>
        where t.id = #{id} and t.del_flag = '0'
    </select>

    <select id="selectTransactionRecordByMerchantId" parameterType="Long" resultMap="TransactionRecordResult">
        <include refid="selectTransactionRecordVo"/>
        where t.merchant_id = #{merchantId} and t.del_flag = '0'
        order by t.create_time desc
    </select>

    <insert id="insertTransactionRecord" parameterType="com.ruoyi.mall.finance.domain.TransactionRecord" useGeneratedKeys="true" keyProperty="id">
        insert into transaction_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="type != null">type,</if>
            <if test="amount != null">amount,</if>
            <if test="balance != null">balance,</if>
            <if test="orderNo != null">order_no,</if>
            <if test="description != null">description,</if>
            del_flag,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="type != null">#{type},</if>
            <if test="amount != null">#{amount},</if>
            <if test="balance != null">#{balance},</if>
            <if test="orderNo != null">#{orderNo},</if>
            <if test="description != null">#{description},</if>
            '0',
        </trim>
    </insert>

    <update id="updateTransactionRecord" parameterType="com.ruoyi.mall.finance.domain.TransactionRecord">
        update transaction_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="type != null">type = #{type},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="balance != null">balance = #{balance},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="description != null">description = #{description},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deleteTransactionRecordById" parameterType="Long">
        update transaction_record set del_flag = '2' where id = #{id}
    </update>

    <update id="deleteTransactionRecordByIds" parameterType="String">
        update transaction_record set del_flag = '2' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
