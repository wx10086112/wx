<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.order.mapper.RefundRecordMapper">

    <resultMap type="com.ruoyi.mall.order.domain.RefundRecord" id="RefundRecordResult">
        <result property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="refundNo" column="refund_no"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="merchantName" column="merchant_name"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="paymentRecordId" column="payment_record_id"/>
        <result property="refundAmount" column="refund_amount"/>
        <result property="refundReason" column="refund_reason"/>
        <result property="refundType" column="refund_type"/>
        <result property="status" column="status"/>
        <result property="auditTime" column="audit_time"/>
        <result property="refundTime" column="refund_time"/>
        <result property="rejectReason" column="reject_reason"/>
        <result property="operator" column="operator"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectRefundRecordVo">
        select r.id, r.order_no, r.refund_no, r.merchant_id, m.name as merchant_name,
               r.user_id, u.nickname as user_name, r.payment_record_id,
               r.refund_amount, r.refund_reason, r.refund_type, r.status, r.audit_time,
               r.refund_time, r.reject_reason, r.operator, r.create_time, r.update_time
        from refund_record r
        LEFT JOIN merchant m ON r.merchant_id = m.id
        LEFT JOIN mall_user u ON r.user_id = u.id
    </sql>

    <sql id="dataScopeBizFilter">
        <if test="params.dataScopeBizDistributorId != null">and m.distributor_id = #{params.dataScopeBizDistributorId}</if>
        <if test="params.dataScopeBizMerchantId != null">and r.merchant_id = #{params.dataScopeBizMerchantId}</if>
    </sql>

    <select id="selectRefundRecordById" parameterType="Long" resultMap="RefundRecordResult">
        <include refid="selectRefundRecordVo"/>
        where r.id = #{id} AND r.del_flag = '0'
    </select>

    <select id="selectRefundRecordByRefundNo" parameterType="String" resultMap="RefundRecordResult">
        <include refid="selectRefundRecordVo"/>
        where r.refund_no = #{refundNo} AND r.del_flag = '0'
    </select>

    <select id="selectRefundRecordList" parameterType="com.ruoyi.mall.order.domain.RefundRecord" resultMap="RefundRecordResult">
        <include refid="selectRefundRecordVo"/>
        <where>
            and r.del_flag = '0'
            <if test="orderNo != null and orderNo != ''">and r.order_no like concat('%', #{orderNo}, '%')</if>
            <if test="refundNo != null and refundNo != ''">and r.refund_no = #{refundNo}</if>
            <if test="merchantId != null">and r.merchant_id = #{merchantId}</if>
            <if test="merchantName != null and merchantName != ''">and m.name like concat('%', #{merchantName}, '%')</if>
            <if test="userId != null">and r.user_id = #{userId}</if>
            <if test="userName != null and userName != ''">and u.nickname like concat('%', #{userName}, '%')</if>
            <if test="status != null">and r.status = #{status}</if>
            <if test="refundType != null">and r.refund_type = #{refundType}</if>
            <include refid="dataScopeBizFilter"/>
        </where>
        order by r.create_time desc
    </select>

    <select id="countActiveRefundByOrderNo" resultType="int">
        select count(*)
        from refund_record
        where order_no = #{orderNo}
          and status in (1, 2)
          and del_flag = '0'
    </select>

    <select id="countActiveRefundByMerchantId" resultType="Long">
        select count(*)
        from refund_record
        where merchant_id = #{merchantId}
          and status in (1, 2)
          and del_flag = '0'
    </select>

    <insert id="insertRefundRecord" parameterType="com.ruoyi.mall.order.domain.RefundRecord" useGeneratedKeys="true" keyProperty="id">
        insert into refund_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNo != null">order_no,</if>
            <if test="refundNo != null">refund_no,</if>
            <if test="merchantId != null">merchant_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="paymentRecordId != null">payment_record_id,</if>
            <if test="refundAmount != null">refund_amount,</if>
            <if test="refundReason != null">refund_reason,</if>
            <if test="refundType != null">refund_type,</if>
            <if test="status != null">status,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="refundTime != null">refund_time,</if>
            <if test="rejectReason != null">reject_reason,</if>
            <if test="operator != null">operator,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNo != null">#{orderNo},</if>
            <if test="refundNo != null">#{refundNo},</if>
            <if test="merchantId != null">#{merchantId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="paymentRecordId != null">#{paymentRecordId},</if>
            <if test="refundAmount != null">#{refundAmount},</if>
            <if test="refundReason != null">#{refundReason},</if>
            <if test="refundType != null">#{refundType},</if>
            <if test="status != null">#{status},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="refundTime != null">#{refundTime},</if>
            <if test="rejectReason != null">#{rejectReason},</if>
            <if test="operator != null">#{operator},</if>
        </trim>
    </insert>

    <update id="updateRefundRecord" parameterType="com.ruoyi.mall.order.domain.RefundRecord">
        update refund_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="refundNo != null">refund_no = #{refundNo},</if>
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="paymentRecordId != null">payment_record_id = #{paymentRecordId},</if>
            <if test="refundAmount != null">refund_amount = #{refundAmount},</if>
            <if test="refundReason != null">refund_reason = #{refundReason},</if>
            <if test="refundType != null">refund_type = #{refundType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="refundTime != null">refund_time = #{refundTime},</if>
            <if test="rejectReason != null">reject_reason = #{rejectReason},</if>
            <if test="operator != null">operator = #{operator},</if>
        </trim>
        where id = #{id}
        <if test="params != null and params.oldStatus != null">
            and status = #{params.oldStatus}
        </if>
    </update>

    <update id="markRefundSucceeded">
        update refund_record
        set status = 4,
            refund_time = #{refundTime}
        where id = #{id}
          and status &lt; 4
          and del_flag = '0'
    </update>

    <update id="markRefundAbnormal">
        update refund_record
        set status = 5
        where id = #{id}
          and status &lt;&gt; 5
          and del_flag = '0'
    </update>

    <update id="deleteRefundRecordById" parameterType="Long">
        update refund_record set del_flag = '2' where id = #{id}
    </update>

    <update id="deleteRefundRecordByIds" parameterType="String">
        update refund_record set del_flag = '2' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
