<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.order.mapper.BookingServiceMapper">

    <resultMap type="com.ruoyi.mall.order.domain.BookingService" id="BookingServiceResult">
        <result property="id" column="id"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="productId" column="product_id"/>
        <result property="serviceName" column="service_name"/>
        <result property="serviceImage" column="service_image"/>
        <result property="servicePrice" column="service_price"/>
        <result property="description" column="description"/>
        <result property="stock" column="stock"/>
        <result property="status" column="status"/>
        <result property="sort" column="sort"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectBookingServiceVo">
        select id, merchant_id, product_id, service_name, service_image, service_price,
               description, stock, status, sort, create_time, update_time, remark, del_flag
        from mall_booking_service
    </sql>

    <select id="selectBookingServiceById" parameterType="Long" resultMap="BookingServiceResult">
        <include refid="selectBookingServiceVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectBookingServiceByProductId" parameterType="Long" resultMap="BookingServiceResult">
        <include refid="selectBookingServiceVo"/>
        where product_id = #{productId} and del_flag = '0'
        order by status desc, sort asc, id asc
        limit 1
    </select>

    <select id="selectActiveBookingServiceList" resultMap="BookingServiceResult">
        <include refid="selectBookingServiceVo"/>
        <where>
            and del_flag = '0'
            and status = 1
            <if test="merchantId != null">and merchant_id = #{merchantId}</if>
            <if test="keyword != null and keyword != ''">and service_name like concat('%', #{keyword}, '%')</if>
        </where>
        order by sort asc, id asc
    </select>

    <select id="selectBookingServiceVersion" resultType="long">
        select coalesce(unix_timestamp(max(coalesce(update_time, create_time))), 0)
        from mall_booking_service
        <where>
            and del_flag = '0'
            <if test="merchantId != null">and merchant_id = #{merchantId}</if>
        </where>
    </select>
</mapper>
