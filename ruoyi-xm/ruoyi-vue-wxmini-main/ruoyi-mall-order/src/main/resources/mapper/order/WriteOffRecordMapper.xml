<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.order.mapper.WriteOffRecordMapper">

    <resultMap type="com.ruoyi.mall.order.domain.WriteOffRecord" id="WriteOffRecordResult">
        <result property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="writeOffCode" column="write_off_code"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="storeId" column="store_id"/>
        <result property="operatorId" column="operator_id"/>
        <result property="operatorName" column="operator_name"/>
        <result property="writeOffType" column="write_off_type"/>
        <result property="writeOffTime" column="write_off_time"/>
        <result property="productName" column="product_name"/>
        <result property="productAmount" column="product_amount"/>
        <result property="remark" column="remark"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectWriteOffRecordVo">
        select id, order_id, order_no, write_off_code, merchant_id, store_id,
               operator_id, operator_name, write_off_type, write_off_time,
               product_name, product_amount, remark, status, create_time
        from write_off_record
    </sql>

    <select id="selectWriteOffRecordById" parameterType="Long" resultMap="WriteOffRecordResult">
        <include refid="selectWriteOffRecordVo"/>
        where id = #{id}
    </select>

    <select id="selectWriteOffRecordList" parameterType="com.ruoyi.mall.order.domain.WriteOffRecord" resultMap="WriteOffRecordResult">
        <include refid="selectWriteOffRecordVo"/>
        <where>
            <if test="merchantId != null">and merchant_id = #{merchantId}</if>
            <if test="orderNo != null and orderNo != ''">and order_no = #{orderNo}</if>
            <if test="writeOffCode != null and writeOffCode != ''">and write_off_code = #{writeOffCode}</if>
            <if test="status != null">and status = #{status}</if>
        </where>
        order by write_off_time desc
    </select>

    <select id="selectByMerchantId" parameterType="Long" resultMap="WriteOffRecordResult">
        <include refid="selectWriteOffRecordVo"/>
        where merchant_id = #{merchantId} and status = 1
        order by write_off_time desc
    </select>

    <select id="selectByWriteOffCode" parameterType="String" resultMap="WriteOffRecordResult">
        <include refid="selectWriteOffRecordVo"/>
        where write_off_code = #{code} and status = 1
    </select>

    <insert id="insertWriteOffRecord" parameterType="com.ruoyi.mall.order.domain.WriteOffRecord" useGeneratedKeys="true" keyProperty="id">
        insert into write_off_record (
            order_id, order_no, write_off_code, merchant_id, store_id,
            operator_id, operator_name, write_off_type, write_off_time,
            product_name, product_amount, remark, status, create_time
        ) values (
            #{orderId}, #{orderNo}, #{writeOffCode}, #{merchantId}, #{storeId},
            #{operatorId}, #{operatorName}, #{writeOffType}, #{writeOffTime},
            #{productName}, #{productAmount}, #{remark}, #{status}, sysdate()
        )
    </insert>

</mapper>
