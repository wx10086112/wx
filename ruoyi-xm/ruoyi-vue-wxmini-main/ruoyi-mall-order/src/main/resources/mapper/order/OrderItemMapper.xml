<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.order.mapper.OrderItemMapper">

    <resultMap type="com.ruoyi.mall.order.domain.OrderItem" id="OrderItemResult">
        <result property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="merchantName" column="merchant_name"/>
        <result property="productId" column="product_id"/>
        <result property="productName" column="product_name"/>
        <result property="productImage" column="product_image"/>
        <result property="price" column="price"/>
        <result property="quantity" column="quantity"/>
        <result property="subtotal" column="subtotal"/>
        <result property="createTime" column="create_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectOrderItemVo">
        select oi.id, oi.order_id, oi.order_no, oi.merchant_id, m.name as merchant_name,
               oi.product_id, oi.product_name, oi.product_image,
               oi.price, oi.quantity, oi.subtotal, oi.create_time
        from order_item oi
        LEFT JOIN merchant m ON oi.merchant_id = m.id
    </sql>

    <select id="selectOrderItemById" parameterType="Long" resultMap="OrderItemResult">
        <include refid="selectOrderItemVo"/>
        where oi.id = #{id} AND oi.del_flag = '0'
    </select>

    <select id="selectOrderItemList" parameterType="com.ruoyi.mall.order.domain.OrderItem" resultMap="OrderItemResult">
        <include refid="selectOrderItemVo"/>
        <where>
            and oi.del_flag = '0'
            <if test="orderId != null">and oi.order_id = #{orderId}</if>
            <if test="orderNo != null and orderNo != ''">and oi.order_no = #{orderNo}</if>
            <if test="merchantId != null">and oi.merchant_id = #{merchantId}</if>
            <if test="merchantName != null and merchantName != ''">and m.name like concat('%', #{merchantName}, '%')</if>
            <if test="productId != null">and oi.product_id = #{productId}</if>
        </where>
    </select>

    <select id="selectOrderItemByOrderId" parameterType="Long" resultMap="OrderItemResult">
        <include refid="selectOrderItemVo"/>
        where oi.order_id = #{orderId} AND oi.del_flag = '0'
    </select>

    <select id="selectOrderItemByOrderNo" parameterType="String" resultMap="OrderItemResult">
        <include refid="selectOrderItemVo"/>
        where oi.order_no = #{orderNo} AND oi.del_flag = '0'
    </select>

    <insert id="insertOrderItem" parameterType="com.ruoyi.mall.order.domain.OrderItem" useGeneratedKeys="true" keyProperty="id">
        insert into order_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderId != null">order_id,</if>
            <if test="orderNo != null">order_no,</if>
            <if test="merchantId != null">merchant_id,</if>
            <if test="productId != null">product_id,</if>
            <if test="productName != null">product_name,</if>
            <if test="productImage != null">product_image,</if>
            <if test="price != null">price,</if>
            <if test="quantity != null">quantity,</if>
            <if test="subtotal != null">subtotal,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderId != null">#{orderId},</if>
            <if test="orderNo != null">#{orderNo},</if>
            <if test="merchantId != null">#{merchantId},</if>
            <if test="productId != null">#{productId},</if>
            <if test="productName != null">#{productName},</if>
            <if test="productImage != null">#{productImage},</if>
            <if test="price != null">#{price},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="subtotal != null">#{subtotal},</if>
        </trim>
    </insert>

    <update id="updateOrderItem" parameterType="com.ruoyi.mall.order.domain.OrderItem">
        update order_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="productName != null">product_name = #{productName},</if>
            <if test="productImage != null">product_image = #{productImage},</if>
            <if test="price != null">price = #{price},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="subtotal != null">subtotal = #{subtotal},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deleteOrderItemById" parameterType="Long">
        update order_item set del_flag = '2' where id = #{id}
    </update>

    <update id="deleteOrderItemByIds" parameterType="String">
        update order_item set del_flag = '2' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
