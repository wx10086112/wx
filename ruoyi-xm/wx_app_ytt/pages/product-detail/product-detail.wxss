.product-page {
  min-height: 100vh;
  background: #f3f7fd;
  padding-bottom: 150rpx;
}

.image-swiper {
  width: 100%;
  height: 560rpx;
}

.product-image-frame {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #dbe5f4;
}

.product-image {
  position: absolute;
  left: -15%;
  top: -15%;
  width: 130%;
  height: 130%;
}

.price-section,
.merchant-section,
.detail-card {
  margin: 24rpx;
  padding: 28rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(20, 69, 138, 0.07);
}

.price-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx 14rpx;
  min-height: 66rpx;
}

.price {
  color: #237bc7;
  font-size: 48rpx;
  font-weight: 760;
  line-height: 1.1;
  white-space: nowrap;
}

.original-price {
  color: #8a98aa;
  font-size: 28rpx;
  line-height: 1.2;
  text-decoration: line-through;
  white-space: nowrap;
}

.discount-tag {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(22, 119, 255, 0.12);
  color: #237bc7;
  font-size: 22rpx;
  line-height: 1;
  white-space: nowrap;
}

.product-title {
  display: block;
  margin-top: 18rpx;
  font-size: 34rpx;
  color: #20304a;
  font-weight: 600;
  line-height: 1.45;
}

.subtitle,
.merchant-meta,
.detail-item {
  display: block;
  margin-top: 12rpx;
  color: #71829b;
  font-size: 26rpx;
  line-height: 1.6;
}

.sold-out-tip {
  display: block;
  margin-top: 14rpx;
  color: #b42318;
  font-size: 24rpx;
  line-height: 1.5;
}

.highlight-tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.highlight-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(22, 119, 255, 0.12);
  color: #237bc7;
  font-size: 22rpx;
}

.stats-row {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  color: #607089;
  font-size: 24rpx;
}

.merchant-section {
  display: flex;
  align-items: center;
}

.merchant-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.merchant-info {
  margin-left: 18rpx;
  flex: 1;
}

.merchant-name,
.section-title {
  font-size: 30rpx;
  color: #20304a;
  font-weight: 600;
}

.merchant-address {
  display: block;
  margin-top: 10rpx;
  color: #7c8ba1;
  font-size: 24rpx;
  line-height: 1.5;
}

.merchant-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.merchant-action {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  background: rgba(255, 255, 255, 0.58);
  color: #475467;
  font-size: 22rpx;
}

.arrow {
  color: #a1aec0;
  font-size: 38rpx;
}

.detail-section {
  padding: 0 24rpx;
}

.floating-cart-btn {
  position: fixed;
  right: 28rpx;
  bottom: 150rpx;
  z-index: 1000;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1677ff 0%, #59a8ff 100%);
  box-shadow: 0 16rpx 34rpx rgba(22, 119, 255, 0.26);
}

.floating-cart-btn:active {
  opacity: 0.9;
  transform: translateY(1rpx) scale(0.97);
}

.floating-cart-text {
  width: 68rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 1.15;
  text-align: center;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  width: 100%;
  min-height: 118rpx;
  padding-top: 16rpx;
  padding-right: 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  padding-left: 24rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 -8rpx 30rpx rgba(14, 52, 110, 0.08);
}

.share-btn,
.add-cart-btn,
.buy-btn {
  min-width: 0;
  height: 70rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
}

.share-btn::after,
.add-cart-btn::after,
.buy-btn::after {
  border: none;
}

.share-btn {
  flex: 0 0 176rpx;
  width: 176rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.22);
  background: #ffffff;
  color: #4d6586;
  font-size: 24rpx;
  font-weight: 620;
}

.add-cart-btn {
  flex: 0 0 186rpx;
  width: 186rpx;
  border: 1rpx solid rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  color: #2d8fe8;
  font-size: 25rpx;
  font-weight: 700;
}

.buy-btn {
  flex: 1;
  width: auto;
  border: 1rpx solid rgba(22, 119, 255, 0.12);
  background: linear-gradient(135deg, #1677ff 0%, #59a8ff 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 760;
  box-shadow: 0 10rpx 24rpx rgba(22, 119, 255, 0.22);
}

.buy-btn:active,
.share-btn:active,
.add-cart-btn:active {
  opacity: 0.9;
  transform: translateY(1rpx) scale(0.985);
}

.buy-btn.is-disabled,
.add-cart-btn.is-disabled {
  color: #98a2b3;
  border-color: rgba(148, 163, 184, 0.2);
  background: #f2f4f7;
  box-shadow: none;
}

.booking-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.45);
}

.booking-panel {
  width: 100%;
  padding: 32rpx 32rpx 48rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.booking-title {
  display: block;
  margin-bottom: 24rpx;
  color: #1f2d3d;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.booking-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f3f6;
}

.booking-label {
  color: #667085;
  font-size: 28rpx;
}

.booking-value {
  color: #1f2d3d;
  font-size: 28rpx;
  font-weight: 600;
}

.booking-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
}

.booking-cancel,
.booking-submit {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.booking-cancel {
  background: #f2f4f7;
  color: #4d6586;
}

.booking-submit {
  background: linear-gradient(135deg, #1f5c3a 0%, #2f7d5b 100%);
  color: #ffffff;
}

.booking-cancel::after,
.booking-submit::after {
  border: none;
}
