.booking-page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background:
    radial-gradient(circle at 16% 8%, rgba(45, 143, 232, 0.12), transparent 30%),
    linear-gradient(160deg, rgba(255, 255, 255, 0.96) 0%, rgba(231, 244, 255, 0.92) 44%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.loading-state {
  flex: 1;
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #667085;
}

.loading-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(45, 143, 232, 0.16);
  border-top-color: #2d8fe8;
}

.loading-text {
  font-size: 26rpx;
}

.booking-header {
  flex-shrink: 0;
  min-height: 104rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 16rpx;
  box-sizing: border-box;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12rpx);
}

.home-shortcut,
.header-placeholder {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.home-shortcut {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(231, 244, 255, 0.82);
  border: 1rpx solid rgba(45, 143, 232, 0.12);
}

.home-icon {
  position: relative;
  width: 34rpx;
  height: 28rpx;
  border: 4rpx solid #111827;
  border-top: 0;
  border-radius: 3rpx;
}

.home-icon::before {
  content: "";
  position: absolute;
  left: 1rpx;
  top: -17rpx;
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid #111827;
  border-top: 4rpx solid #111827;
  transform: rotate(45deg);
  background: transparent;
}

.header-title {
  height: 64rpx;
  color: #111827;
  font-size: 36rpx;
  font-weight: 840;
  line-height: 64rpx;
  text-align: center;
}

.booking-content {
  flex: 1;
  min-height: 0;
  padding: 18rpx 22rpx calc(128rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.store-panel {
  flex-shrink: 0;
  padding: 26rpx 28rpx;
  min-height: 116rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  border-radius: 32rpx;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.78)),
    rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow: 0 14rpx 38rpx rgba(34, 73, 116, 0.08);
}

.store-main {
  flex: 1;
  min-width: 0;
}

.store-name {
  display: block;
  color: #111827;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-address {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-arrow {
  width: 18rpx;
  height: 18rpx;
  margin-left: 18rpx;
  flex-shrink: 0;
  border-top: 3rpx solid #98a2b3;
  border-right: 3rpx solid #98a2b3;
  transform: rotate(45deg);
}

.order-shell {
  flex: 1;
  min-height: 0;
  display: flex;
  overflow: hidden;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  box-shadow: 0 16rpx 46rpx rgba(34, 73, 116, 0.08);
}

.category-sidebar {
  width: 164rpx;
  height: 100%;
  flex-shrink: 0;
  background: rgba(231, 244, 255, 0.68);
  border-right: 1rpx solid rgba(45, 143, 232, 0.08);
}

.category-item {
  position: relative;
  min-height: 96rpx;
  padding: 0 18rpx 0 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.25;
}

.category-item.active {
  color: #237bc7;
  background: rgba(255, 255, 255, 0.96);
  font-weight: 800;
}

.category-item.active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  width: 7rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #2d8fe8;
}

.product-area {
  flex: 1;
  height: 100%;
  min-width: 0;
}

.product-list {
  padding: 18rpx;
  box-sizing: border-box;
}

.product-card {
  padding: 14rpx;
  margin-bottom: 16rpx;
  display: flex;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(34, 73, 116, 0.055);
}

.product-card:active {
  opacity: 0.92;
}

.product-image {
  width: 134rpx;
  height: 134rpx;
  flex-shrink: 0;
  border-radius: 22rpx;
  background: #dbeefa;
}

.product-info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.product-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.32;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-desc {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-sales {
  margin-top: 8rpx;
  color: #98a2b3;
  font-size: 22rpx;
}

.product-bottom {
  margin-top: auto;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.product-price {
  color: #237bc7;
  font-size: 30rpx;
  font-weight: 840;
  line-height: 1.2;
}

.add-btn {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  border-radius: 50%;
  color: #ffffff;
  background: linear-gradient(135deg, #2d8fe8, #237bc7);
  box-shadow: 0 10rpx 24rpx rgba(45, 143, 232, 0.22);
  font-size: 38rpx;
  font-weight: 640;
  line-height: 48rpx;
  text-align: center;
}

.add-btn.disabled {
  width: 76rpx;
  border-radius: 999rpx;
  background: #cbd5e1;
  box-shadow: none;
  font-size: 22rpx;
  line-height: 52rpx;
}

.empty-card {
  margin: 28rpx;
  min-height: 280rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.88);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 760;
}

.empty-desc {
  margin-top: 12rpx;
  color: #667085;
  font-size: 24rpx;
}

.booking-action-card {
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  box-shadow: 0 16rpx 46rpx rgba(34, 73, 116, 0.1);
}

.booking-info-row {
  height: 76rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(213, 226, 238, 0.72);
}

.table-info,
.people-info {
  display: flex;
  align-items: center;
  color: #475467;
  font-size: 27rpx;
}

.people-info {
  padding: 16rpx 0 16rpx 24rpx;
}

.muted {
  color: #667085;
}

.strong {
  color: #344054;
  font-weight: 780;
}

.tiny-arrow {
  width: 14rpx;
  height: 14rpx;
  margin-left: 10rpx;
  flex-shrink: 0;
  border-top: 3rpx solid #98a2b3;
  border-right: 3rpx solid #98a2b3;
  transform: rotate(45deg);
}

.cart-row {
  min-height: 104rpx;
  padding: 16rpx 18rpx 16rpx 26rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.cart-state {
  flex: 1;
  min-width: 0;
  color: #d4485b;
  font-size: 30rpx;
  font-weight: 760;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-btn {
  width: 204rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 72rpx;
  text-align: center;
}

.checkout-btn.active {
  background: linear-gradient(135deg, #2d8fe8, #237bc7);
  box-shadow: 0 12rpx 28rpx rgba(45, 143, 232, 0.22);
}

.checkout-btn.empty {
  background: linear-gradient(135deg, #79baf5, #2d8fe8);
  opacity: 0.9;
}

.dialog-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: calc(116rpx + env(safe-area-inset-bottom));
  z-index: 30;
  padding: 0 38rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.38);
}

.people-dialog {
  width: 100%;
  max-width: 690rpx;
  box-sizing: border-box;
  padding: 44rpx 30rpx 32rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 28rpx 70rpx rgba(15, 23, 42, 0.18);
}

.dialog-title {
  display: block;
  color: #111827;
  font-size: 34rpx;
  font-weight: 840;
  text-align: center;
}

.people-grid {
  margin-top: 42rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.people-option {
  height: 86rpx;
  border-radius: 12rpx;
  border: 1rpx solid #edf2f7;
  color: #111827;
  background: #ffffff;
  font-size: 32rpx;
  font-weight: 640;
  line-height: 86rpx;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.03);
}

.people-option.active {
  color: #237bc7;
  border-color: rgba(45, 143, 232, 0.25);
  background: rgba(231, 244, 255, 0.86);
}

.table-picker-row {
  margin-top: 34rpx;
  padding: 30rpx 4rpx 26rpx;
  border-top: 1rpx solid #edf2f7;
  border-bottom: 1rpx solid #edf2f7;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #667085;
  font-size: 28rpx;
}

.table-picker-value {
  display: flex;
  align-items: center;
}

.table-value {
  color: #237bc7;
  font-weight: 760;
}

.confirm-btn {
  height: 84rpx;
  margin-top: 32rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #2d8fe8, #237bc7);
  box-shadow: 0 12rpx 28rpx rgba(45, 143, 232, 0.22);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 84rpx;
  text-align: center;
}
