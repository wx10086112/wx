.settings-page {
  min-height: 100vh;
  padding: 32rpx 30rpx 120rpx;
  box-sizing: border-box;
  background: #f6f6f6;
}

.settings-card {
  margin-bottom: 28rpx;
  border-radius: 30rpx;
  background: #fff;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(28, 38, 60, 0.03);
}

.settings-card--main {
  padding: 18rpx 0;
}

.settings-card--single,
.logout-card {
  border-radius: 24rpx;
}

.settings-row,
.single-row,
.agreement-row {
  min-height: 126rpx;
  padding: 0 36rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.settings-row {
  border-bottom: none;
}

.settings-card--single .single-row,
.logout-card .single-row {
  min-height: 116rpx;
}

.row-title,
.logout-text {
  flex: 1;
  min-width: 0;
  color: #2c3138;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.row-arrow {
  flex-shrink: 0;
  color: #c7ccd4;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 300;
}

.version-text {
  flex-shrink: 0;
  color: #9aa1ac;
  font-size: 29rpx;
  line-height: 1;
}

.settings-modal {
  position: fixed;
  inset: 0;
  z-index: 1300;
}

.settings-mask {
  position: absolute;
  inset: 0;
  background: rgba(10, 18, 32, 0.46);
}

.settings-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 84vh;
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
  overflow: hidden;
}

.sheet-header {
  min-height: 102rpx;
  padding: 0 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  border-bottom: 1rpx solid #eef1f5;
  box-sizing: border-box;
}

.sheet-title {
  display: block;
  color: #1f2a37;
  font-size: 34rpx;
  font-weight: 800;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  color: #9aa3ae;
  font-size: 48rpx;
  line-height: 52rpx;
  text-align: center;
}

.agreement-wrap {
  padding: 28rpx 30rpx 34rpx;
}

.agreement-row {
  margin-top: 22rpx;
  min-height: 92rpx;
  padding: 0 26rpx;
  border-radius: 18rpx;
  background: #f6f8fb;
}

.agreement-row-title {
  color: #2f3a4a;
  font-size: 28rpx;
  font-weight: 700;
}

.sheet-scroll {
  max-height: 640rpx;
}

.info-groups,
.qualification-list {
  padding: 30rpx 32rpx 38rpx;
}

.info-group {
  margin-bottom: 34rpx;
}

.info-group:last-child {
  margin-bottom: 0;
}

.info-group-title,
.merchant-name {
  display: block;
  color: #20304a;
  font-size: 30rpx;
  font-weight: 800;
}

.info-line {
  margin-top: 18rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.info-dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: 17rpx;
  border-radius: 50%;
  background: #2f7cff;
  flex-shrink: 0;
}

.info-text {
  flex: 1;
  color: #5d6b7c;
  font-size: 25rpx;
  line-height: 1.75;
}

.license-item {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f6f8fb;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.license-main {
  flex: 1;
  min-width: 0;
}

.license-title {
  display: block;
  color: #2c3544;
  font-size: 29rpx;
  font-weight: 750;
}

.license-number {
  display: block;
  margin-top: 8rpx;
  color: #8d98a8;
  font-size: 23rpx;
}

.license-status {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #8a96a8;
  background: #edf1f5;
  font-size: 22rpx;
  font-weight: 650;
}

.license-status.ready {
  color: #0b9b61;
  background: rgba(11, 155, 97, 0.1);
}
