.coupon-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(45, 143, 232, 0.12), transparent 30%),
    #f3f7fd;
  padding: 24rpx;
  box-sizing: border-box;
}

.coupon-header {
  padding: 28rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(45, 143, 232, 0.2);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.92), rgba(231, 244, 255, 0.9)),
    #e7f4ff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76), 0 14rpx 34rpx rgba(34, 73, 116, 0.08);
}

.coupon-title {
  display: block;
  color: #111827;
  font-size: 36rpx;
  font-weight: 600;
}

.coupon-tabs {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.coupon-tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 18rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  background: rgba(255, 255, 255, 0.58);
  color: #607089;
  font-size: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(20, 69, 138, 0.04);
}

.coupon-tab.active {
  border-color: rgba(45, 143, 232, 0.24);
  background: #ffffff;
  color: #237bc7;
  font-weight: 600;
}

.coupon-list {
  margin-top: 22rpx;
}

.coupon-card {
  display: flex;
  align-items: stretch;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: #fff;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(20, 69, 138, 0.06);
}

.coupon-disabled {
  opacity: 0.55;
}

.coupon-left {
  width: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 20rpx;
  background: linear-gradient(135deg, rgba(45, 143, 232, 0.08) 0%, rgba(231, 244, 255, 0.92) 100%);
}

.coupon-amount {
  font-size: 52rpx;
  font-weight: 700;
  color: #237bc7;
}

.coupon-threshold {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #667085;
}

.coupon-divider {
  width: 1rpx;
  background: repeating-linear-gradient(
    to bottom,
    #e8e0d8 0,
    #e8e0d8 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
}

.coupon-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 28rpx 24rpx;
}

.coupon-name {
  font-size: 28rpx;
  color: #20304a;
  font-weight: 600;
}

.coupon-valid {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a96a8;
}

.coupon-use-btn {
  margin-top: 16rpx;
  align-self: flex-start;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  color: #237bc7;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.coupon-status-tag {
  margin-top: 16rpx;
  align-self: flex-start;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #eef1f5;
  color: #8a96a8;
  font-size: 22rpx;
}
