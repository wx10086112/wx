.cart-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
  background: #f3f7fd;
}

.card,
.empty-card {
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(20, 69, 138, 0.07);
}

.cart-header {
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  display: block;
  color: #20304a;
  font-size: 34rpx;
  font-weight: 760;
  line-height: 1.3;
}

.section-desc {
  display: block;
  margin-top: 8rpx;
  color: #72839a;
  font-size: 24rpx;
  line-height: 1.45;
}

.item-card {
  position: relative;
  margin-top: 22rpx;
  padding: 24rpx;
  display: flex;
  gap: 20rpx;
}

.item-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: #dbeefa;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-title {
  display: -webkit-box;
  color: #111827;
  font-size: 30rpx;
  font-weight: 720;
  line-height: 1.42;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-meta {
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 23rpx;
}

.item-bottom {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.item-price,
.summary-price {
  color: #237bc7;
  font-weight: 780;
}

.item-price {
  font-size: 34rpx;
}

.quantity-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.quantity-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #eef5ff;
  color: #237bc7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.quantity-value {
  min-width: 34rpx;
  text-align: center;
  color: #20304a;
  font-size: 27rpx;
  font-weight: 700;
}

.remove-btn {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #f3f7fb;
  color: #98a2b3;
  font-size: 34rpx;
  line-height: 38rpx;
  text-align: center;
}

.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 30rpx rgba(14, 52, 110, 0.08);
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.summary-block {
  flex: 1;
  min-width: 0;
}

.summary-label {
  display: block;
  color: #72839a;
  font-size: 23rpx;
}

.summary-price {
  display: block;
  margin-top: 6rpx;
  font-size: 38rpx;
  line-height: 1;
}

.primary-btn,
.ghost-btn {
  margin: 0;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.primary-btn {
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  border-color: rgba(45, 143, 232, 0.24);
  color: #2d8fe8;
  font-weight: 720;
}

.ghost-btn {
  background: rgba(255, 255, 255, 0.58);
  border-color: rgba(148, 163, 184, 0.18);
  color: #475467;
}

.clear-btn {
  flex: none;
  width: 112rpx;
  height: 56rpx;
  font-size: 24rpx;
}

.checkout-btn {
  flex: none;
  width: 260rpx;
  height: 76rpx;
  font-size: 28rpx;
}

.empty-card {
  margin-top: 120rpx;
  padding: 52rpx 32rpx;
  text-align: center;
}

.empty-title,
.empty-desc {
  display: block;
}

.empty-title {
  color: #20304a;
  font-size: 34rpx;
  font-weight: 760;
}

.empty-desc {
  margin-top: 12rpx;
  color: #72839a;
  font-size: 25rpx;
}

.empty-btn {
  width: 240rpx;
  height: 72rpx;
  margin: 32rpx auto 0;
  font-size: 27rpx;
}
