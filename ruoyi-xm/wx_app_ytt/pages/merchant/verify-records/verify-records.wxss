.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 42%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.panel {
  border-radius: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.76)),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 660;
}

.status-tag.green {
  background: #e9f8f1;
  color: #168257;
}

.status-tag.orange {
  background: #fff5e8;
  color: #c76f12;
}

.status-tag.gray {
  background: #edf2f7;
  color: #667085;
}

.tabs {
  padding: 8rpx;
  display: flex;
  gap: 10rpx;
}

.tab-item {
  flex: 1;
  height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #667085;
  font-size: 24rpx;
}

.tab-item.active {
  color: #237bc7;
  background: #ffffff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.84), 0 8rpx 18rpx rgba(34, 73, 116, 0.08);
  font-weight: 680;
}

.record-card {
  margin-top: 18rpx;
  padding: 28rpx;
}

.record-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 720;
  line-height: 1.35;
}

.record-meta,
.record-grid,
.record-error {
  margin-top: 12rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.6;
}

.record-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx 16rpx;
}

.record-error {
  display: block;
  color: #d94b4b;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  color: #667085;
  font-size: 26rpx;
}
