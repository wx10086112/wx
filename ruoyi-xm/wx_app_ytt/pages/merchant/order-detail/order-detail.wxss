.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 140rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 42%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.panel {
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.76)),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
}

.primary-btn,
.ghost-btn {
  height: 76rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 680;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.primary-btn {
  color: #237bc7;
  border-color: rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
}

.ghost-btn {
  color: #475467;
  border-color: rgba(148, 163, 184, 0.18);
  background: rgba(255, 255, 255, 0.58);
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.status-hero {
  padding: 36rpx 30rpx;
  border-radius: 38rpx;
  background: linear-gradient(145deg, #78c3ff 0%, #2d8fe8 100%);
  box-shadow: 0 22rpx 50rpx rgba(45, 143, 232, 0.24);
}

.status-hero.orange {
  background: linear-gradient(145deg, #ffbd74 0%, #e58a19 100%);
  box-shadow: 0 22rpx 50rpx rgba(229, 138, 25, 0.18);
}

.status-hero.green {
  background: linear-gradient(145deg, #48d297 0%, #16a36a 100%);
  box-shadow: 0 22rpx 50rpx rgba(22, 163, 106, 0.18);
}

.status-hero.gray {
  background: linear-gradient(145deg, #9aa8b7 0%, #667085 100%);
  box-shadow: 0 22rpx 50rpx rgba(102, 112, 133, 0.16);
}

.status-hero-text {
  display: block;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 780;
}

.status-hero-tip {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.6;
}

.detail-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.detail-section-title {
  display: block;
  margin-bottom: 18rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 760;
}

.detail-title {
  display: block;
  margin-bottom: 18rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 780;
}

.detail-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.detail-label {
  flex-shrink: 0;
  min-width: 120rpx;
  color: #667085;
  font-size: 26rpx;
}

.detail-value {
  color: #111827;
  font-size: 26rpx;
  text-align: right;
  word-break: break-all;
}

.detail-value.price {
  color: #111827;
  font-size: 30rpx;
  font-weight: 760;
}

.detail-value.code {
  color: #237bc7;
  font-size: 26rpx;
  font-weight: 560;
  letter-spacing: 1rpx;
}

.detail-value.remark {
  color: #667085;
}

.customer-card {
  padding-bottom: 24rpx;
}

.customer-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.customer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.customer-label {
  flex-shrink: 0;
  min-width: 96rpx;
  color: #667085;
  font-size: 26rpx;
}

.customer-value {
  color: #111827;
  font-size: 26rpx;
  line-height: 1.4;
  text-align: right;
}

.customer-name {
  font-weight: 680;
}

.customer-phone-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
}

.customer-phone {
  flex: 1;
  min-width: 0;
  color: #111827;
}

.customer-note {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(241, 247, 253, 0.84);
  display: flex;
  gap: 18rpx;
}

.customer-note-label {
  flex-shrink: 0;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.customer-note-text {
  flex: 1;
  color: #475467;
  font-size: 24rpx;
  line-height: 1.5;
}

.call-btn {
  flex-shrink: 0;
  width: 84rpx;
  height: 52rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 999rpx;
  border: 1rpx solid rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  color: #237bc7;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 1;
  font-size: 22rpx;
  font-weight: 680;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.call-btn::after {
  border: none;
}

.call-btn.disabled {
  color: rgba(35, 123, 199, 0.48);
  border-color: rgba(45, 143, 232, 0.14);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.78), rgba(231, 244, 255, 0.66)),
    #eef6fd;
}

.timeline {
  padding-left: 8rpx;
}

.timeline-item {
  display: flex;
  gap: 18rpx;
  padding-bottom: 28rpx;
  position: relative;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 30rpx;
  bottom: 0;
  width: 2rpx;
  background: rgba(20, 54, 91, 0.1);
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  flex-shrink: 0;
  width: 22rpx;
  height: 22rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: #2d8fe8;
  position: relative;
  z-index: 1;
}

.timeline-item.done .timeline-dot {
  background: #16a36a;
}

.timeline-item.failed .timeline-dot {
  background: #d94b4b;
}

.timeline-content {
  flex: 1;
}

.timeline-label {
  display: block;
  color: #111827;
  font-size: 26rpx;
  font-weight: 680;
}

.timeline-time,
.timeline-reason {
  display: block;
  margin-top: 6rpx;
  color: #667085;
  font-size: 24rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 0 -12rpx 36rpx rgba(34, 73, 116, 0.08);
  z-index: 100;
}

.action-btn {
  flex: 1;
}

.reject-style {
  color: #c76f12;
  border-color: rgba(229, 138, 25, 0.22);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(255, 245, 232, 0.92)),
    #fff5e8;
}

.cancel-style {
  color: #667085;
  border-color: rgba(148, 163, 184, 0.18);
  background: rgba(255, 255, 255, 0.58);
}

.refund-approve {
  color: #168257;
  border-color: rgba(22, 163, 106, 0.22);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(233, 248, 241, 0.94)),
    #e9f8f1;
}

.cancel-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(17, 24, 39, 0.34);
}

.cancel-modal-card {
  width: 100%;
  padding: 34rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 32rpx 76rpx rgba(34, 73, 116, 0.18);
}

.cancel-modal-title {
  display: block;
  color: #111827;
  font-size: 34rpx;
  font-weight: 760;
}

.cancel-modal-desc {
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.6;
}

.cancel-reason-input {
  width: 100%;
  min-height: 160rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 26rpx;
  background: #f1f7fd;
  color: #111827;
  font-size: 28rpx;
}

.cancel-modal-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.cancel-modal-btn {
  flex: 1;
  height: 74rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  font-size: 27rpx;
  font-weight: 680;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.cancel-modal-btn::after {
  border: none;
}

.cancel-modal-btn.secondary {
  background: rgba(255, 255, 255, 0.58);
  border-color: rgba(148, 163, 184, 0.18);
  color: #475467;
}

.cancel-modal-btn.primary {
  color: #237bc7;
  border-color: rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
}

.cancel-modal-btn.success {
  color: #168257;
  border-color: rgba(22, 163, 106, 0.22);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(233, 248, 241, 0.94)),
    #e9f8f1;
}
