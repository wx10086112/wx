<view class="store-page">
  <view wx:if="{{loading}}" class="state-text">加载中...</view>
  <view wx:elif="{{errorText}}" class="state-text">{{errorText}}</view>
  <block wx:else>
    <view class="page-head">
      <text class="page-title">{{merchantName || '门店列表'}}</text>
      <text class="page-subtitle">{{stores.length}} 家门店 · 券六店通用</text>
    </view>

    <view
      wx:for="{{stores}}"
      wx:key="id"
      class="store-card {{item.id === currentStoreId ? 'is-current' : ''}}"
    >
      <view class="store-title-row">
        <text class="store-name">{{item.name}}</text>
        <text wx:if="{{item.isMain === 1}}" class="tag tag-main">主门店</text>
        <text wx:if="{{item.id === currentStoreId}}" class="tag tag-current">当前</text>
        <text wx:if="{{item.distanceText}}" class="store-distance">{{item.distanceText}}</text>
      </view>
      <text class="store-address">{{item.address || '暂无地址'}}</text>
      <text class="store-meta">{{item.businessHours || '暂无营业时间'}} · {{item.phone || '暂无电话'}}</text>
      <view class="store-actions">
        <text class="action" catchtap="openLocation" data-index="{{index}}">导航</text>
        <text class="action" catchtap="callStore" data-index="{{index}}">电话</text>
        <text class="action action-primary" catchtap="selectStore" data-index="{{index}}">选为当前门店</text>
      </view>
    </view>
  </block>
</view>
