.custom-tabbar {
  height: 116rpx;
  padding: 10rpx 24rpx calc(10rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.88);
  border-top: 1rpx solid rgba(255, 255, 255, 0.74);
  box-shadow: 0 -14rpx 40rpx rgba(34, 73, 116, 0.08);
  backdrop-filter: blur(22px) saturate(170%);
  -webkit-backdrop-filter: blur(22px) saturate(170%);
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.tabbar-item {
  min-height: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
}

.tabbar-icon {
  width: 44rpx;
  height: 44rpx;
  background-color: #8a9aad;
}

.tabbar-item.active .tabbar-icon {
  background-color: #2d8fe8;
}

.tabbar-text {
  color: #8a9aad;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1;
}

.tabbar-item.active .tabbar-text {
  color: #2d8fe8;
  font-weight: 760;
}

