.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 140rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.empty-btn {
  margin-top: 40rpx;
  padding: 16rpx 48rpx;
  border: 2rpx solid #ff6b6b;
  color: #ff6b6b;
  font-size: 28rpx;
  border-radius: 32rpx;
}
