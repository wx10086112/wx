.service-card {
  padding: 22rpx;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.76)),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 44rpx rgba(34, 73, 116, 0.08);
  display: flex;
  gap: 22rpx;
}

.service-card:active {
  transform: scale(0.985);
  opacity: 0.88;
}

.service-img {
  width: 184rpx;
  height: 184rpx;
  border-radius: 28rpx;
  background: #dbeefa;
  flex-shrink: 0;
}

.service-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.service-title {
  margin-bottom: 12rpx;
  color: #111827;
  font-size: 31rpx;
  font-weight: 720;
  line-height: 1.38;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.service-meta {
  color: #667085;
  font-size: 23rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
}

.service-tag {
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #f1f7fd;
  color: #667085;
  font-size: 20rpx;
  line-height: 34rpx;
}

.service-bottom {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 14rpx;
}

.service-price {
  color: #2d8fe8;
  font-size: 36rpx;
  font-weight: 760;
  line-height: 1;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.currency {
  margin-right: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.original-price {
  margin-left: 12rpx;
  color: #98a2b3;
  font-size: 22rpx;
  font-weight: 400;
  text-decoration: line-through;
}

.btn-buy {
  height: 56rpx;
  min-width: 112rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #2d8fe8;
  border: 1rpx solid rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
  font-size: 25rpx;
  font-weight: 680;
  line-height: 56rpx;
  text-align: center;
}
