.service-card {
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 24rpx;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.8);
  transition: all 0.2s ease;
}

.service-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.service-img {
  width: 176rpx;
  height: 176rpx;
  border-radius: 28rpx;
  background: #F4F1EA;
  flex-shrink: 0;
}

.service-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.service-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.service-meta {
  font-size: 24rpx;
  color: #8A8A8E;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.service-tag {
  background: #F7F5F0;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.service-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.service-price {
  font-size: 36rpx;
  font-weight: 600;
  color: #C8A46A;
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 24rpx;
  font-weight: normal;
  margin-right: 4rpx;
}

.original-price {
  font-size: 22rpx;
  color: #B0B0B5;
  text-decoration: line-through;
  margin-left: 12rpx;
  font-weight: normal;
}

.btn-buy {
  background: rgba(200, 164, 106, 0.1);
  color: #C8A46A;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 999rpx;
}
