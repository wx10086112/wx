.product-card {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 14rpx 38rpx rgba(20, 55, 105, 0.06);
  margin-bottom: 22rpx;
  padding: 22rpx;
  display: flex;
}

.product-image {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  flex-shrink: 0;
  border-radius: 22rpx;
  overflow: hidden;
  background: #eef2f7;
}

.product-image .image {
  width: 100%;
  height: 100%;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.tag {
  display: inline-block;
  padding: 5rpx 12rpx;
  background: #fff1e8;
  color: #b95c20;
  font-size: 21rpx;
  border-radius: 8rpx;
  font-weight: 650;
}

.product-info {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
}

.product-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.36;
}

.product-subtitle {
  margin-top: 8rpx;
  color: #7c8797;
  font-size: 24rpx;
}

.rule-line {
  margin-top: 8rpx;
  color: #9aa4b2;
  font-size: 23rpx;
  line-height: 1.35;
}

.product-footer {
  margin-top: auto;
  padding-top: 12rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 14rpx;
}

.price-info {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  min-width: 0;
}

.price {
  color: #ff5d18;
  font-size: 40rpx;
  font-weight: 850;
}

.original-price {
  margin-left: 12rpx;
  color: #a3abb7;
  text-decoration: line-through;
  font-size: 24rpx;
}

.sales {
  margin-left: 12rpx;
  color: #8a96a8;
  font-size: 22rpx;
}

.buy-btn {
  flex-shrink: 0;
  min-width: 112rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8a2a 0%, #ff5d18 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 22rpx rgba(255, 93, 24, 0.28);
}
