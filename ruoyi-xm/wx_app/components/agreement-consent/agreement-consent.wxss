.agreement-consent {
  width: 100%;
  min-height: 44rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 0;
  box-sizing: border-box;
}

.agreement-consent--primary {
  margin-top: 18rpx;
}

.agreement-main {
  max-width: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 10rpx;
}

.agreement-check {
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  margin-top: 5rpx;
  border-radius: 50%;
  border: 2rpx solid #c8d4e5;
  color: #fff;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 1;
  box-sizing: border-box;
}

.is-checked .agreement-check {
  border-color: #2f7cff;
  background: #2f7cff;
}

.agreement-text {
  min-width: 0;
  color: #98a2b3;
  font-size: 22rpx;
  line-height: 1.7;
}

.agreement-link {
  color: #2f7cff;
  font-weight: 600;
}

.agreement-panel {
  position: fixed;
  inset: 0;
  z-index: 1200;
}

.agreement-mask {
  position: absolute;
  inset: 0;
  background: rgba(14, 24, 40, 0.45);
}

.agreement-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 86vh;
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  overflow: hidden;
}

.agreement-sheet__header {
  min-height: 96rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: 1rpx solid #eef2f7;
  box-sizing: border-box;
}

.agreement-sheet__title {
  color: #1f2937;
  font-size: 33rpx;
  font-weight: 750;
}

.agreement-sheet__close {
  width: 56rpx;
  height: 56rpx;
  color: #98a2b3;
  font-size: 44rpx;
  line-height: 52rpx;
  text-align: center;
}

.agreement-tabs {
  padding: 20rpx 30rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.agreement-tab {
  min-height: 62rpx;
  padding: 0 10rpx;
  border-radius: 14rpx;
  color: #667085;
  background: #f3f6fb;
  font-size: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.agreement-tab.active {
  color: #2f7cff;
  background: #eaf2ff;
  font-weight: 650;
}

.agreement-content {
  height: 520rpx;
  border-top: 1rpx solid #eef2f7;
  border-bottom: 1rpx solid #eef2f7;
  box-sizing: border-box;
}

.agreement-doc {
  padding: 28rpx 30rpx 36rpx;
}

.agreement-doc__title {
  display: block;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 750;
}

.agreement-doc__meta {
  display: block;
  margin-top: 10rpx;
  color: #98a2b3;
  font-size: 22rpx;
  line-height: 1.5;
}

.agreement-doc__section {
  display: block;
  margin-top: 28rpx;
  color: #253044;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.5;
}

.agreement-doc__p {
  display: block;
  margin-top: 16rpx;
  color: #5f6f84;
  font-size: 25rpx;
  line-height: 1.75;
}

.wechat-privacy-btn {
  margin: 30rpx 0 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 16rpx;
  color: #2f7cff;
  background: #eef5ff;
  font-size: 26rpx;
  font-weight: 650;
}

.agreement-sheet__footer {
  padding: 22rpx 30rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.agreement-secondary-btn,
.agreement-primary-btn {
  margin: 0;
  border: none;
  box-sizing: border-box;
}

.agreement-secondary-btn {
  width: 184rpx;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 16rpx;
  color: #667085;
  background: #f4f6fa;
  font-size: 27rpx;
}

.agreement-primary-btn {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 16rpx;
  color: #fff;
  background: #2f7cff;
  font-size: 28rpx;
  font-weight: 700;
}

.agreement-secondary-btn::after,
.agreement-primary-btn::after,
.wechat-privacy-btn::after {
  border: none;
}
