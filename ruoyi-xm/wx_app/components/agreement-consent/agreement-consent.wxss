.agreement-consent {
  width: 100%;
  min-height: 44rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 0;
}

.agreement-consent--primary {
  margin-top: 18rpx;
}

.agreement-main {
  max-width: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 12rpx;
}

.agreement-check {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  border: 1rpx solid #98a2b3;
  color: #ffffff;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 1;
}

.is-checked .agreement-check {
  border-color: #2d8fe8;
  background: #2d8fe8;
}

.agreement-text {
  min-width: 0;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.6;
}

.agreement-link {
  color: #237bc7;
  font-weight: 680;
}

.agreement-panel {
  position: fixed;
  inset: 0;
  z-index: 1200;
}

.agreement-mask {
  position: absolute;
  inset: 0;
  background: rgba(17, 24, 39, 0.34);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.agreement-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 86vh;
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: 40rpx 40rpx 0 0;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background: rgba(255, 255, 255, 0.96);
  overflow: hidden;
  box-shadow: 0 -18rpx 54rpx rgba(34, 73, 116, 0.12);
}

.agreement-sheet__header {
  min-height: 112rpx;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: 1rpx solid rgba(20, 54, 91, 0.08);
}

.agreement-sheet__title {
  color: #111827;
  font-size: 36rpx;
  font-weight: 720;
}

.agreement-sheet__close {
  width: 64rpx;
  height: 64rpx;
  color: #667085;
  font-size: 48rpx;
  line-height: 64rpx;
  text-align: center;
}

.agreement-tabs {
  padding: 8rpx;
  display: flex;
  background: rgba(211, 229, 244, 0.72);
  border-radius: 999rpx;
  margin: 32rpx 40rpx 0;
}

.agreement-tab {
  flex: 1;
  min-height: 64rpx;
  border-radius: 999rpx;
  color: #667085;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.agreement-tab.active {
  color: #237bc7;
  background: #ffffff;
  font-weight: 680;
  box-shadow: 0 8rpx 20rpx rgba(34, 73, 116, 0.1);
}

.agreement-content {
  height: 520rpx;
  margin-top: 24rpx;
  border-top: 1rpx solid rgba(20, 54, 91, 0.08);
  border-bottom: 1rpx solid rgba(20, 54, 91, 0.08);
}

.agreement-doc {
  padding: 32rpx 40rpx 40rpx;
}

.agreement-doc__title {
  display: block;
  color: #111827;
  font-size: 32rpx;
  font-weight: 720;
}

.agreement-doc__meta {
  display: block;
  margin-top: 12rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.agreement-doc__section {
  display: block;
  margin-top: 32rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}

.agreement-doc__p {
  display: block;
  margin-top: 16rpx;
  color: #344054;
  font-size: 26rpx;
  line-height: 1.75;
}

.wechat-privacy-btn {
  margin: 40rpx 0 0;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 999rpx;
  border: 1rpx solid rgba(45, 143, 232, 0.24);
  color: #237bc7;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  font-size: 26rpx;
  font-weight: 680;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.agreement-sheet__footer {
  padding: 32rpx 40rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.agreement-secondary-btn,
.agreement-primary-btn {
  margin: 0;
  border: 1rpx solid transparent;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.agreement-secondary-btn {
  width: 200rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 999rpx;
  border-color: rgba(148, 163, 184, 0.18);
  color: #475467;
  background: rgba(255, 255, 255, 0.58);
  font-size: 26rpx;
  font-weight: 600;
}

.agreement-primary-btn {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 999rpx;
  border-color: rgba(45, 143, 232, 0.24);
  color: #237bc7;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  font-size: 26rpx;
  font-weight: 680;
}

.agreement-primary-btn:active,
.agreement-secondary-btn:active,
.wechat-privacy-btn:active {
  transform: translateY(1rpx) scale(0.985);
  opacity: 0.9;
}

.agreement-secondary-btn::after,
.agreement-primary-btn::after,
.wechat-privacy-btn::after {
  border: none;
}
