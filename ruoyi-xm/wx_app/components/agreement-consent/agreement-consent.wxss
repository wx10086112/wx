.agreement-consent {
  width: 100%;
  min-height: 44rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 0;
  box-sizing: border-box;
}

.agreement-consent--primary {
  margin-top: 18rpx;
}

.agreement-main {
  max-width: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 12rpx;
}

.agreement-check {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  border: 1px solid #B0B0B5;
  color: #fff;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 1;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.is-checked .agreement-check {
  border-color: #1D1D1F;
  background: #1D1D1F;
}

.agreement-text {
  min-width: 0;
  color: #8A8A8E;
  font-size: 24rpx;
  line-height: 1.6;
}

.agreement-link {
  color: #1D1D1F;
  font-weight: 600;
}

.agreement-panel {
  position: fixed;
  inset: 0;
  z-index: 1200;
}

.agreement-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.agreement-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 86vh;
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: 40rpx 40rpx 0 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  overflow: hidden;
  box-shadow: 0 -16rpx 48rpx rgba(0, 0, 0, 0.06);
}

.agreement-sheet__header {
  min-height: 112rpx;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: 1px solid #E8E5DE;
  box-sizing: border-box;
}

.agreement-sheet__title {
  color: #1D1D1F;
  font-size: 36rpx;
  font-weight: 600;
}

.agreement-sheet__close {
  width: 64rpx;
  height: 64rpx;
  color: #8A8A8E;
  font-size: 48rpx;
  line-height: 64rpx;
  text-align: center;
}

.agreement-tabs {
  padding: 8rpx;
  display: flex;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 999rpx;
  margin: 32rpx 40rpx 0;
}

.agreement-tab {
  flex: 1;
  min-height: 64rpx;
  border-radius: 999rpx;
  color: #8A8A8E;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.agreement-tab.active {
  color: #C8A46A;
  background: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.agreement-content {
  height: 520rpx;
  margin-top: 24rpx;
  border-top: 1px solid #E8E5DE;
  border-bottom: 1px solid #E8E5DE;
  box-sizing: border-box;
}

.agreement-doc {
  padding: 32rpx 40rpx 40rpx;
}

.agreement-doc__title {
  display: block;
  color: #1D1D1F;
  font-size: 32rpx;
  font-weight: 600;
}

.agreement-doc__meta {
  display: block;
  margin-top: 12rpx;
  color: #8A8A8E;
  font-size: 24rpx;
  line-height: 1.5;
}

.agreement-doc__section {
  display: block;
  margin-top: 32rpx;
  color: #1D1D1F;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.agreement-doc__p {
  display: block;
  margin-top: 16rpx;
  color: #3A3A3C;
  font-size: 26rpx;
  line-height: 1.75;
}

.wechat-privacy-btn {
  margin: 40rpx 0 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 999rpx;
  color: #1D1D1F;
  background: #F7F5F0;
  font-size: 28rpx;
  font-weight: 600;
}

.agreement-sheet__footer {
  padding: 32rpx 40rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.agreement-secondary-btn,
.agreement-primary-btn {
  margin: 0;
  border: none;
  box-sizing: border-box;
}

.agreement-secondary-btn {
  width: 200rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 999rpx;
  color: #3A3A3C;
  background: #F7F5F0;
  font-size: 28rpx;
  font-weight: 500;
}

.agreement-primary-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: #1D1D1F;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.agreement-primary-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.agreement-secondary-btn::after,
.agreement-primary-btn::after,
.wechat-privacy-btn::after {
  border: none;
}
