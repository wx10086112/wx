.order-card {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(22, 119, 255, 0.08);
  backdrop-filter: blur(18rpx);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-content {
  display: flex;
  padding: 22rpx 0;
  border-top: 1rpx solid #edf2fb;
  border-bottom: 1rpx solid #edf2fb;
}

.order-image {
  width: 168rpx;
  height: 168rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.order-info {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.order-title {
  font-size: 30rpx;
  color: #20304a;
  line-height: 1.45;
}

.order-merchant {
  color: #7c8ba1;
}

.order-meta,
.order-price {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  color: #1677ff;
  font-weight: bold;
}

.write-off-code {
  color: #3d8bff;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 18rpx;
}

.action-btns {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  height: 66rpx;
  line-height: 66rpx;
  padding: 0 34rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  border: none;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

.action-btn-light {
  background: #f4f8ff;
  color: #4f637e;
}

.action-btn-primary {
  background: linear-gradient(135deg, #1677ff 0%, #57a6ff 100%);
  color: #fff;
}
