.order-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.76)),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 44rpx rgba(34, 73, 116, 0.08);
}

.order-card:active {
  opacity: 0.86;
  transform: scale(0.988);
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.order-no {
  flex: 1;
  min-width: 0;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-badge {
  flex-shrink: 0;
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.status-pending,
.status-refunding {
  color: #237bc7;
  background: #e7f4ff;
}

.status-paid {
  color: #168257;
  background: #e9f8f1;
}

.status-completed {
  color: #667085;
  background: #edf2f7;
}

.status-cancelled,
.status-default {
  color: #98a2b3;
  background: #f3f7fb;
}

.order-content {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(20, 54, 91, 0.08);
  display: flex;
  gap: 22rpx;
}

.order-image {
  width: 148rpx;
  height: 148rpx;
  border-radius: 26rpx;
  background: #dbeefa;
  flex-shrink: 0;
}

.order-info {
  flex: 1;
  min-width: 0;
}

.order-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 740;
  line-height: 1.42;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.order-merchant {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.35;
}

.order-meta {
  margin-top: 14rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.35;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.order-price {
  margin-top: 16rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.price {
  color: #111827;
  font-size: 34rpx;
  font-weight: 820;
  line-height: 1;
}

.order-phone {
  color: #98a2b3;
  font-size: 22rpx;
  line-height: 1.2;
}

.order-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
}

.action-btns {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 14rpx;
}

.action-btn {
  min-width: 132rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 660;
  line-height: 58rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  opacity: 0.9;
  transform: translateY(1rpx) scale(0.985);
}

.action-btn-light {
  color: #475467;
  border-color: rgba(148, 163, 184, 0.18);
  background: rgba(255, 255, 255, 0.58);
}

.action-btn-primary {
  color: #2d8fe8;
  border-color: rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
}
