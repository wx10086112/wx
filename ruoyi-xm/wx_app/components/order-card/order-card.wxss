.order-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 1px solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 12rpx 36rpx rgba(32, 28, 22, 0.05);
}

.order-card:active {
  opacity: 0.82;
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.order-no {
  flex: 1;
  min-width: 0;
  color: #8A8A8E;
  font-size: 23rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-badge {
  flex-shrink: 0;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.status-pending {
  color: #A15C00;
  background: #FFF3DF;
}

.status-paid {
  color: #236B3A;
  background: #EAF7EE;
}

.status-completed {
  color: #4B5563;
  background: #F1F0EC;
}

.status-refunding {
  color: #8A5A00;
  background: #FFF7DF;
}

.status-cancelled,
.status-default {
  color: #7A746A;
  background: #F1F0EC;
}

.order-content {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1px solid #EDE9E1;
  display: flex;
  gap: 22rpx;
}

.order-image {
  width: 148rpx;
  height: 148rpx;
  border-radius: 24rpx;
  background: #F0EDE6;
  flex-shrink: 0;
}

.order-info {
  flex: 1;
  min-width: 0;
}

.order-title {
  color: #1D1D1F;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.42;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.order-merchant {
  margin-top: 8rpx;
  color: #8A8A8E;
  font-size: 24rpx;
  line-height: 1.35;
}

.order-meta {
  margin-top: 14rpx;
  color: #8A8A8E;
  font-size: 22rpx;
  line-height: 1.35;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.write-off-code {
  color: #A96F17;
  font-weight: 700;
}

.order-price {
  margin-top: 16rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.price {
  color: #1D1D1F;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
}

.order-phone {
  color: #A7A19A;
  font-size: 22rpx;
  line-height: 1.2;
}

.order-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
}

.action-btns {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 14rpx;
}

.action-btn {
  min-width: 148rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 64rpx;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  opacity: 0.78;
}

.action-btn-light {
  background: #F6F4EF;
  color: #3A3A3C;
}

.action-btn-primary {
  background: #1D1D1F;
  color: #FFFFFF;
}
