<view class="order-page">
  <view class="page-intro">
    <text class="page-title">我的订单</text>
  </view>

  <view class="overview-strip">
    <view
      wx:for="{{orderStats}}"
      wx:key="label"
      class="overview-item {{currentTab === item.tab ? 'active' : ''}}"
      bindtap="onQuickFilterTap"
      data-tab="{{item.tab}}"
    >
      <text class="overview-value">{{item.value}}</text>
      <text class="overview-label">{{item.label}}</text>
    </view>
  </view>

  <view class="order-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="tab-item {{currentTab === item.value ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="{{item.value}}"
    >
      <text class="tab-text">{{item.label}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-card">
    <view class="loading-dot"></view>
    <text class="loading-text">正在加载订单</text>
  </view>

  <block wx:elif="{{orderList.length}}">
    <view class="order-list">
      <order-card
        wx:for="{{orderList}}"
        wx:key="id"
        order="{{item}}"
        showActions="{{true}}"
        bind:click="onOrderTap"
        bind:cancel="onCancelOrder"
        bind:pay="onPayOrder"
        bind:viewCode="onViewCode"
        bind:refund="onRefundOrder"
        bind:rebuy="onRebuyOrder"
      ></order-card>
    </view>
  </block>

  <view wx:else class="empty-card">
    <view class="empty-badge">订单</view>
    <text class="empty-title">暂无相关订单</text>
    <view class="empty-action" bindtap="goShopping">去逛逛</view>
  </view>

  <view class="write-off-modal" wx:if="{{showWriteOffModal}}" catchtouchmove="preventMove">
    <view class="modal-mask" bindtap="closeWriteOffModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">使用码</text>
        <text class="modal-close" bindtap="closeWriteOffModal">×</text>
      </view>
      <view class="write-off-info">
        <view class="order-preview">
          <image src="{{currentOrder.image}}" class="preview-image" mode="aspectFill"></image>
          <view class="preview-info">
            <text class="preview-title">{{currentOrder.title}}</text>
            <text class="preview-merchant">{{currentOrder.merchantName}}</text>
          </view>
        </view>
        <view class="write-off-code-section">
          <text class="code-label">请向门店店员出示以下使用码</text>
          <view class="code-display">
            <text class="code-text">{{currentOrder.writeOffCode}}</text>
          </view>
          <text class="code-tip">有效期至：{{currentOrder.writeOffDeadlineText}}</text>
        </view>
        <view class="qr-code-section">
          <qrcode text="{{currentOrder.writeOffCode}}" size="{{280}}" />
          <text class="qr-hint">商家扫码后将自动变更为已完成</text>
        </view>
        <view class="modal-footer">
          <button class="modal-action-btn" bindtap="confirmWriteOffResult">我知道了</button>
        </view>
      </view>
    </view>
  </view>
</view>
