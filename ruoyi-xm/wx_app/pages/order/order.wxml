<view class="order-page">
  <view class="order-header-card">
    <view class="order-heading">
      <text class="order-title">我的订单</text>
      <text class="order-subtitle">查看支付、核销与售后进度</text>
    </view>
    <view class="order-stats">
      <view wx:for="{{orderStats}}" wx:key="label" class="order-stat-card">
        <text class="order-stat-value">{{item.value}}</text>
        <text class="order-stat-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="order-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="tab-item {{currentTab === item.value ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="{{item.value}}"
    >
      <text class="tab-text">{{item.label}}</text>
    </view>
  </view>

  <view class="order-list">
    <order-card
      wx:for="{{orderList}}"
      wx:key="id"
      order="{{item}}"
      showActions="{{true}}"
      bind:click="onOrderTap"
      bind:cancel="onCancelOrder"
      bind:pay="onPayOrder"
      bind:viewCode="onViewCode"
      bind:refund="onRefundOrder"
      bind:rebuy="onRebuyOrder"
    ></order-card>
  </view>

  <view wx:if="{{!loading && orderList.length === 0}}" class="order-empty">
    <view class="empty-visual">
      <view class="empty-line"></view>
      <view class="empty-line short"></view>
    </view>
    <text class="empty-title">暂无相关订单</text>
    <text class="empty-desc">下单后可以在这里查看支付、核销和售后进度</text>
    <button class="empty-btn" bindtap="goShopping">去逛逛</button>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-dot"></view>
    <text class="loading-text">正在加载订单</text>
  </view>

  <view class="write-off-modal" wx:if="{{showWriteOffModal}}" catchtouchmove="preventMove">
    <view class="modal-mask" bindtap="closeWriteOffModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">使用码</text>
        <text class="modal-close" bindtap="closeWriteOffModal">×</text>
      </view>
      <view class="write-off-info">
        <view class="order-preview flex flex-align-center">
          <image src="{{currentOrder.image}}" class="preview-image" mode="aspectFill"></image>
          <view class="preview-info ml-20 flex-1">
            <text class="preview-title text-ellipsis-2 fs-28">{{currentOrder.title}}</text>
            <text class="preview-merchant text-muted fs-24 mt-8">{{currentOrder.merchantName}}</text>
          </view>
        </view>
        <view class="write-off-code-section">
          <text class="code-label">请向门店店员出示以下使用码</text>
          <view class="code-display">
            <text class="code-text">{{currentOrder.writeOffCode}}</text>
          </view>
          <text class="code-tip text-muted fs-24 mt-16">有效期至：{{currentOrder.writeOffDeadlineText}}</text>
        </view>
        <view class="qr-code-section">
          <qrcode text="{{currentOrder.writeOffCode}}" size="{{280}}" />
          <text class="qr-hint">商家扫码后将自动变更为已完成</text>
        </view>
        <view class="modal-footer">
          <button class="modal-action-btn" bindtap="confirmWriteOffResult">我知道了</button>
        </view>
      </view>
    </view>
  </view>
</view>
