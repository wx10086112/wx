.order-page {
  min-height: 100vh;
  padding: 26rpx 24rpx 64rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 42%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.page-intro {
  padding: 10rpx 8rpx 0;
}

.page-title {
  display: block;
  color: #111827;
  font-size: 40rpx;
  font-weight: 780;
  line-height: 1.3;
}

.overview-strip {
  margin-top: 22rpx;
  padding: 12rpx;
  border-radius: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.76)),
    rgba(255, 255, 255, 0.86);
  box-shadow: 0 16rpx 44rpx rgba(34, 73, 116, 0.08);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.overview-item {
  min-width: 0;
  min-height: 108rpx;
  padding: 18rpx 10rpx;
  border-radius: 26rpx;
  background: #f1f7fd;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.overview-item.active {
  background: #e7f4ff;
}

.overview-value {
  color: #111827;
  font-size: 34rpx;
  font-weight: 820;
  line-height: 1.1;
}

.overview-label {
  margin-top: 10rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.3;
}

.overview-item.active .overview-label,
.overview-item.active .overview-value {
  color: #237bc7;
}

.order-tabs {
  margin-top: 22rpx;
  padding: 6rpx;
  border-radius: 26rpx;
  background: rgba(211, 229, 244, 0.72);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.tab-item {
  min-width: 0;
  height: 66rpx;
  border-radius: 22rpx;
  color: #667085;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-item.active {
  color: #111827;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 20rpx rgba(34, 73, 116, 0.1);
  font-weight: 720;
}

.tab-text {
  max-width: 100%;
  font-size: 24rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-list {
  padding-top: 22rpx;
}

.empty-card,
.loading-card {
  margin-top: 24rpx;
  padding: 48rpx 36rpx;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 44rpx rgba(34, 73, 116, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-card {
  min-height: 320rpx;
}

.loading-card {
  min-height: 260rpx;
}

.empty-badge {
  min-width: 88rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #e7f4ff;
  color: #237bc7;
  font-size: 24rpx;
  font-weight: 720;
  line-height: 52rpx;
}

.empty-title {
  margin-top: 20rpx;
  color: #111827;
  font-size: 32rpx;
  font-weight: 760;
  line-height: 1.35;
}

.empty-action {
  margin-top: 24rpx;
  min-width: 180rpx;
  height: 64rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(45, 143, 232, 0.24);
  color: #237bc7;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  font-size: 26rpx;
  font-weight: 680;
  line-height: 64rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.empty-action:active {
  opacity: 0.9;
  transform: translateY(1rpx) scale(0.985);
}

.loading-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(45, 143, 232, 0.16);
  border-top-color: #2d8fe8;
}

.loading-text {
  margin-top: 18rpx;
  color: #667085;
  font-size: 26rpx;
}
