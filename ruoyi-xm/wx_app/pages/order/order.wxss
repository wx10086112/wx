.order-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(87, 166, 255, 0.22), transparent 34%),
    #f3f7fd;
  padding: 24rpx;
  box-sizing: border-box;
}

.order-header-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1677ff 0%, #64b1ff 100%);
  box-shadow: 0 24rpx 60rpx rgba(22, 119, 255, 0.18);
}

.order-title {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.order-stats {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.order-stat-card {
  flex: 1;
  padding: 20rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.14);
}

.order-stat-value {
  display: block;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}

.order-stat-label {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
}

.order-tabs {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.tab-item {
  flex: 1;
  height: 76rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.85);
  color: #607089;
  box-shadow: 0 12rpx 28rpx rgba(20, 69, 138, 0.04);
}

.tab-item.active {
  background: linear-gradient(135deg, #1677ff 0%, #5ea8ff 100%);
}

.tab-item.active .tab-text {
  color: #fff;
  font-weight: 600;
}

.tab-text {
  font-size: 28rpx;
}

.order-list {
  padding-top: 24rpx;
}

.write-off-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(11, 24, 48, 0.55);
}

.modal-content {
  position: relative;
  width: 86%;
  max-height: 80vh;
  border-radius: 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(22rpx);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #edf2fb;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #20304a;
}

.modal-close {
  font-size: 46rpx;
  color: #97a5b7;
  line-height: 1;
}

.write-off-info {
  padding: 30rpx;
}

.order-preview {
  padding: 22rpx;
  background: #f5f9ff;
  border-radius: 20rpx;
}

.preview-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.preview-title {
  color: #20304a;
  line-height: 1.4;
}

.write-off-code-section {
  margin-top: 36rpx;
  text-align: center;
}

.code-label {
  font-size: 28rpx;
  color: #607089;
}

.code-display {
  margin-top: 22rpx;
  padding: 30rpx 46rpx;
  background: linear-gradient(135deg, #1677ff 0%, #5ca8ff 100%);
  border-radius: 20rpx;
  display: inline-block;
}

.code-text {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 8rpx;
}

.qr-code-section {
  margin-top: 34rpx;
  text-align: center;
  padding: 30rpx;
  background: #f6faff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-footer {
  margin-top: 28rpx;
}

.modal-action-btn {
  width: 100%;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 22rpx;
  border: none;
  color: #fff;
  font-size: 28rpx;
  background: linear-gradient(135deg, #1677ff 0%, #5ca8ff 100%);
}

.modal-action-btn::after {
  border: none;
}
