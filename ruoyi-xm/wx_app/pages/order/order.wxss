.order-page {
  min-height: 100vh;
  background: #F6F4EF;
  padding: 24rpx 24rpx 64rpx;
  box-sizing: border-box;
}

.order-header-card {
  padding: 30rpx;
  border-radius: 34rpx;
  background: #FFFFFF;
  border: 1px solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 16rpx 46rpx rgba(32, 28, 22, 0.06);
}

.order-heading {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-title {
  color: #1D1D1F;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.order-subtitle {
  color: #8A8A8E;
  font-size: 24rpx;
  line-height: 1.45;
}

.order-stats {
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.order-stat-card {
  min-height: 108rpx;
  padding: 20rpx 12rpx;
  border-radius: 22rpx;
  background: #FAF8F3;
  box-sizing: border-box;
  text-align: center;
}

.order-stat-value {
  display: block;
  color: #1D1D1F;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.15;
}

.order-stat-label {
  display: block;
  margin-top: 10rpx;
  color: #746F66;
  font-size: 23rpx;
  line-height: 1.3;
}

.order-tabs {
  margin-top: 24rpx;
  padding: 6rpx;
  border-radius: 24rpx;
  background: #ECE8DF;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  box-sizing: border-box;
}

.tab-item {
  min-width: 0;
  height: 66rpx;
  border-radius: 20rpx;
  color: #7A746A;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-item.active {
  background: #FFFFFF;
  color: #1D1D1F;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(35, 31, 25, 0.08);
}

.tab-text {
  max-width: 100%;
  font-size: 24rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-list {
  padding-top: 24rpx;
}

.order-empty,
.loading-state {
  margin-top: 28rpx;
  min-height: 420rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 36rpx rgba(32, 28, 22, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
}

.empty-visual {
  width: 112rpx;
  height: 112rpx;
  border-radius: 30rpx;
  background: #FAF8F3;
  border: 1px solid #E8E5DE;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 14rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
}

.empty-line {
  height: 8rpx;
  border-radius: 999rpx;
  background: #D9C7A7;
}

.empty-line.short {
  width: 42rpx;
}

.empty-title {
  margin-top: 28rpx;
  color: #1D1D1F;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
}

.empty-desc {
  margin-top: 10rpx;
  color: #8A8A8E;
  font-size: 25rpx;
  line-height: 1.55;
}

.empty-btn {
  margin-top: 34rpx;
  width: 188rpx;
  height: 72rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #1D1D1F;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.empty-btn::after {
  border: none;
}

.loading-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(200, 164, 106, 0.2);
  border-top-color: #C8A46A;
}

.loading-text {
  margin-top: 18rpx;
  color: #8A8A8E;
  font-size: 26rpx;
}

.write-off-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.52);
}

.modal-content {
  position: relative;
  width: 88%;
  max-height: 82vh;
  border-radius: 36rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 0 32rpx 70rpx rgba(0, 0, 0, 0.16);
}

.modal-header {
  height: 104rpx;
  padding: 0 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #EDE9E1;
  box-sizing: border-box;
}

.modal-title {
  color: #1D1D1F;
  font-size: 34rpx;
  font-weight: 700;
}

.modal-close {
  width: 64rpx;
  height: 64rpx;
  color: #8A8A8E;
  font-size: 46rpx;
  line-height: 58rpx;
  text-align: center;
}

.write-off-info {
  padding: 30rpx;
}

.order-preview {
  padding: 22rpx;
  background: #FAF8F3;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
}

.preview-image {
  width: 116rpx;
  height: 116rpx;
  border-radius: 22rpx;
  background: #F0EDE6;
  flex-shrink: 0;
}

.preview-info {
  min-width: 0;
  margin-left: 20rpx;
}

.preview-title {
  color: #1D1D1F;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.preview-merchant {
  margin-top: 8rpx;
  color: #8A8A8E;
  font-size: 23rpx;
}

.write-off-code-section {
  margin-top: 34rpx;
  text-align: center;
}

.code-label {
  color: #746F66;
  font-size: 27rpx;
}

.code-display {
  margin-top: 22rpx;
  padding: 30rpx 42rpx;
  border-radius: 24rpx;
  background: #1D1D1F;
  display: inline-block;
}

.code-text {
  color: #F1D18A;
  font-size: 54rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
}

.code-tip {
  display: block;
  margin-top: 16rpx;
  color: #8A8A8E;
  font-size: 24rpx;
}

.qr-code-section {
  margin-top: 30rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #FAF8F3;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-hint {
  margin-top: 12rpx;
  color: #8A8A8E;
  font-size: 22rpx;
}

.modal-footer {
  margin-top: 28rpx;
}

.modal-action-btn {
  width: 100%;
  height: 84rpx;
  padding: 0;
  border-radius: 999rpx;
  border: none;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
  background: #1D1D1F;
}

.modal-action-btn::after {
  border: none;
}
