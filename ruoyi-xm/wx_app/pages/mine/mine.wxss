.mine-page {
  min-height: 100vh;
  background: #f3f7fd;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.user-section {
  padding: 28rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #1677ff 0%, #64b1ff 100%);
  box-shadow: 0 24rpx 60rpx rgba(22, 119, 255, 0.18);
}

.user-info,
.login-prompt {
  display: flex;
  align-items: center;
}

.user-info {
  cursor: pointer;
}

.user-avatar,
.login-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-avatar {
  background: transparent;
}

.avatar-placeholder {
  color: #fff;
  font-size: 52rpx;
}

.user-text,
.login-text {
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
}

.nickname,
.login-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}

.phone {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.profile-link {
  margin-left: auto;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 24rpx;
}

.phone-auth-btn {
  flex-shrink: 0;
  margin-left: auto;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  background: #fff;
  color: #1677ff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.phone-auth-btn::after,
.logout-btn::after {
  border: none;
}

.merchant-section,
.menu-section {
  margin-top: 24rpx;
  box-sizing: border-box;
}

.menu-section {
  padding: 26rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(20, 69, 138, 0.07);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-title {
  font-size: 30rpx;
  color: #20304a;
  font-weight: 600;
}

.about-store-card {
  padding: 26rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 24rpx 68rpx rgba(20, 55, 105, 0.14);
  box-sizing: border-box;
}

.about-store-main {
  display: flex;
  align-items: flex-start;
}

.about-store-info {
  flex: 1;
  min-width: 0;
}

.about-store-name-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.about-store-name {
  flex: 1;
  color: #161d2f;
  font-size: 38rpx;
  line-height: 1.22;
  font-weight: 800;
}

.about-store-status {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.about-store-status.open {
  color: #0b9b61;
  background: rgba(11, 155, 97, 0.1);
}

.about-store-status.closed {
  color: #8a96a8;
  background: #eef1f5;
}

.about-store-tag-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.about-store-tag,
.mini-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #4c6f9d;
  background: #edf5ff;
  font-size: 22rpx;
}

.about-store-time-row {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eef1f6;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  color: #5c6573;
  font-size: 25rpx;
}

.time-strong {
  color: #1f2a3d;
  font-weight: 700;
}

.detail-link {
  margin-left: auto;
  color: #7b8798;
}

.about-store-address-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.address-main {
  flex: 1;
  min-width: 0;
}

.about-store-address {
  display: block;
  color: #1f2a3d;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.45;
}

.distance-text {
  display: block;
  margin-top: 8rpx;
  color: #8a96a8;
  font-size: 24rpx;
}

.about-store-actions {
  display: flex;
  gap: 14rpx;
}

.about-store-action {
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  background: #f4f7fb;
  color: #20293b;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
}

.action-icon {
  margin-bottom: 4rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.service-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.service-card {
  min-height: 108rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f4f8ff;
  box-sizing: border-box;
}

.service-title {
  display: block;
  color: #20304a;
  font-size: 28rpx;
  font-weight: 600;
}

.service-desc {
  display: block;
  margin-top: 10rpx;
  color: #7a8aa0;
  font-size: 22rpx;
}

.logout-section {
  margin-top: 32rpx;
}

.logout-btn {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: #fff;
  color: #1677ff;
  font-size: 30rpx;
  border: none;
}
