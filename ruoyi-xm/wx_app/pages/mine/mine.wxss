.menu-title {
  flex: 1;
  min-width: 0;
  color: #111827;
  font-size: 29rpx;
  font-weight: 620;
  line-height: 1.4;
}

.menu-arrow {
  color: #98a2b3;
  font-size: 44rpx;
  line-height: 1;
  font-weight: 300;
}
