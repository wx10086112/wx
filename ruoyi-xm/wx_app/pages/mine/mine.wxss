.mine-page {
  min-height: 100vh;
  padding: 44rpx 28rpx 44rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 44%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.mine-top {
  padding: 18rpx 6rpx 0;
}

.user-row {
  min-height: 108rpx;
  display: flex;
  align-items: center;
}

.user-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #dbeefa;
  border: 4rpx solid rgba(255, 255, 255, 0.86);
  box-shadow: 0 16rpx 34rpx rgba(45, 143, 232, 0.13);
  flex-shrink: 0;
}

.user-name-row {
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  align-items: center;
}

.user-name {
  max-width: 460rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 720;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-card {
  margin-top: 34rpx;
  padding: 12rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.72)),
    rgba(255, 255, 255, 0.86);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
  overflow: hidden;
}

.menu-row {
  min-height: 104rpx;
  width: 100%;
  margin: 0;
  padding: 0 26rpx;
  border-radius: 30rpx;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  text-align: left;
}

.menu-row:active {
  background: rgba(231, 244, 255, 0.72);
}

.menu-row::after {
  border: none;
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
  background-color: #2d8fe8;
  opacity: 0.92;
}

