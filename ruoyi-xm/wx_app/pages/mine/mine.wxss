.mine-page {
  min-height: 100vh;
  padding: 44rpx 32rpx 44rpx;
  box-sizing: border-box;
  background-color: #FAF8F3;
}

.mine-top {
  padding-top: 28rpx;
}

.user-row {
  min-height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.user-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #E8E5DE;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}

.user-name-row {
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.user-name {
  max-width: 440rpx;
  color: #1D1D1F;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-arrow {
  color: #8A8A8E;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 300;
}

.settings-btn {
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(0,0,0,0.03);
}

