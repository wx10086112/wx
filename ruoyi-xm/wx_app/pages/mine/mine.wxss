  background-size: cover;
  background-repeat: no-repeat;
}

.benefit-banner {
  height: 120rpx;
  margin-top: 48rpx;
  padding: 0 32rpx;
  border-radius: 32rpx;
  background: #1D1D1F;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
}

.banner-left {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.diamond-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  transform: rotate(45deg);
  border-radius: 8rpx;
  background: #C8A46A;
  flex-shrink: 0;
}

.diamond-icon::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #1D1D1F;
}

.banner-title {
  color: #F7F5F0;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
  flex-shrink: 0;
}

.banner-subtitle {
  color: #8A8A8E;
  font-size: 24rpx;
  line-height: 1;
  white-space: nowrap;
}

.banner-action {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #C8A46A;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 64rpx;
  text-align: center;
  box-sizing: border-box;
}

.menu-card {
  margin-top: 40rpx;
  padding: 16rpx 0;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.menu-row {
  min-height: 128rpx;
  width: 100%;
  margin: 0;
  padding: 0 40rpx;
  border-radius: 0;
  background: transparent;
  border: none;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  text-align: left;
  transition: background 0.2s;
}

.menu-row:active {
  background: rgba(0, 0, 0, 0.02);
}

.menu-row::after {
  border: none;
}

.menu-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  margin-right: 32rpx;
  flex-shrink: 0;
  color: #1D1D1F;
  box-sizing: border-box;
}

.icon-profile {
  border: 4rpx solid #1D1D1F;
  border-radius: 14rpx;
}

.icon-profile::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #1D1D1F;
}

.icon-profile::after {
  content: '';
  position: absolute;
  left: 8rpx;
  bottom: 6rpx;
  width: 24rpx;
  height: 12rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  background: #1D1D1F;
}

.icon-service {
  border: 4rpx solid #1D1D1F;
  border-radius: 16rpx;
}

.icon-service::before {
  content: '';
  position: absolute;
  left: 8rpx;
  bottom: -8rpx;
  width: 16rpx;
  height: 16rpx;
  border-left: 4rpx solid #1D1D1F;
  border-bottom: 4rpx solid #1D1D1F;
  border-radius: 0 0 0 8rpx;
  background: transparent;
}

.icon-service::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 18rpx;
  width: 16rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #1D1D1F;
}

.icon-merchant {
  border: 4rpx solid #1D1D1F;
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
}

.icon-merchant::before {
  content: '';
  position: absolute;
  left: -4rpx;
  right: -4rpx;
  top: -12rpx;
  height: 16rpx;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  border: 4rpx solid #1D1D1F;
  background: transparent;
}

.icon-merchant::after {
  content: '';
  position: absolute;
  left: 14rpx;
  bottom: -4rpx;
  width: 14rpx;
  height: 20rpx;
  border: 4rpx solid #1D1D1F;
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
  background: transparent;
}

.menu-title {
  flex: 1;
  min-width: 0;
  color: #1D1D1F;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.4;
}

.menu-arrow {
  color: #8A8A8E;
  font-size: 48rpx;
  line-height: 1;
  font-weight: 300;
}
