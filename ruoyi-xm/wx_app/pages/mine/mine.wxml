<view class="mine-page">
  <view class="user-section">
    <view wx:if="{{isLoggedIn}}" class="user-info" bindtap="goProfileEdit">
      <image src="{{userInfo.avatarUrl}}" class="user-avatar" mode="aspectFill"></image>
      <view class="user-text">
        <text class="nickname">{{userInfo.nickName || '微信用户'}}</text>
        <text class="phone">{{userInfo.phone || '未绑定手机号'}}</text>
      </view>
    </view>

    <view wx:elif="{{loginStep === 'phone'}}" class="login-prompt">
      <view class="login-avatar">
        <text class="avatar-placeholder">◉</text>
      </view>
      <view class="login-text">
        <text class="login-title">授权手机号</text>
      </view>
      <button
        class="phone-auth-btn"
        open-type="getPhoneNumber"
        bindgetphonenumber="handlePhoneAuth"
      >授权</button>
    </view>

    <view wx:else class="login-prompt" bindtap="handleLogin">
      <view class="login-avatar">
        <text class="avatar-placeholder">◉</text>
      </view>
      <view class="login-text">
        <text class="login-title">{{profileConfig.loginTitle}}</text>
      </view>
    </view>
  </view>

  <view class="order-section">
    <view class="section-header" bindtap="goOrder">
      <text class="header-title">{{profileConfig.orderSectionTitle}}</text>
      <text class="more-text">{{profileConfig.orderMoreText}}</text>
    </view>
    <view class="order-icons">
      <view
        wx:for="{{orderEntryList}}"
        wx:key="label"
        class="icon-item"
        bindtap="handleOrderEntry"
        data-status="{{item.status}}"
        data-url="{{item.url}}"
      >
        <view wx:if="{{item.badge}}" class="entry-badge">{{item.badge}}</view>
        <text class="item-icon">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="asset-section">
    <view
      wx:for="{{assetCardList}}"
      wx:key="label"
      class="asset-card"
      bindtap="goPage"
      data-url="{{item.url}}"
    >
      <text class="asset-value">{{item.count}}</text>
      <text class="asset-label">{{item.label}}</text>
    </view>
  </view>

  <view class="benefit-section">
    <view class="benefit-card">
      <text class="benefit-title">{{profileConfig.benefitTitle}}</text>
      <view class="benefit-tags" wx:if="{{benefitTagList.length}}">
        <text wx:for="{{benefitTagList}}" wx:key="index" class="benefit-tag">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view
      wx:for="{{serviceMenuList}}"
      wx:key="label"
      class="menu-item"
      bindtap="goPage"
      data-url="{{item.url}}"
    >
      <text class="menu-text">{{item.label}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{isLoggedIn}}" class="logout-section">
    <button class="logout-btn" bindtap="handleLogout">{{profileConfig.logoutText}}</button>
  </view>
</view>
