.contact-page {
  min-height: 100vh;
  background: #f3f7fd;
  padding: 24rpx;
  box-sizing: border-box;
}

.contact-card {
  width: 100%;
  padding: 40rpx 30rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(20, 69, 138, 0.07);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.contact-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(45, 143, 232, 0.22);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.contact-icon {
  font-size: 56rpx;
  color: #237bc7;
}

.contact-title {
  margin-top: 28rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #20304a;
}

.contact-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a96a8;
  text-align: center;
}

.operator-row {
  margin-top: 28rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f8fbff;
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.operator-label {
  font-size: 24rpx;
  color: #8a96a8;
  flex-shrink: 0;
}

.operator-name {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #20304a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contact-phone-row {
  margin-top: 36rpx;
  padding: 18rpx 14rpx 18rpx 20rpx;
  background: #f4f8ff;
  border-radius: 20rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 74rpx;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.contact-phone-main {
  min-width: 0;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
}

.contact-phone-label {
  font-size: 26rpx;
  color: #607089;
  flex-shrink: 0;
}

.contact-phone {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #237bc7;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.call-btn-inline {
  width: 74rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 29rpx;
  border: 1rpx solid rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  color: #237bc7;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
  box-sizing: border-box;
  text-align: center;
}

.contact-extra-list {
  margin-top: 22rpx;
  width: 100%;
  display: grid;
  gap: 14rpx;
}

.contact-extra-item {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fbfcff;
  border: 1rpx solid rgba(96, 112, 137, 0.1);
  display: grid;
  gap: 8rpx;
  box-sizing: border-box;
}

.contact-extra-label {
  font-size: 24rpx;
  color: #8a96a8;
}

.contact-extra-value {
  font-size: 26rpx;
  color: #20304a;
  line-height: 1.45;
  word-break: break-all;
}

.contact-info-list {
  margin-top: 36rpx;
  width: 100%;
}

.contact-info-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.info-dot {
  margin-top: 6rpx;
  font-size: 14rpx;
  color: #237bc7;
  flex-shrink: 0;
}

.info-text {
  font-size: 26rpx;
  color: #607089;
  line-height: 1.5;
}

.config-warning {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  border: 1rpx solid rgba(245, 158, 11, 0.22);
  width: 100%;
  box-sizing: border-box;
}

.config-warning-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #9a5b00;
}

.config-warning-fields {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.config-warning-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(245, 158, 11, 0.14);
  color: #9a5b00;
  font-size: 22rpx;
}
