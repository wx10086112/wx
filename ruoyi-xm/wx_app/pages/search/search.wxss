.search-page {
  min-height: 100vh;
  background: #f3f7fd;
  padding: 24rpx;
  box-sizing: border-box;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #fff;
  font-size: 28rpx;
}

.search-go {
  flex-shrink: 0;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1677ff 0%, #64b1ff 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.section {
  margin-bottom: 28rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(20, 69, 138, 0.05);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  color: #20304a;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.section-head .section-title {
  margin-bottom: 0;
}

.section-action {
  font-size: 24rpx;
  color: #8a96a8;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag-item {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #1677ff;
  font-size: 24rpx;
}

.tag-item.hot {
  background: #fff4ec;
  color: #ff6f23;
}

.suggest-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf2fb;
}

.suggest-row:last-child {
  border-bottom: none;
}

.suggest-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.suggest-info {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.suggest-title {
  font-size: 28rpx;
  color: #20304a;
  font-weight: 600;
}

.suggest-sub {
  font-size: 22rpx;
  color: #8a96a8;
}

.suggest-price {
  font-size: 30rpx;
  color: #ff6f23;
  font-weight: 700;
}
