.simple-page {
  min-height: 100vh;
  background: #f3f7fd;
  padding: 24rpx;
  box-sizing: border-box;
}

.simple-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
}

.search-input {
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f4f8ff;
}

.quick-list {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.quick-tag {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #1677ff;
  font-size: 24rpx;
}

.simple-title {
  display: block;
  margin-bottom: 16rpx;
  color: #20304a;
  font-size: 30rpx;
  font-weight: 600;
}

.simple-line {
  padding: 14rpx 0;
  color: #5d6f88;
  font-size: 26rpx;
  border-bottom: 1rpx solid #edf2fb;
}

.simple-line:last-child {
  border-bottom: none;
}
