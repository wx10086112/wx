.favorite-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(255, 111, 35, 0.1), transparent 30%),
    #f3f7fd;
  padding: 24rpx;
  box-sizing: border-box;
}

.favorite-header {
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ff6f23 0%, #ffab76 100%);
  box-shadow: 0 24rpx 60rpx rgba(255, 111, 35, 0.18);
}

.favorite-title {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.favorite-subtitle {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}

.favorite-list {
  margin-top: 22rpx;
}

.favorite-card {
  display: flex;
  margin-bottom: 20rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 32rpx rgba(20, 69, 138, 0.06);
}

.favorite-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.favorite-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.favorite-name {
  font-size: 30rpx;
  color: #20304a;
  font-weight: 600;
  line-height: 1.4;
}

.favorite-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a96a8;
}

.favorite-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.favorite-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff6f23;
}

.favorite-type-tag {
  font-size: 22rpx;
  color: #8a96a8;
  padding: 4rpx 14rpx;
  background: #eef1f5;
  border-radius: 999rpx;
}

.favorite-remove {
  font-size: 24rpx;
  color: #8a96a8;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #f4f7fb;
}
