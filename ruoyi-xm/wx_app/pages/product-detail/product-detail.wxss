.product-page {
  min-height: 100vh;
  background: #f3f7fd;
  padding-bottom: 120rpx;
}

.image-swiper {
  width: 100%;
  height: 560rpx;
}

.product-image-frame {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #dbe5f4;
}

.product-image {
  position: absolute;
  left: -15%;
  top: -15%;
  width: 130%;
  height: 130%;
}

.price-section,
.merchant-section,
.detail-card {
  margin: 24rpx;
  padding: 28rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(20, 69, 138, 0.07);
}

.price-row {
  display: flex;
  align-items: baseline;
}

.price {
  color: #1677ff;
  font-weight: 700;
}

.discount-tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(22, 119, 255, 0.12);
  color: #1677ff;
  font-size: 22rpx;
}

.product-title {
  display: block;
  margin-top: 18rpx;
  font-size: 34rpx;
  color: #20304a;
  font-weight: 600;
  line-height: 1.45;
}

.subtitle,
.merchant-meta,
.detail-item {
  display: block;
  margin-top: 12rpx;
  color: #71829b;
  font-size: 26rpx;
  line-height: 1.6;
}

.highlight-tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.highlight-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(22, 119, 255, 0.12);
  color: #1677ff;
  font-size: 22rpx;
}

.stats-row {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  color: #607089;
  font-size: 24rpx;
}

.merchant-section {
  display: flex;
  align-items: center;
}

.merchant-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.merchant-info {
  margin-left: 18rpx;
  flex: 1;
}

.merchant-name,
.section-title {
  font-size: 30rpx;
  color: #20304a;
  font-weight: 600;
}

.merchant-address {
  display: block;
  margin-top: 10rpx;
  color: #7c8ba1;
  font-size: 24rpx;
  line-height: 1.5;
}

.merchant-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.merchant-action {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f4f8ff;
  color: #4d6586;
  font-size: 22rpx;
}

.arrow {
  color: #a1aec0;
  font-size: 38rpx;
}

.detail-section {
  padding: 0 24rpx;
}

.store-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf2fb;
}

.store-row:last-child {
  border-bottom: none;
}

.store-name {
  display: block;
  color: #20304a;
  font-size: 28rpx;
  font-weight: 600;
}

.store-meta {
  display: block;
  margin-top: 8rpx;
  color: #7d8ea5;
  font-size: 24rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 -8rpx 30rpx rgba(14, 52, 110, 0.08);
}

.bar-left {
  display: flex;
  gap: 16rpx;
}

.bar-item {
  min-width: 86rpx;
  height: 74rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  background: #f4f8ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bar-label {
  font-size: 24rpx;
  color: #4d6586;
}

.bar-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
}

.cart-btn {
  height: 78rpx;
  line-height: 78rpx;
  padding: 0 32rpx;
  border-radius: 40rpx;
  background: #ff6f23;
  color: #fff;
  font-size: 28rpx;
  border: none;
  margin: 0;
}

.cart-btn::after {
  border: none;
}

.buy-btn {
  flex: 1;
  height: 78rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #1677ff 0%, #59a8ff 100%);
  color: #fff;
  font-size: 30rpx;
  border: none;
  margin: 0;
}

.buy-btn::after {
  border: none;
}
