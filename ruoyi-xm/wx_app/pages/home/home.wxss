.home-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 88% 6%, rgba(22, 119, 255, 0.16), transparent 30%),
    linear-gradient(180deg, #f4f8ff 0%, #f7f8fb 48%, #f3f5f8 100%);
  box-sizing: border-box;
}

.content {
  padding: 0 24rpx 28rpx;
}

.store-card {
  position: relative;
  z-index: 3;
  padding: 26rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 24rpx 68rpx rgba(20, 55, 105, 0.14);
}

.store-main {
  display: flex;
  align-items: flex-start;
}

.store-avatar {
  width: 142rpx;
  height: 142rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  box-shadow: 0 12rpx 26rpx rgba(20, 55, 105, 0.16);
}

.store-info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.store-name-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.store-name {
  flex: 1;
  color: #161d2f;
  font-size: 38rpx;
  line-height: 1.22;
  font-weight: 800;
}

.store-status {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.store-status.open {
  color: #0b9b61;
  background: rgba(11, 155, 97, 0.1);
}

.store-status.closed {
  color: #8a96a8;
  background: #eef1f5;
}

.store-rating-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  color: #7b8798;
  font-size: 23rpx;
}

.rating-badge {
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  color: #fff;
  background: #ff7629;
  font-size: 26rpx;
  font-weight: 700;
}

.rating-stars {
  color: #ff7629;
  letter-spacing: 2rpx;
  font-size: 22rpx;
}

.store-tag-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.store-tag,
.mini-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #4c6f9d;
  background: #edf5ff;
  font-size: 22rpx;
}

.store-time-row {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eef1f6;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  color: #5c6573;
  font-size: 25rpx;
}

.time-strong {
  color: #1f2a3d;
  font-weight: 700;
}

.detail-link {
  margin-left: auto;
  color: #7b8798;
}

.store-address-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.address-main {
  flex: 1;
  min-width: 0;
}

.store-address {
  display: block;
  color: #1f2a3d;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.45;
}

.distance-text {
  display: block;
  margin-top: 8rpx;
  color: #8a96a8;
  font-size: 24rpx;
}

.store-actions {
  display: flex;
  gap: 14rpx;
}

.store-action {
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  background: #f4f7fb;
  color: #20293b;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
}

.action-icon {
  margin-bottom: 4rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.search-bar {
  margin-top: 22rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  padding: 0 26rpx;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 14rpx 38rpx rgba(20, 55, 105, 0.06);
}

.search-icon {
  color: #1677ff;
  font-size: 30rpx;
}

.search-text {
  margin-left: 14rpx;
  color: #8a96a8;
  font-size: 26rpx;
}

.banner-swiper {
  margin-top: 22rpx;
  height: 214rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 42rpx rgba(20, 55, 105, 0.08);
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}

.banner-image,
.banner-mask {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.banner-mask {
  background: linear-gradient(90deg, rgba(14, 30, 56, 0.76) 0%, rgba(14, 30, 56, 0.08) 100%);
}

.banner-copy {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  right: 24rpx;
}

.banner-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
}

.store-tabs {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.store-tab {
  position: relative;
  padding: 12rpx 0 18rpx;
  color: #252d3d;
  font-size: 30rpx;
  font-weight: 650;
}

.store-tab.active {
  color: #ff6f23;
}

.store-tab.active::after {
  content: '';
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: 0;
  height: 7rpx;
  border-radius: 999rpx;
  background: #ff6f23;
}

.category-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.category-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  padding: 0 28rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #fff;
  color: #596579;
  font-size: 26rpx;
  box-shadow: 0 10rpx 24rpx rgba(20, 55, 105, 0.05);
}

.category-pill.active {
  color: #ff6f23;
  background: #fff4ee;
  box-shadow: inset 0 0 0 2rpx rgba(255, 111, 35, 0.24);
}

.sort-bar {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}

.sort-item {
  flex: 1;
  height: 68rpx;
  border-radius: 18rpx;
  background: #fff;
  color: #697589;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  box-shadow: 0 10rpx 24rpx rgba(20, 55, 105, 0.04);
}

.sort-item.active {
  color: #1677ff;
  background: #eef6ff;
  font-weight: 700;
}

.section-block {
  margin-top: 28rpx;
}

.section-title-row {
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  color: #1e2738;
  font-size: 34rpx;
  font-weight: 800;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #7e8a9b;
  font-size: 24rpx;
}

.product-section {
  padding-bottom: 18rpx;
}
