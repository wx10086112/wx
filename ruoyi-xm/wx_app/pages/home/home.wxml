<view class="home-page">
  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:else class="content">
    <view class="store-card">
      <view class="store-main">
        <image src="{{currentMerchant.avatar}}" class="store-avatar" mode="aspectFill"></image>
        <view class="store-info">
          <view class="store-name-row">
            <text class="store-name">{{currentMerchant.name}}</text>
            <view wx:if="{{currentMerchant.businessStatusText}}" class="store-status {{currentMerchant.businessStatus ? 'open' : 'closed'}}">
              {{currentMerchant.businessStatusText}}
            </view>
          </view>
          <view class="store-rating-row">
            <text class="rating-badge">{{currentMerchant.rating}}</text>
            <text class="rating-stars">★★★★★</text>
            <text>{{currentMerchant.reviewCount}}条评价</text>
            <text>月售{{currentMerchant.sales}}</text>
          </view>
          <view class="store-tag-row">
            <text wx:for="{{currentMerchant.displayTags}}" wx:key="index" class="store-tag">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="store-time-row">
        <text class="time-strong">今日 {{currentMerchant.businessHours}}</text>
        <text class="mini-tag">{{currentMerchant.bookingText}}</text>
        <text class="detail-link" bindtap="goMerchantDetail">商家详情 ›</text>
      </view>

      <view class="store-address-row">
        <view class="address-main">
          <text class="store-address">{{currentMerchant.address}}</text>
          <text class="distance-text">距您 {{currentMerchant.distance}}</text>
        </view>
        <view class="store-actions">
          <view class="store-action" catchtap="openMerchantMap">
            <text class="action-icon">⌖</text>
            <text>导航</text>
          </view>
          <view class="store-action" catchtap="callMerchant">
            <text class="action-icon">☎</text>
            <text>电话</text>
          </view>
        </view>
      </view>
    </view>

    <view class="search-bar" bindtap="onSearchTap">
      <text class="search-icon">⌕</text>
      <text class="search-text">{{brandInfo.searchPlaceholder}}</text>
    </view>

    <swiper class="banner-swiper" indicator-dots autoplay circular interval="3200">
      <swiper-item wx:for="{{bannerList}}" wx:key="id">
        <view class="banner-item" bindtap="onBannerTap" data-banner="{{item}}">
          <image src="{{item.image}}" class="banner-image" mode="aspectFill"></image>
          <view class="banner-mask"></view>
          <view class="banner-copy">
            <text class="banner-title">{{item.title}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view class="store-tabs">
      <view
        wx:for="{{storeTabs}}"
        wx:key="label"
        class="store-tab {{activeStoreTab === item.key ? 'active' : ''}}"
        bindtap="onStoreTabTap"
        data-key="{{item.key}}"
        data-type="{{item.type}}"
      >
        {{item.label}}
      </view>
    </view>

    <scroll-view class="category-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view
        wx:for="{{categoryList}}"
        wx:key="id"
        class="category-pill {{selectedCategoryId === item.id ? 'active' : ''}}"
        bindtap="onCategoryTap"
        data-id="{{item.id}}"
      >
        {{item.name}}
      </view>
    </scroll-view>

    <view class="sort-bar">
      <view
        wx:for="{{sortOptions}}"
        wx:key="value"
        class="sort-item {{sortType === item.value ? 'active' : ''}}"
        bindtap="onSortTap"
        data-sort="{{item.value}}"
      >
        {{item.label}}
      </view>
    </view>

    <view class="section-block product-section">
      <view class="section-title-row">
        <view>
          <text class="section-title">{{homeConfig.productSectionTitle}}</text>
          <text class="section-subtitle">{{homeConfig.productSectionSubtitle}}</text>
        </view>
      </view>
      <product-card
        wx:for="{{displayGrouponList}}"
        wx:key="id"
        product="{{item}}"
        bind:click="onProductTap"
        bind:buy="onProductBuy"
      ></product-card>
    </view>
  </view>
</view>
