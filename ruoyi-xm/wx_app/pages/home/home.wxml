<view class="home-page">
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-dot"></view>
    <text class="loading-text">正在加载门店服务</text>
  </view>

  <view wx:else class="content">
    <view wx:if="{{hasMerchantData}}" class="store-card">
      <view class="store-head">
        <view class="store-info" bindtap="goMerchantDetail">
          <view class="store-title-line">
            <text class="store-name">{{currentMerchant.name}}</text>
            <text class="store-arrow">›</text>
          </view>
          <view class="store-subline">
            <text class="status-pill {{currentMerchant.businessStatus ? 'open' : 'closed'}}">{{currentMerchant.businessStatusText}}</text>
            <block wx:if="{{currentMerchant.distance}}">
              <text>{{currentMerchant.distance}}</text>
            </block>
          </view>
        </view>
      </view>

      <view class="store-tags">
        <text wx:for="{{currentMerchant.displayTags}}" wx:key="index" class="store-tag">{{item}}</text>
        <text wx:if="{{currentMerchant.bookingText}}" class="store-tag highlight">{{currentMerchant.bookingText}}</text>
      </view>

      <view class="store-address" bindtap="goMerchantDetail">
        <view class="pin-icon"></view>
        <text class="store-address-text">{{currentMerchant.address}}</text>
      </view>

      <view class="store-actions">
        <view class="action-btn" catchtap="callMerchant">
          <view class="phone-icon"></view>
          <text>联系门店</text>
        </view>
        <view class="action-btn primary" catchtap="openMerchantMap">
          <view class="nav-icon"></view>
          <text>一键导航</text>
        </view>
      </view>
    </view>

    <view wx:else class="store-empty-card">
      <text class="store-empty-title">暂未获取门店信息</text>
      <text class="store-empty-desc">请先完成商户配置，或稍后刷新重试</text>
    </view>

    <view class="section-head">
      <text class="section-title">团购优惠</text>
      <view class="section-actions">
        <text class="section-count">{{displayGrouponList.length}} 项</text>
        <text class="cart-link" bindtap="goCart">购物车</text>
      </view>
    </view>

    <view wx:if="{{displayGrouponList.length}}" class="service-list">
      <product-card
        wx:for="{{displayGrouponList}}"
        wx:key="id"
        product="{{item}}"
        bind:click="onProductTap"
        bind:buy="onProductBuy"
      ></product-card>
    </view>

    <view wx:else class="empty-card">
      <text class="empty-title">暂无上架服务</text>
      <text class="empty-desc">门店服务正在整理中，请稍后再来看看</text>
    </view>
  </view>

  <view class="floating-cart-btn" wx:if="{{!loading}}" bindtap="goCart">
    <text class="floating-cart-text">购物车</text>
  </view>
</view>
