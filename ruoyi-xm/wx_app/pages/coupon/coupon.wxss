.coupon-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(255, 111, 35, 0.12), transparent 30%),
    #f3f7fd;
  padding: 24rpx;
  box-sizing: border-box;
}

.coupon-header {
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ff6f23 0%, #ffab76 100%);
  box-shadow: 0 24rpx 60rpx rgba(255, 111, 35, 0.18);
}

.coupon-title {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.coupon-subtitle {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}

.coupon-tabs {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.coupon-tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.85);
  color: #607089;
  font-size: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(20, 69, 138, 0.04);
}

.coupon-tab.active {
  background: linear-gradient(135deg, #ff6f23 0%, #ffab76 100%);
  color: #fff;
  font-weight: 600;
}

.coupon-list {
  margin-top: 22rpx;
}

.coupon-card {
  display: flex;
  align-items: stretch;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: #fff;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(20, 69, 138, 0.06);
}

.coupon-disabled {
  opacity: 0.55;
}

.coupon-left {
  width: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 20rpx;
  background: linear-gradient(135deg, rgba(255, 111, 35, 0.08) 0%, rgba(255, 171, 118, 0.12) 100%);
}

.coupon-amount {
  font-size: 52rpx;
  font-weight: 700;
  color: #ff6f23;
}

.coupon-threshold {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a7060;
}

.coupon-divider {
  width: 1rpx;
  background: repeating-linear-gradient(
    to bottom,
    #e8e0d8 0,
    #e8e0d8 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
}

.coupon-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 28rpx 24rpx;
}

.coupon-name {
  font-size: 28rpx;
  color: #20304a;
  font-weight: 600;
}

.coupon-valid {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a96a8;
}

.coupon-use-btn {
  margin-top: 16rpx;
  align-self: flex-start;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff6f23 0%, #ffab76 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.coupon-status-tag {
  margin-top: 16rpx;
  align-self: flex-start;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #eef1f5;
  color: #8a96a8;
  font-size: 22rpx;
}
