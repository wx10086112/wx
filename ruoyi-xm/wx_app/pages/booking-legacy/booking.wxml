<view class="booking-page">
  <view class="page-hero">
    <view>
      <text class="eyebrow">门店服务</text>
      <text class="page-title">预点单到店</text>
    </view>
  </view>

  <view class="intro-card">
    <text class="intro-title">选择预点单服务</text>
    <text class="intro-desc">选择需要的服务项目，填写到店时间和联系方式，门店确认后即可按时到店。</text>
  </view>

  <view wx:if="{{loading}}" class="loading-card">
    <view class="loading-dot"></view>
    <text class="loading-text">正在加载服务</text>
  </view>

  <view wx:elif="{{serviceList.length}}" class="service-list">
    <view wx:for="{{serviceList}}" wx:key="serviceId" class="service-card">
      <image class="service-image" src="{{item.image}}" mode="aspectFill"></image>
      <view class="service-main">
        <text class="service-title">{{item.title}}</text>
        <text class="service-subtitle">{{item.subtitle}}</text>
        <view class="service-footer">
          <text wx:if="{{item.priceText}}" class="service-price">参考价 ¥{{item.priceText}}</text>
          <view
            class="book-btn {{item.unavailable ? 'disabled' : ''}}"
            bindtap="openBookingSheet"
            data-index="{{index}}"
          >
            {{item.unavailable ? '暂不可点单' : '预点单'}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty-card">
    <view class="empty-badge">预点单</view>
    <text class="empty-title">暂无可预点单服务</text>
    <text class="empty-desc">门店上架服务后，会展示在这里</text>
  </view>

  <view wx:if="{{showBookingSheet}}" class="sheet-mask" catchtap="closeBookingSheet">
    <view class="booking-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title-row">
        <text class="sheet-title">提交预点单</text>
        <text class="sheet-close" bindtap="closeBookingSheet">×</text>
      </view>
      <view class="sheet-product">
        <image class="sheet-product-image" src="{{selectedService.image}}" mode="aspectFill"></image>
        <view class="sheet-product-info">
          <text class="sheet-product-title">{{selectedService.title}}</text>
          <text class="sheet-product-price">等待门店确认</text>
        </view>
      </view>

      <view class="form-card">
        <view class="form-row">
          <text class="form-label">预点单日期</text>
          <picker mode="date" value="{{form.bookingDate}}" start="{{minBookingDate}}" bindchange="onDateChange">
            <view class="form-value">{{form.bookingDate}}</view>
          </picker>
        </view>
        <view class="form-row">
          <text class="form-label">到店时间</text>
          <picker mode="time" value="{{form.bookingClock}}" bindchange="onTimeChange">
            <view class="form-value">{{form.bookingClock}}</view>
          </picker>
        </view>
        <view class="form-row">
          <text class="form-label">联系人</text>
          <input class="form-input" value="{{form.contactName}}" data-field="contactName" bindinput="onInputChange" placeholder="请输入姓名" />
        </view>
        <view class="form-row">
          <text class="form-label">联系电话</text>
          <input class="form-input" type="number" value="{{form.contactPhone}}" data-field="contactPhone" bindinput="onInputChange" placeholder="请输入手机号" />
        </view>
        <view class="form-row">
          <text class="form-label">预点单人数</text>
          <input class="form-input" type="number" value="{{form.peopleCount}}" data-field="peopleCount" bindinput="onInputChange" placeholder="1" />
        </view>
        <textarea class="remark-input" value="{{form.remark}}" data-field="remark" bindinput="onInputChange" placeholder="备注，可填写到店需求"></textarea>
      </view>

      <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submitBooking">
        {{submitting ? '提交中...' : '确认预点单'}}
      </view>
    </view>
  </view>
</view>
