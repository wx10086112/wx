.order-detail-page {
  min-height: 100vh;
  background: #f3f7fd;
  padding-bottom: 150rpx;
}

.status-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx 0;
  background: linear-gradient(135deg, #1677ff 0%, #64b1ff 100%);
}

.status-section.PAID_UNUSED-bg {
  background: linear-gradient(135deg, #1677ff 0%, #64b1ff 100%);
}

.status-section.USED_COMPLETED-bg {
  background: linear-gradient(135deg, #18a058 0%, #58c68c 100%);
}

.status-section.PENDING_PAY-bg {
  background: linear-gradient(135deg, #ff9f1a 0%, #ffc057 100%);
}

.status-section.REFUNDING-bg,
.status-section.REFUNDED-bg,
.status-section.CANCELLED-bg,
.status-section.CLOSED-bg {
  background: linear-gradient(135deg, #8898af 0%, #a5b2c3 100%);
}

.status-icon {
  font-size: 80rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 14rpx;
}

.status-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
  margin-top: 12rpx;
}

.write-off-card,
.product-card,
.order-info-card,
.price-info-card,
.history-card {
  margin: 24rpx;
  padding: 28rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(20, 69, 138, 0.07);
}

.card-title,
.product-title,
.total-price {
  color: #20304a;
}

.item-count-text {
  flex-shrink: 0;
  color: #72839a;
  font-size: 24rpx;
}

.code-display {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 32rpx;
  padding: 30rpx 22rpx;
  background: linear-gradient(135deg, #1677ff 0%, #59a8ff 100%);
  border-radius: 18rpx;
  min-height: 104rpx;
  box-sizing: border-box;
}

.code-group {
  min-width: 118rpx;
  margin: 7rpx 9rpx;
  text-align: center;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  font-family: DIN Alternate, SFMono-Regular, Consolas, monospace;
}

.qr-section {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 28rpx;
  padding: 30rpx;
  background: #f7fbff;
  border-radius: 18rpx;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: #dbeefa;
}

.product-merchant,
.info-label,
.price-label {
  color: #7a8aa0;
}

.order-product-list {
  margin-top: 20rpx;
}

.order-product-item {
  display: flex;
  gap: 20rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(20, 54, 91, 0.08);
}

.order-product-item:first-child {
  border-top: none;
  padding-top: 0;
}

.order-product-item:last-child {
  padding-bottom: 0;
}

.product-text {
  flex: 1;
  min-width: 0;
}

.product-price-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.item-price {
  color: #237bc7;
  font-size: 32rpx;
  font-weight: 760;
}

.item-quantity,
.item-subtotal {
  color: #72839a;
  font-size: 24rpx;
}

.item-subtotal {
  display: block;
  margin-top: 8rpx;
  text-align: right;
}

.info-item:last-child {
  border-bottom: none;
}

.history-timeline {
  padding-left: 8rpx;
}

.history-item {
  display: flex;
  gap: 18rpx;
  padding-bottom: 28rpx;
  position: relative;
}

.history-item::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 30rpx;
  bottom: 0;
  width: 2rpx;
  background: rgba(20, 54, 91, 0.1);
}

.history-item:last-child::before {
  display: none;
}

.history-item:last-child {
  padding-bottom: 0;
}

.history-dot {
  flex-shrink: 0;
  width: 22rpx;
  height: 22rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: #2d8fe8;
  position: relative;
  z-index: 1;
}

.history-item.done .history-dot {
  background: #18a058;
}

.history-item.failed .history-dot {
  background: #d94b4b;
}

.history-content {
  flex: 1;
}

.history-label {
  display: block;
  color: #20304a;
  font-size: 27rpx;
  font-weight: 680;
}

.history-time,
.history-extra {
  display: block;
  margin-top: 6rpx;
  color: #7a8aa0;
  font-size: 24rpx;
  line-height: 1.5;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(18rpx);
  min-height: 118rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 30rpx rgba(14, 52, 110, 0.08);
  box-sizing: border-box;
}

.bar-actions {
  display: flex;
  flex: 1;
  min-width: 0;
  gap: 18rpx;
}

.bar-actions.is-pair .action-btn {
  flex: 1;
  min-width: 0;
}

.bar-actions.is-single {
  justify-content: flex-end;
}

.bar-actions.is-single .action-btn {
  width: 320rpx;
}

.action-btn {
  flex-shrink: 1;
  height: 72rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
  font-size: 27rpx;
  font-weight: 680;
  margin: 0;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  white-space: nowrap;
  max-width: 100%;
}

.action-btn::after {
  border: none;
}

.action-btn-outline {
  background: rgba(255, 255, 255, 0.58);
  border-color: rgba(148, 163, 184, 0.18);
  color: #475467;
}

.action-btn-primary {
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  border-color: rgba(45, 143, 232, 0.24);
  color: #2d8fe8;
}

.action-btn:active {
  opacity: 0.9;
  transform: translateY(1rpx) scale(0.985);
}
