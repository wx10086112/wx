.result-page {
  min-height: 100vh;
  background: #f3f7fd;
  padding: 24rpx;
  box-sizing: border-box;
}

.result-header {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.result-keyword {
  font-size: 32rpx;
  font-weight: 700;
  color: #20304a;
}

.result-count {
  font-size: 24rpx;
  color: #8a96a8;
}

.sort-bar {
  display: flex;
  gap: 0;
  margin-bottom: 22rpx;
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(20, 69, 138, 0.05);
}

.sort-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #607089;
  gap: 4rpx;
}

.sort-item.active {
  color: #1677ff;
  font-weight: 600;
}

.sort-arrow {
  font-size: 22rpx;
}

.section {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(20, 69, 138, 0.05);
}

.section-title {
  display: block;
  font-size: 28rpx;
  color: #20304a;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.merchant-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf2fb;
}

.merchant-row:last-child {
  border-bottom: none;
}

.merchant-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.merchant-info {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.merchant-name {
  font-size: 28rpx;
  color: #20304a;
  font-weight: 600;
}

.merchant-meta {
  font-size: 22rpx;
  color: #8a96a8;
}

.merchant-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-top: 6rpx;
}

.merchant-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #edf5ff;
  color: #4c6f9d;
  font-size: 20rpx;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}
