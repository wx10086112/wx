.page-shell {
  min-height: 100vh;
  padding: 28rpx 28rpx 160rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 42%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.page-head {
  padding: 10rpx 6rpx 22rpx;
}

.page-title {
  display: block;
  color: #111827;
  font-size: 40rpx;
  font-weight: 820;
  line-height: 1.25;
}

.panel {
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.76)),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
}

.scan-card {
  min-height: 172rpx;
  padding: 30rpx;
  border-radius: 38rpx;
  border: 1rpx solid rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(231, 244, 255, 0.9)),
    #e7f4ff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8), 0 14rpx 34rpx rgba(34, 73, 116, 0.08);
  display: flex;
  align-items: center;
  gap: 24rpx;
  overflow: hidden;
  position: relative;
}

.scan-card::after {
  content: "";
  position: absolute;
  right: -70rpx;
  top: -82rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  background: rgba(45, 143, 232, 0.08);
}

.scan-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.68);
  border: 1rpx solid rgba(45, 143, 232, 0.12);
  position: relative;
  flex-shrink: 0;
}

.scan-corner {
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  border-color: #f9d978;
}

.corner-tl {
  left: 18rpx;
  top: 18rpx;
  border-left: 5rpx solid #f9d978;
  border-top: 5rpx solid #f9d978;
  border-radius: 8rpx 0 0 0;
}

.corner-tr {
  right: 18rpx;
  top: 18rpx;
  border-right: 5rpx solid #f9d978;
  border-top: 5rpx solid #f9d978;
  border-radius: 0 8rpx 0 0;
}

.corner-bl {
  left: 18rpx;
  bottom: 18rpx;
  border-left: 5rpx solid #f9d978;
  border-bottom: 5rpx solid #f9d978;
  border-radius: 0 0 0 8rpx;
}

.corner-br {
  right: 18rpx;
  bottom: 18rpx;
  border-right: 5rpx solid #f9d978;
  border-bottom: 5rpx solid #f9d978;
  border-radius: 0 0 8rpx 0;
}

.scan-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.scan-title {
  display: block;
  color: #111827;
  font-size: 34rpx;
  font-weight: 820;
  line-height: 1.25;
}

.scan-desc {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
}

.scan-arrow {
  color: #2d8fe8;
  font-size: 52rpx;
  line-height: 1;
  position: relative;
  z-index: 1;
}

.input-panel,
.result-panel,
.recent-panel {
  margin-top: 22rpx;
  padding: 28rpx;
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 760;
  line-height: 1.3;
}

.head-link {
  color: #237bc7;
  font-size: 24rpx;
}

.code-input {
  width: 100%;
  height: 92rpx;
  margin-top: 22rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  background: #f1f7fd;
  color: #111827;
  font-size: 28rpx;
}

.manual-btn {
  width: 100%;
  margin-top: 18rpx;
  color: #237bc7;
}

.result-title {
  display: block;
  margin-top: 18rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.result-meta,
.recent-meta,
.recent-code {
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
}

.recent-row {
  margin-top: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(20, 54, 91, 0.08);
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.recent-row:last-child {
  border-bottom: none;
}

.recent-main {
  flex: 1;
  min-width: 0;
}

.recent-title {
  display: block;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.recent-side {
  text-align: right;
  flex-shrink: 0;
}

.recent-amount {
  color: #111827;
  font-size: 28rpx;
  font-weight: 760;
}

.recent-amount.failed,
.recent-error {
  color: #d94b4b;
}

.recent-error {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
}

.empty-inline {
  padding: 48rpx 0 12rpx;
  text-align: center;
}

.empty-text {
  color: #667085;
  font-size: 26rpx;
}
