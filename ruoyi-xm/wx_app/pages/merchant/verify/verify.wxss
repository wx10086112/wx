.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  background: #faf8f3;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border-radius: 36rpx;
  border: 1px solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 18rpx 48rpx rgba(32, 28, 22, 0.06);
  box-sizing: border-box;
}

.primary-btn,
.ghost-btn {
  height: 72rpx;
  margin: 0;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.primary-btn {
  background: #1d1d1f;
  color: #ffffff;
}

.ghost-btn {
  background: #f7f5f0;
  color: #3a3a3c;
  border: 1px solid #e8e5de;
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.verify-hero,
.input-panel,
.result-panel,
.recent-panel {
  padding: 28rpx;
}

.verify-hero {
  background: #1d1d1f;
  color: #f7f5f0;
}

.input-panel,
.result-panel,
.recent-panel {
  margin-top: 20rpx;
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.head-link {
  font-size: 24rpx;
  color: #8b6a32;
}

.hint-order {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #faf8f3;
}

.hint-title,
.result-title {
  display: block;
  font-size: 30rpx;
  color: #1d1d1f;
  font-weight: 600;
}

.hint-meta,
.result-meta,
.recent-meta,
.recent-code {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.code-input {
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #faf8f3;
  font-size: 28rpx;
}

.action-row {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}

.half-btn {
  flex: 1;
}

.recent-row {
  margin-top: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #efeae0;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.recent-row:last-child {
  border-bottom: none;
}

.recent-main {
  flex: 1;
}

.recent-title {
  display: block;
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 600;
}

.recent-side {
  text-align: right;
}

.recent-amount {
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 600;
}

.recent-amount.failed,
.recent-error {
  color: #a3482f;
}

.recent-error {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
}

.empty-inline {
  padding: 48rpx 0 12rpx;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: #8a8a8e;
}

.merchant-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 108rpx;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 0;
  padding: 8rpx 18rpx calc(8rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid #f3efe6;
  box-sizing: border-box;
  z-index: 90;
}

.merchant-tabbar__item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
}

.merchant-tabbar__label {
  font-size: 22rpx;
  color: #9a9a9e;
  font-weight: 500;
}

.merchant-tabbar__item.active .merchant-tabbar__label {
  color: #c8a46a;
  font-weight: 600;
}
