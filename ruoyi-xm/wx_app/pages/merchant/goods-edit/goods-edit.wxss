.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  background: #faf8f3;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border-radius: 36rpx;
  border: 1px solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 18rpx 48rpx rgba(32, 28, 22, 0.06);
  box-sizing: border-box;
}

.primary-btn {
  height: 88rpx;
  margin: 0;
  padding: 0 28rpx;
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1d1d1f;
  color: #ffffff;
}

.primary-btn::after {
  border: none;
}

.form-panel {
  padding: 28rpx;
}

.image-uploader {
  width: 100%;
  height: 360rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #f3efe6;
}

.image-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8b6a32;
}

.image-plus {
  font-size: 64rpx;
  line-height: 1;
}

.image-tip {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.image-subtip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.image-editor {
  padding: 22rpx;
  border-radius: 28rpx;
  background: #faf8f3;
  border: 1px solid #eee7db;
}

.image-editor-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.image-editor-title {
  display: block;
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 700;
}

.image-change-btn {
  flex-shrink: 0;
  width: 116rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #3a3a3c;
  background: #f7f5f0;
  font-size: 24rpx;
  font-weight: 700;
}

.image-change-btn::after {
  border: none;
}

.crop-frame {
  position: relative;
  margin-top: 20rpx;
  width: 100%;
  height: 350rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #0f172a;
  touch-action: none;
}

.crop-image {
  position: absolute;
  left: -15%;
  top: -15%;
  width: 130%;
  height: 130%;
  will-change: transform;
}

.crop-grid {
  pointer-events: none;
  position: absolute;
  inset: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.82);
  box-sizing: border-box;
}

.grid-line {
  position: absolute;
  background: rgba(255, 255, 255, 0.48);
}

.grid-line.vertical {
  top: 0;
  bottom: 0;
  width: 1rpx;
}

.grid-line.vertical.left {
  left: 33.333%;
}

.grid-line.vertical.right {
  left: 66.666%;
}

.grid-line.horizontal {
  left: 0;
  right: 0;
  height: 1rpx;
}

.grid-line.horizontal.top {
  top: 33.333%;
}

.grid-line.horizontal.bottom {
  top: 66.666%;
}

.crop-toolbar {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.scale-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.scale-label {
  flex-shrink: 0;
  color: #746f66;
  font-size: 24rpx;
  font-weight: 600;
}

.scale-slider {
  flex: 1;
}

.crop-actions {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.crop-action-btn {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #3a3a3c;
  background: #f7f5f0;
  font-size: 24rpx;
  font-weight: 600;
}

.crop-action-btn.reset {
  color: #8b6a32;
}

.crop-action-btn::after {
  border: none;
}

.field {
  margin-top: 20rpx;
}

.field:first-child {
  margin-top: 0;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #8a8a8e;
}

.field-input,
.field-textarea {
  margin-top: 12rpx;
  width: 100%;
  border-radius: 24rpx;
  background: #faf8f3;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1d1d1f;
}

.field-input {
  height: 84rpx;
}

.field-textarea {
  min-height: 180rpx;
  padding-top: 18rpx;
}

.two-col {
  display: flex;
  gap: 14rpx;
}

.field-half {
  flex: 1;
}

.switch-row {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.save-btn {
  margin-top: 30rpx;
}
