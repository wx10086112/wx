.form-panel {
  padding: 28rpx;
}

.image-uploader {
  width: 100%;
  height: 360rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #f6f9ff;
}

.image-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #1f6feb;
}

.image-plus {
  font-size: 64rpx;
  line-height: 1;
}

.image-tip {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.image-subtip {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7a8798;
}

.image-editor {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 2rpx solid #e5edf8;
}

.image-editor-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.image-editor-title {
  display: block;
  color: #1f2a37;
  font-size: 30rpx;
  font-weight: 700;
}

.image-change-btn {
  flex-shrink: 0;
  width: 116rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #1f6feb;
  background: #eaf2ff;
  font-size: 24rpx;
  font-weight: 700;
}

.image-change-btn::after {
  border: none;
}

.crop-frame {
  position: relative;
  margin-top: 20rpx;
  width: 100%;
  height: 350rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #0f172a;
  touch-action: none;
}

.crop-image {
  position: absolute;
  left: -15%;
  top: -15%;
  width: 130%;
  height: 130%;
  will-change: transform;
}

.crop-grid {
  pointer-events: none;
  position: absolute;
  inset: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.82);
  box-sizing: border-box;
}

.grid-line {
  position: absolute;
  background: rgba(255, 255, 255, 0.48);
}

.grid-line.vertical {
  top: 0;
  bottom: 0;
  width: 1rpx;
}

.grid-line.vertical.left {
  left: 33.333%;
}

.grid-line.vertical.right {
  left: 66.666%;
}

.grid-line.horizontal {
  left: 0;
  right: 0;
  height: 1rpx;
}

.grid-line.horizontal.top {
  top: 33.333%;
}

.grid-line.horizontal.bottom {
  top: 66.666%;
}

.crop-toolbar {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.scale-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.scale-label {
  flex-shrink: 0;
  color: #516170;
  font-size: 24rpx;
  font-weight: 600;
}

.scale-slider {
  flex: 1;
}

.crop-actions {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.crop-action-btn {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  color: #334155;
  background: #eef4ff;
  font-size: 24rpx;
  font-weight: 600;
}

.crop-action-btn.reset {
  color: #1f6feb;
}

.crop-action-btn::after {
  border: none;
}

.field {
  margin-top: 20rpx;
}

.field:first-child {
  margin-top: 0;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #7a8798;
}

.field-input,
.field-textarea {
  margin-top: 12rpx;
  width: 100%;
  border-radius: 16rpx;
  background: #f6f9ff;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1f2a37;
}

.field-input {
  height: 84rpx;
}

.field-textarea {
  min-height: 180rpx;
  padding-top: 18rpx;
}

.two-col {
  display: flex;
  gap: 14rpx;
}

.field-half {
  flex: 1;
}

.switch-row {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.save-btn {
  margin-top: 30rpx;
}
