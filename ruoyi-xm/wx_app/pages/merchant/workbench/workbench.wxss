.hero-card {
  padding: 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #1f6feb 0%, #3b82f6 100%);
  box-shadow: 0 14rpx 34rpx rgba(31, 111, 235, 0.16);
}

.hero-top,
.hero-sales-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.hero-store {
  display: block;
  max-width: 460rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-role {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
}

.hero-sales-row {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}

.hero-sales-main {
  flex: 1;
  min-width: 0;
}

.hero-sales-label {
  display: block;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.hero-sales-value {
  display: block;
  margin-top: 4rpx;
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.15;
}

.hero-switch {
  width: 158rpx;
  flex-shrink: 0;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0 22rpx;
  border-radius: 999rpx;
  border: none;
  color: #1f6feb;
  background: rgba(255, 255, 255, 0.92);
  font-size: 23rpx;
  font-weight: 600;
  margin: 0;
}

.hero-switch::after {
  border: none;
}

.alert-section {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.alert-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
}

.alert-item.urgent {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
}

.alert-item.warning {
  background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
}

.alert-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.alert-text {
  flex: 1;
  font-size: 23rpx;
  color: #92400e;
  font-weight: 600;
}

.alert-item.warning .alert-text {
  color: #991b1b;
}

.alert-arrow {
  font-size: 28rpx;
  color: #92400e;
  flex-shrink: 0;
}

.stats-grid {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}

.stats-card {
  min-height: 102rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  box-sizing: border-box;
}

.stats-card.highlight {
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  border: 2rpx solid #93c5fd;
}

.stats-card.warn {
  background: linear-gradient(135deg, #fefce8 0%, #fef9c3 100%);
  border: 2rpx solid #fde047;
}

.stats-value {
  display: block;
  font-size: 32rpx;
  color: #1f2a37;
  font-weight: 700;
  line-height: 1.15;
}

.stats-card.highlight .stats-value {
  color: #1f6feb;
}

.stats-card.warn .stats-value {
  color: #d97706;
}

.stats-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #7a8798;
  line-height: 1.2;
}

.section {
  margin-top: 14rpx;
  padding: 22rpx;
}

.quick-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}

.quick-item {
  min-height: 100rpx;
  padding: 14rpx 8rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f6f9ff;
  box-sizing: border-box;
}

.quick-icon {
  font-size: 34rpx;
  line-height: 1;
}

.quick-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #304256;
  font-weight: 600;
  line-height: 1.2;
}

.pending-row {
  margin-top: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf1f5;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.pending-row:last-child {
  border-bottom: none;
}

.pending-main {
  flex: 1;
  min-width: 0;
}

.pending-title {
  display: block;
  font-size: 27rpx;
  color: #1f2a37;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pending-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #7a8798;
}

.pending-side {
  text-align: right;
  flex-shrink: 0;
}

.pending-price {
  display: block;
  font-size: 27rpx;
  color: #1f6feb;
  font-weight: 600;
}

.pending-code {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7a8798;
}

.mini-tag {
  font-size: 20rpx;
  margin-top: 6rpx;
  padding: 4rpx 10rpx;
}

.empty-inline {
  padding: 36rpx 0 12rpx;
  text-align: center;
}
