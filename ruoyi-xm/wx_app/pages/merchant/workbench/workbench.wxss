.page-shell {
  min-height: 100vh;
  padding: 32rpx 32rpx 168rpx;
  background: #f7f5f0;
  box-sizing: border-box;
}

.panel {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 40rpx;
  border: 1rpx solid rgba(230, 225, 216, 0.82);
  box-shadow: 0 18rpx 42rpx rgba(35, 31, 25, 0.06);
  box-sizing: border-box;
}

.interactive-card {
  transition: transform 160ms ease, opacity 160ms ease;
}

.card-pressed {
  opacity: 0.88;
  transform: scale(0.985);
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.status-tag.blue {
  background: #f3efe6;
  color: #8b6a32;
}

.status-tag.green {
  background: #e8f5ec;
  color: #2e7d32;
}

.status-tag.orange {
  background: #fff4de;
  color: #9b6428;
}

.status-tag.gray {
  background: #f1f0ec;
  color: #77736d;
}

.hero-card {
  padding: 34rpx;
  border-radius: 44rpx;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.hero-identity {
  min-width: 0;
  flex: 1;
}

.hero-store {
  display: block;
  color: #1d1d1f;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-role {
  display: block;
  margin-top: 10rpx;
  color: #2c2c2e;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.25;
}

.hero-shop {
  display: block;
  max-width: 480rpx;
  margin-top: 8rpx;
  color: #8a8a8e;
  font-size: 24rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-sales-card {
  min-height: 196rpx;
  margin-top: 28rpx;
  padding: 30rpx 30rpx;
  border-radius: 36rpx;
  background: linear-gradient(145deg, #1c1c1e 0%, #2b2a27 100%);
  box-shadow: 0 22rpx 46rpx rgba(28, 28, 30, 0.16);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}

.hero-sales-card::after {
  content: '';
  position: absolute;
  right: -64rpx;
  top: -70rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(201, 164, 106, 0.13);
}

.hero-sales-main {
  min-width: 0;
  flex: 1;
  position: relative;
  z-index: 1;
}

.hero-sales-label {
  display: block;
  color: rgba(235, 231, 224, 0.72);
  font-size: 24rpx;
  line-height: 1.3;
}

.hero-sales-value {
  display: block;
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 76rpx;
  font-weight: 800;
  line-height: 1.06;
  letter-spacing: -2rpx;
}

.hero-switch {
  width: 168rpx;
  height: 64rpx;
  flex-shrink: 0;
  margin: 0;
  padding: 0 20rpx;
  border: none;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #1d1d1f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
  position: relative;
  z-index: 1;
}

.hero-switch::after {
  border: none;
}

.alert-section {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.alert-item {
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
}

.alert-item.urgent,
.alert-item.warning {
  background: #fff6e5;
  border: 1rpx solid rgba(232, 190, 108, 0.28);
}

.alert-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #c4873e;
  box-shadow: 0 0 0 8rpx rgba(196, 135, 62, 0.12);
  flex-shrink: 0;
}

.alert-text {
  flex: 1;
  color: #8a5a16;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
}

.alert-arrow {
  color: #8a5a16;
  font-size: 34rpx;
  line-height: 1;
  flex-shrink: 0;
}

.stats-grid {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.stats-card {
  min-height: 216rpx;
  padding: 28rpx;
}

.stats-card.highlight {
  background: #fffaf0;
  border-color: rgba(201, 164, 106, 0.36);
}

.stats-card.warn {
  background: #fff8ef;
  border-color: rgba(196, 135, 62, 0.28);
}

.stats-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stats-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #9b968f;
}

.stats-dot.gold {
  background: #b88746;
}

.stats-dot.green {
  background: #4f8f63;
}

.stats-dot.orange {
  background: #c4873e;
}

.stats-dot.dark {
  background: #1c1c1e;
}

.stats-label {
  color: #8a8a8e;
  font-size: 26rpx;
  line-height: 1;
}

.stats-value {
  display: block;
  margin-top: 28rpx;
  color: #1d1d1f;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -1rpx;
}

.stats-card.highlight .stats-value {
  color: #8a5a16;
}

.stats-card.warn .stats-value {
  color: #9b6428;
}

.stats-caption {
  display: block;
  margin-top: 14rpx;
  color: #aaa49b;
  font-size: 23rpx;
  line-height: 1.25;
}

.section {
  margin-top: 28rpx;
  padding: 34rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.section-subtitle {
  color: #9b968f;
  font-size: 24rpx;
  line-height: 1.25;
  white-space: nowrap;
}

.quick-grid {
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.quick-item {
  min-height: 164rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  background: #faf8f3;
  border: 1rpx solid #eee8dd;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.quick-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0ede7;
  color: #2c2c2e;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
  flex-shrink: 0;
}

.quick-icon.gold {
  color: #8a5a16;
  background: #fff2d8;
}

.quick-icon.orange {
  color: #9b6428;
  background: #fff0dc;
}

.quick-icon.dark {
  color: #2c2c2e;
  background: #efede8;
}

.quick-label {
  color: #2c2c2e;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.25;
}

.pending-row {
  margin-top: 22rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #eee9df;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.pending-main {
  flex: 1;
  min-width: 0;
}

.pending-title {
  display: block;
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pending-meta {
  display: block;
  margin-top: 8rpx;
  color: #8f8a83;
  font-size: 24rpx;
  line-height: 1.45;
}

.pending-side {
  min-width: 150rpx;
  text-align: right;
  flex-shrink: 0;
}

.pending-price {
  display: block;
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
}

.pending-code {
  display: block;
  margin-top: 8rpx;
  color: #8f8a83;
  font-size: 22rpx;
}

.mini-tag {
  margin-top: 8rpx;
  padding: 8rpx 12rpx;
  font-size: 20rpx;
}

.empty-inline {
  padding: 48rpx 0 14rpx;
  text-align: center;
}

.empty-text {
  color: #8f8a83;
  font-size: 24rpx;
}

.merchant-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 112rpx;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 0;
  padding: 10rpx 18rpx calc(10rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  border-top: 1rpx solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 -12rpx 36rpx rgba(35, 31, 25, 0.05);
  backdrop-filter: blur(18px);
  box-sizing: border-box;
  z-index: 90;
}

.merchant-tabbar__item {
  min-height: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.merchant-tabbar__icon {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #d0cbc2;
}

.merchant-tabbar__label {
  color: #9a9a9e;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.merchant-tabbar__item.active .merchant-tabbar__icon {
  width: 34rpx;
  border-radius: 999rpx;
  background: #b88746;
}

.merchant-tabbar__item.active .merchant-tabbar__label {
  color: #a9783a;
  font-weight: 800;
}
