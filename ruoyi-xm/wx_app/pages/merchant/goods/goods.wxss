.goods-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  background: #faf8f3;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border-radius: 32rpx;
  border: 1px solid rgba(232, 229, 222, 0.92);
  box-shadow: 0 16rpx 40rpx rgba(32, 28, 22, 0.06);
  box-sizing: border-box;
}

.goods-filter {
  padding: 10rpx;
  display: flex;
  gap: 12rpx;
}

.goods-filter__item {
  flex: 1;
  height: 68rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8a8e;
  font-size: 24rpx;
  font-weight: 500;
}

.goods-filter__item.is-active {
  background: #1d1d1f;
  color: #ffffff;
  font-weight: 600;
}

.goods-content {
  margin-top: 18rpx;
}

.goods-toolbar {
  display: flex;
  justify-content: flex-end;
}

.goods-toolbar__actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.goods-tool {
  min-width: 148rpx;
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1;
}

.goods-tool--dark {
  background: #1d1d1f;
  color: #ffffff;
}

.goods-tool--light {
  background: #f7f5f0;
  border: 1px solid #e8e5de;
  color: #5f5950;
}

.goods-batch {
  margin-top: 16rpx;
  padding: 24rpx;
  background: #fff8ec;
  border-color: #ecd5ae;
}

.goods-batch__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.goods-batch__info {
  flex: 1;
  min-width: 0;
}

.goods-batch__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.goods-batch__count {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8a8a8e;
}

.goods-batch__toggle {
  min-width: 148rpx;
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 1px solid #ecd5ae;
  color: #8b6a32;
  font-size: 23rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.goods-batch__actions {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.goods-batch__action {
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #1d1d1f;
  font-size: 24rpx;
  font-weight: 600;
  border: 1px solid #e8e5de;
}

.goods-batch__action--warn {
  color: #8b6a32;
  background: #fff4de;
  border-color: #f1ddbb;
}

.goods-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 18rpx;
}

.goods-card {
  padding: 28rpx;
  display: flex;
  gap: 18rpx;
}

.goods-card__checkbox {
  width: 52rpx;
  padding-top: 56rpx;
  display: flex;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.goods-card__checkbox-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  border: 3rpx solid #d8d2c7;
  background: #ffffff;
  box-sizing: border-box;
}

.goods-card__checkbox-icon.is-checked {
  background: #1d1d1f;
  border-color: #1d1d1f;
}

.goods-card__main {
  flex: 1;
  min-width: 0;
}

.goods-card__cover {
  position: relative;
  height: 228rpx;
  margin-bottom: 22rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background: #f3efe6;
}

.goods-card__cover-image {
  position: absolute;
  left: -15%;
  top: -15%;
  width: 130%;
  height: 130%;
  will-change: transform;
}

.goods-card__cover.is-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-card__cover-empty {
  color: #a1a1a7;
  font-size: 24rpx;
}

.goods-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.goods-card__summary {
  flex: 1;
  min-width: 0;
}

.goods-card__title {
  display: block;
  color: #1d1d1f;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 700;
}

.goods-card__meta,
.goods-card__subtitle {
  display: block;
  margin-top: 10rpx;
  color: #8a8a8e;
  font-size: 24rpx;
  line-height: 1.55;
}

.goods-card__status {
  flex-shrink: 0;
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.goods-card__status.is-on {
  background: #eaf7ee;
  color: #287a3e;
}

.goods-card__status.is-off {
  background: #f1f0ec;
  color: #8a8a8e;
}

.goods-card__footer {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.goods-card__price-block {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
}

.goods-card__price {
  color: #1d1d1f;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 700;
}

.goods-card__origin {
  color: #b0b0b5;
  font-size: 24rpx;
  text-decoration: line-through;
}

.goods-card__actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.goods-card__action {
  min-width: 92rpx;
  height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.goods-card__action--light {
  background: #f7f5f0;
  border: 1px solid #e8e5de;
  color: #5f5950;
}

.goods-card__action--dark {
  background: #1d1d1f;
  color: #ffffff;
}

.goods-empty {
  margin-top: 18rpx;
  min-height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.goods-empty__text {
  color: #8a8a8e;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.goods-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(29, 29, 31, 0.32);
  box-sizing: border-box;
}

.goods-modal {
  width: 100%;
  padding: 34rpx;
}

.goods-modal__title {
  display: block;
  color: #1d1d1f;
  font-size: 34rpx;
  line-height: 1.4;
  font-weight: 700;
}

.goods-modal__desc {
  display: block;
  margin-top: 12rpx;
  color: #8a8a8e;
  font-size: 26rpx;
  line-height: 1.6;
}

.goods-modal__actions {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.goods-modal__btn {
  height: 78rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.goods-modal__btn--light {
  background: #f7f5f0;
  color: #3a3a3c;
}

.goods-modal__btn--dark {
  background: #1d1d1f;
  color: #ffffff;
}

.merchant-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 108rpx;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  padding: 8rpx 18rpx calc(8rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid #f3efe6;
  box-sizing: border-box;
  z-index: 90;
}

.merchant-tabbar__item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
}

.merchant-tabbar__label {
  font-size: 22rpx;
  color: #9a9a9e;
  font-weight: 500;
}

.merchant-tabbar__item.active .merchant-tabbar__label {
  color: #c8a46a;
  font-weight: 600;
}
