.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  background: #faf8f3;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border-radius: 32rpx;
  border: 1px solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 28, 22, 0.06);
  box-sizing: border-box;
}

.primary-btn,
.ghost-btn {
  height: 72rpx;
  margin: 0;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.primary-btn {
  background: #1d1d1f;
  color: #ffffff;
}

.ghost-btn {
  background: #f7f5f0;
  color: #3a3a3c;
  border: 1px solid #e8e5de;
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.green {
  background: #eaf7ee;
  color: #287a3e;
}

.status-tag.gray {
  background: #f1f0ec;
  color: #8a8a8e;
}

.tabs {
  padding: 10rpx;
  display: flex;
  gap: 12rpx;
}

.tab-item {
  flex: 1;
  height: 68rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8a8e;
  font-size: 24rpx;
}

.tab-item.active {
  background: #1d1d1f;
  color: #ffffff;
  font-weight: 600;
}

/* 顶部工具栏 */
.toolbar {
  margin-top: 18rpx;
  display: flex;
  gap: 16rpx;
}

.toolbar-btn {
  flex: 1;
  min-width: 0;
  font-weight: 600;
}

/* 批量操作栏 */
.batch-panel {
  margin-top: 14rpx;
  padding: 24rpx;
  background: #fff8ec;
  border: 1px solid #ecd5ae;
}

.batch-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.batch-info {
  flex: 1;
  min-width: 0;
}

.batch-title {
  display: block;
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 700;
}

.batch-count {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.select-btn {
  width: 164rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.batch-actions {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.batch-action-btn {
  width: 100%;
  height: 68rpx;
  min-width: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.batch-action-btn.danger {
  background: #f7f0e4;
  color: #8b6a32;
}

/* 商品卡片 */
.goods-card {
  margin-top: 18rpx;
  padding: 28rpx;
  display: flex;
  gap: 20rpx;
}

.goods-card.low-stock-card {
  border: 1px solid #ecd5ae;
  background: #fffdf8;
}

.goods-checkbox {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding-top: 60rpx;
}

.checkbox-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid #d8d2c7;
  background: #fff;
}

.checkbox-icon.checked {
  background: #1d1d1f;
  border-color: #1d1d1f;
}

.goods-body {
  flex: 1;
  min-width: 0;
}

.goods-cover {
  position: relative;
  margin-bottom: 20rpx;
  height: 230rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f3efe6;
}

.goods-cover-image {
  position: absolute;
  left: -15%;
  top: -15%;
  width: 130%;
  height: 130%;
  will-change: transform;
}

.goods-cover.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8a8e;
  font-size: 24rpx;
}

.goods-top,
.goods-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.goods-title {
  display: block;
  font-size: 32rpx;
  color: #1d1d1f;
  font-weight: 600;
}

.goods-meta,
.goods-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a8a8e;
  line-height: 1.6;
}

.low-stock-tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #fff4de;
  color: #8b6a32;
  font-size: 22rpx;
  font-weight: 600;
}

.goods-price {
  display: block;
  margin-top: 18rpx;
  font-size: 32rpx;
  color: #1d1d1f;
  font-weight: 700;
}

.goods-origin {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #b0b0b5;
  text-decoration: line-through;
}

.goods-actions {
  margin-top: 20rpx;
}

.mini-btn {
  flex: 1;
  height: 68rpx;
  min-width: 0;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 0 18rpx;
}

.confirm-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(29, 29, 31, 0.32);
  box-sizing: border-box;
}

.confirm-modal-card {
  width: 100%;
  padding: 34rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 80rpx rgba(32, 28, 22, 0.16);
  box-sizing: border-box;
}

.confirm-modal-title {
  display: block;
  font-size: 34rpx;
  color: #1d1d1f;
  font-weight: 700;
}

.confirm-modal-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a8a8e;
  line-height: 1.6;
}

.confirm-modal-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.confirm-modal-btn {
  flex: 1;
  height: 78rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  font-size: 28rpx;
  margin: 0;
  border: none;
  padding: 0;
}

.confirm-modal-btn::after {
  border: none;
}

.confirm-modal-btn.secondary {
  background: #f7f5f0;
  color: #3a3a3c;
}

.confirm-modal-btn.primary {
  background: #1d1d1f;
  color: #ffffff;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #8a8a8e;
}

.merchant-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 108rpx;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 0;
  padding: 8rpx 18rpx calc(8rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid #f3efe6;
  box-sizing: border-box;
  z-index: 90;
}

.merchant-tabbar__item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
}

.merchant-tabbar__label {
  font-size: 22rpx;
  color: #9a9a9e;
  font-weight: 500;
}

.merchant-tabbar__item.active .merchant-tabbar__label {
  color: #c8a46a;
  font-weight: 600;
}
