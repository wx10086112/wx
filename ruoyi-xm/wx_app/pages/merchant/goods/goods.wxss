.goods-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 42%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.panel {
  border-radius: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.76)),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
}

.goods-filter {
  padding: 8rpx;
  display: flex;
  gap: 10rpx;
}

.goods-filter__item {
  flex: 1;
  height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #667085;
  font-size: 24rpx;
  font-weight: 600;
}

.goods-filter__item.is-active {
  color: #237bc7;
  background: #ffffff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.84), 0 8rpx 18rpx rgba(34, 73, 116, 0.08);
}

.goods-content {
  margin-top: 18rpx;
}

.goods-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.goods-toolbar__hint {
  flex: 1;
  min-width: 0;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.goods-toolbar__actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.goods-tool {
  min-width: 126rpx;
  height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 660;
  line-height: 1;
}

.goods-tool--dark {
  color: #237bc7;
  border: 1rpx solid rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.goods-tool--light {
  color: #475467;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.goods-batch {
  margin-top: 16rpx;
  padding: 24rpx;
  background: #e7f4ff;
  border-color: rgba(45, 143, 232, 0.14);
}

.goods-batch__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.goods-batch__info {
  flex: 1;
  min-width: 0;
}

.goods-batch__title {
  display: block;
  color: #111827;
  font-size: 28rpx;
  font-weight: 760;
}

.goods-batch__count {
  display: block;
  margin-top: 6rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.goods-batch__toggle {
  min-width: 126rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(45, 143, 232, 0.18);
  background: #ffffff;
  color: #237bc7;
  font-size: 22rpx;
  font-weight: 660;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.goods-batch__actions {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.goods-batch__action {
  height: 62rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(45, 143, 232, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #237bc7;
  font-size: 24rpx;
  font-weight: 660;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.goods-batch__action--warn {
  color: #c76f12;
  background: #fff5e8;
}

.goods-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 18rpx;
}

.goods-card {
  padding: 24rpx;
  display: flex;
  gap: 18rpx;
}

.goods-card__checkbox {
  width: 52rpx;
  padding-top: 56rpx;
  display: flex;
  justify-content: center;
  flex-shrink: 0;
}

.goods-card__checkbox-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  border: 3rpx solid #c7d4e1;
  background: #ffffff;
}

.goods-card__checkbox-icon.is-checked {
  background: #2d8fe8;
  border-color: #2d8fe8;
}

.goods-card__main {
  flex: 1;
  min-width: 0;
}

.goods-card__cover {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  margin-bottom: 22rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #dbeefa;
}

.goods-card__cover-image {
  position: absolute;
  left: -15%;
  top: -15%;
  width: 130%;
  height: 130%;
  will-change: transform;
}

.goods-card__cover.is-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-card__cover-empty {
  color: #98a2b3;
  font-size: 24rpx;
}

.goods-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.goods-card__summary {
  flex: 1;
  min-width: 0;
}

.goods-card__title {
  display: block;
  color: #111827;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 760;
}

.goods-card__meta,
.goods-card__subtitle {
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.55;
}

.goods-card__status {
  flex-shrink: 0;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 660;
  line-height: 1;
}

.goods-card__status.is-on {
  background: #e9f8f1;
  color: #168257;
}

.goods-card__status.is-off {
  background: #edf2f7;
  color: #667085;
}

.goods-card__footer {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.goods-card__price-block {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
}

.goods-card__price {
  color: #111827;
  font-size: 38rpx;
  line-height: 1;
  font-weight: 780;
}

.goods-card__origin {
  color: #98a2b3;
  font-size: 24rpx;
  text-decoration: line-through;
}

.goods-card__actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
}

.goods-card__action {
  min-width: 84rpx;
  height: 50rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 660;
  line-height: 1;
}

.goods-card__action--light {
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  color: #475467;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.goods-card__action--dark {
  color: #237bc7;
  border: 1rpx solid rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.goods-empty {
  margin-top: 18rpx;
  min-height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.goods-empty__text {
  color: #667085;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.goods-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(17, 24, 39, 0.34);
}

.goods-modal {
  width: 100%;
  padding: 34rpx;
}

.goods-modal__title {
  display: block;
  color: #111827;
  font-size: 34rpx;
  line-height: 1.4;
  font-weight: 760;
}

.goods-modal__desc {
  display: block;
  margin-top: 12rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.6;
}

.goods-modal__actions {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.goods-modal__btn {
  height: 74rpx;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 680;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.goods-modal__btn--light {
  background: rgba(255, 255, 255, 0.58);
  border-color: rgba(148, 163, 184, 0.18);
  color: #475467;
}

.goods-modal__btn--dark {
  color: #237bc7;
  border-color: rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
}
