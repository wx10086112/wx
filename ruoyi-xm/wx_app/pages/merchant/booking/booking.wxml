<view class="booking-page">
  <scroll-view scroll-x class="tabs-scroll">
    <view class="tabs panel">
      <view
        wx:for="{{tabs}}"
        wx:key="value"
        class="tab-item {{currentTab === item.value ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="{{item.value}}"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view class="hint-card panel">
    <text class="hint-title">上架商品自动可预点单</text>
    <text class="hint-desc">商品管理里处于“上架中”的套餐，会实时出现在用户预点单页；这里展示用户提交后的预点单记录。</text>
  </view>

  <view wx:if="{{loading}}" class="empty-state panel">
    <text class="empty-text">正在加载预点单...</text>
  </view>

  <view wx:elif="{{bookingList.length}}" class="booking-list">
    <view wx:for="{{bookingList}}" wx:key="bookingNo" class="booking-card panel">
      <view class="booking-top">
        <image class="booking-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="booking-main">
          <view class="booking-title-row">
            <text class="booking-title">{{item.title}}</text>
            <view class="status-tag {{item.statusMeta.className}}">{{item.statusMeta.text}}</view>
          </view>
          <text class="booking-no">预点单号 {{item.bookingNo}}</text>
          <text class="booking-price">¥{{item.priceText}}</text>
        </view>
      </view>

      <view class="booking-info">
        <text class="info-line">预点单时间：{{item.bookingTimeText}}</text>
        <text class="info-line">联系人：{{item.customerName || '未填写'}} · {{item.peopleCount || 1}}人</text>
        <text class="info-line">联系电话：{{item.customerPhone || '未填写'}}</text>
        <text wx:if="{{item.remark}}" class="info-remark">备注：{{item.remark}}</text>
        <text class="info-create">提交时间：{{item.createTimeText}}</text>
      </view>

      <view class="booking-actions">
        <view wx:if="{{item.customerPhone}}" class="action-btn light" catchtap="callCustomer" data-phone="{{item.customerPhone}}">联系用户</view>
        <view wx:if="{{item.canCancel}}" class="action-btn light" catchtap="cancelBooking" data-no="{{item.bookingNo}}">取消</view>
        <view wx:if="{{item.canConfirm}}" class="action-btn primary" catchtap="confirmBooking" data-no="{{item.bookingNo}}">确认</view>
        <view wx:if="{{item.canComplete}}" class="action-btn primary" catchtap="completeBooking" data-no="{{item.bookingNo}}">完成</view>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state panel">
    <text class="empty-title">暂无预点单</text>
    <text class="empty-text">用户在预点单页提交后，会自动出现在这里。</text>
  </view>

  <view class="merchant-tabbar safe-area-bottom">
    <view
      wx:for="{{merchantNavList}}"
      wx:key="key"
      class="merchant-tabbar__item {{item.active ? 'active' : ''}}"
      bindtap="goMerchantTab"
      data-url="{{item.url}}"
    >
      <text class="merchant-tabbar__label">{{item.label}}</text>
    </view>
  </view>
</view>
