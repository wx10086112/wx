.settlement-hero {
  padding: 34rpx 30rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.18), transparent 34%),
    linear-gradient(135deg, #0f3d91 0%, #1f6feb 56%, #4da3ff 100%);
  box-shadow: 0 22rpx 50rpx rgba(31, 111, 235, 0.22);
}

.hero-kicker,
.hero-label,
.hero-meta {
  display: block;
  color: rgba(255, 255, 255, 0.82);
}

.hero-kicker {
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-label {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.hero-amount {
  display: block;
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 58rpx;
  font-weight: 800;
}

.hero-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.stats-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.stats-card {
  padding: 24rpx;
}

.stats-value {
  display: block;
  font-size: 32rpx;
  color: #1f2a37;
  font-weight: 700;
}

.stats-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a8798;
}

.section-panel {
  margin-top: 22rpx;
  padding: 28rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.section-title {
  display: block;
  color: #1f2a37;
  font-size: 30rpx;
  font-weight: 700;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #7a8798;
  font-size: 23rpx;
  line-height: 1.5;
}

.account-head {
  align-items: center;
}

.account-status {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.account-status.verified {
  color: #0f766e;
  background: #dcfce7;
}

.account-status.pending {
  color: #b45309;
  background: #fef3c7;
}

.account-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.account-item {
  min-width: 0;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f7faff;
}

.account-label {
  display: block;
  color: #7a8798;
  font-size: 23rpx;
}

.account-value {
  display: block;
  margin-top: 10rpx;
  color: #1f2a37;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.filter-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: flex-end;
}

.filter-tab {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #6f7d91;
  background: #f6f9ff;
}

.filter-tab.active {
  background: #1f6feb;
  color: #ffffff;
}

.ledger-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf1f5;
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.ledger-row:last-child {
  border-bottom: none;
}

.ledger-main {
  flex: 1;
  min-width: 0;
}

.ledger-title {
  display: block;
  font-size: 28rpx;
  color: #1f2a37;
  font-weight: 600;
  line-height: 1.4;
}

.ledger-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a8798;
  line-height: 1.5;
}

.ledger-side {
  min-width: 148rpx;
  text-align: right;
}

.ledger-amount {
  display: block;
  font-size: 28rpx;
  color: #0f3d91;
  font-weight: 700;
}

.ledger-fee {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa6b6;
}

.ledger-status {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7a8798;
}

.ledger-status.processing {
  color: #b45309;
}

.ledger-status.arrived {
  color: #0f766e;
}

.ledger-status.failed {
  color: #d93025;
}

.empty-inline {
  padding: 48rpx 0 12rpx;
  text-align: center;
}
