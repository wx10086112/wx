.page-shell {
  min-height: 100vh;
  padding: 32rpx 32rpx 72rpx;
  background: #f7f5f0;
  box-sizing: border-box;
}

.panel {
  background: rgba(255, 255, 255, 0.88);
  border-radius: 40rpx;
  border: 1rpx solid rgba(230, 225, 216, 0.82);
  box-shadow: 0 18rpx 42rpx rgba(35, 31, 25, 0.06);
  box-sizing: border-box;
}

.interactive-card {
  transition: transform 160ms ease, opacity 160ms ease;
}

.card-pressed {
  opacity: 0.88;
  transform: scale(0.985);
}

.settlement-hero {
  min-height: 308rpx;
  padding: 34rpx 36rpx;
  border-radius: 40rpx;
  background: linear-gradient(145deg, #1c1c1e 0%, #2b2a27 100%);
  box-shadow: 0 26rpx 58rpx rgba(28, 28, 30, 0.18);
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}

.settlement-hero::after {
  content: '';
  position: absolute;
  right: -72rpx;
  top: -88rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(201, 164, 106, 0.12);
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.hero-badge {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.72);
  background: rgba(255, 255, 255, 0.08);
  font-size: 22rpx;
}

.hero-content {
  margin-top: 46rpx;
  position: relative;
  z-index: 1;
}

.hero-kicker,
.hero-label {
  display: block;
  color: rgba(255, 255, 255, 0.82);
}

.hero-kicker {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #c9a46a;
  font-weight: 700;
}

.hero-label {
  font-size: 26rpx;
  color: rgba(235, 231, 224, 0.82);
}

.hero-amount {
  display: block;
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -2rpx;
}

.stats-grid {
  margin-top: 32rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.stats-card {
  min-height: 172rpx;
  padding: 28rpx;
}

.stats-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stats-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #9b968f;
}

.stats-dot.arrived {
  background: #4f8f63;
}

.stats-dot.processing {
  background: #c4873e;
}

.stats-dot.waiting {
  background: #9b968f;
}

.stats-dot.neutral {
  background: #1c1c1e;
}

.stats-value {
  display: block;
  margin-top: 24rpx;
  font-size: 38rpx;
  color: #1d1d1f;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #77736d;
  line-height: 1;
}

.section-panel {
  margin-top: 32rpx;
  padding: 32rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.section-title {
  display: block;
  color: #1d1d1f;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.25;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #8f8a83;
  font-size: 24rpx;
  line-height: 1.5;
}

.filter-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: flex-end;
  flex: 1;
}

.filter-tab {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #77736d;
  background: #f0ede7;
  transition: opacity 160ms ease;
}

.filter-tab.active {
  background: #1c1c1e;
  color: #ffffff;
}

.record-card,
.flow-card {
  margin-top: 22rpx;
  padding: 26rpx 0;
  border-top: 1rpx solid #eee9df;
  box-sizing: border-box;
}

.record-card {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title {
  display: block;
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.record-meta {
  display: block;
  margin-top: 8rpx;
  color: #8f8a83;
  font-size: 23rpx;
  line-height: 1.45;
}

.record-side {
  min-width: 156rpx;
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.record-amount {
  display: block;
  font-size: 30rpx;
  color: #1d1d1f;
  font-weight: 800;
  line-height: 1.2;
}

.status-pill {
  display: inline-block;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1;
  white-space: nowrap;
}

.status-pill.arrived {
  color: #34784a;
  background: #e9f4eb;
}

.status-pill.processing {
  color: #9b6428;
  background: #fbf0df;
}

.status-pill.waiting {
  color: #77736d;
  background: #efede8;
}

.status-pill.failed {
  color: #a3482f;
  background: #f8e8e2;
}

.flow-title-row {
  align-items: flex-start;
}

.flow-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 16rpx;
}

.flow-card .flow-row:first-child {
  margin-top: 0;
}

.flow-label {
  flex-shrink: 0;
  color: #9b968f;
  font-size: 23rpx;
  line-height: 1.45;
}

.flow-value {
  color: #4d4943;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: right;
  word-break: break-all;
}

.flow-title {
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 700;
}

.flow-divider {
  height: 1rpx;
  margin: 20rpx 0 4rpx;
  background: #eee9df;
}

.flow-summary {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eee9df;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20rpx;
}

.flow-money {
  display: block;
  margin-top: 6rpx;
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 800;
}

.flow-summary-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.empty-inline {
  padding: 64rpx 0 22rpx;
  text-align: center;
}

.empty-text {
  font-size: 25rpx;
  color: #9b968f;
}
