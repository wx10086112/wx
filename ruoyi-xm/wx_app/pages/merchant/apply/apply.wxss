.apply-page {
  min-height: 100vh;
  padding: 24rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 42%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.status-card {
  margin-top: 60rpx;
  padding: 60rpx 32rpx;
  border-radius: 38rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
  text-align: center;
}

.status-icon {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto;
  border-radius: 50%;
}

.pending-icon {
  border: 4rpx solid #e7f4ff;
  border-top-color: #2d8fe8;
}

.rejected-icon {
  background: #fff0f0;
  border: 2rpx solid #f5a6a6;
}

.rejected-icon::before,
.rejected-icon::after {
  content: "";
  position: absolute;
  left: 26rpx;
  top: 38rpx;
  width: 32rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #d94b4b;
}

.rejected-icon::before {
  transform: rotate(45deg);
}

.rejected-icon::after {
  transform: rotate(-45deg);
}

.status-title {
  display: block;
  margin-top: 24rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 760;
}

.status-desc {
  display: block;
  margin-top: 16rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.6;
}

.resubmit-btn,
.submit-btn {
  border: 1rpx solid rgba(45, 143, 232, 0.24);
  border-radius: 999rpx;
  color: #237bc7;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.resubmit-btn {
  width: 320rpx;
  height: 80rpx;
  margin-top: 40rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}

.resubmit-btn::after,
.submit-btn::after {
  border: none;
}

.form-header,
.form-section {
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
}

.form-header {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 36rpx;
}

.form-title {
  display: block;
  color: #111827;
  font-size: 34rpx;
  font-weight: 760;
}

.form-section {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 34rpx;
}

.section-label {
  display: block;
  margin-bottom: 18rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(20, 54, 91, 0.08);
}

.form-item:last-child {
  border-bottom: none;
}

.item-label {
  width: 160rpx;
  flex-shrink: 0;
  color: #667085;
  font-size: 26rpx;
}

.item-input {
  flex: 1;
  color: #111827;
  font-size: 26rpx;
}

.upload-block {
  margin-bottom: 24rpx;
}

.upload-label {
  display: block;
  margin-bottom: 14rpx;
  color: #667085;
  font-size: 26rpx;
}

.required {
  color: #d94b4b;
}

.upload-preview {
  position: relative;
  width: 240rpx;
  height: 180rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.preview-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(17, 24, 39, 0.5);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-add {
  width: 240rpx;
  height: 180rpx;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(45, 143, 232, 0.28);
  background: #e7f4ff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  color: #237bc7;
  font-size: 48rpx;
  line-height: 1;
}

.add-text {
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
}

.form-tip {
  padding: 20rpx 24rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.6;
}

.submit-btn {
  height: 76rpx;
  margin-top: 16rpx;
  font-size: 27rpx;
  font-weight: 680;
  line-height: 76rpx;
}

.submit-btn[disabled] {
  border-color: rgba(148, 163, 184, 0.12);
  color: #98a2b3;
  background: #e4edf5;
  box-shadow: none;
}
