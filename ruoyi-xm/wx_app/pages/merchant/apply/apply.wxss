.apply-page {
  min-height: 100vh;
  background: #faf8f3;
  padding: 24rpx;
  box-sizing: border-box;
}

.status-card {
  padding: 60rpx 32rpx;
  border-radius: 36rpx;
  background: #fff;
  text-align: center;
  margin-top: 60rpx;
  border: 1px solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 18rpx 48rpx rgba(32, 28, 22, 0.06);
}

.status-icon {
  font-size: 80rpx;
  display: block;
}

.status-title {
  display: block;
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.status-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8a8a8e;
  line-height: 1.6;
}

.resubmit-btn {
  margin-top: 40rpx;
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #1d1d1f;
  color: #fff;
  font-size: 28rpx;
  border: none;
}

.resubmit-btn::after {
  border: none;
}

.form-header {
  padding: 28rpx;
  border-radius: 36rpx;
  background: #1d1d1f;
  margin-bottom: 22rpx;
  box-shadow: 0 24rpx 56rpx rgba(0, 0, 0, 0.12);
}

.form-title {
  display: block;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}

.form-section {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 1px solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 28, 22, 0.06);
}

.section-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 18rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #efeae0;
}

.form-item:last-child {
  border-bottom: none;
}

.item-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #746f66;
  flex-shrink: 0;
}

.item-input {
  flex: 1;
  font-size: 26rpx;
  color: #1d1d1f;
}

.upload-block {
  margin-bottom: 24rpx;
}

.upload-label {
  display: block;
  font-size: 26rpx;
  color: #746f66;
  margin-bottom: 14rpx;
}

.required {
  color: #d93025;
}

.upload-preview {
  position: relative;
  width: 240rpx;
  height: 180rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
}

.preview-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-add {
  width: 240rpx;
  height: 180rpx;
  border-radius: 18rpx;
  background: #f7f5f0;
  border: 2rpx dashed #d9d1c3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 48rpx;
  color: #8b6a32;
  line-height: 1;
}

.add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8a8e;
}

.form-tip {
  padding: 20rpx 24rpx;
  font-size: 22rpx;
  color: #8a8a8e;
  line-height: 1.6;
}

.submit-btn {
  margin-top: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #1d1d1f;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #b0b0b5;
  color: #fff;
}
