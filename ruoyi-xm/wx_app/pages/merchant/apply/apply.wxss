.apply-page {
  min-height: 100vh;
  background: #f2f5f9;
  padding: 24rpx;
  box-sizing: border-box;
}

.status-card {
  padding: 60rpx 32rpx;
  border-radius: 24rpx;
  background: #fff;
  text-align: center;
  margin-top: 60rpx;
}

.status-icon {
  font-size: 80rpx;
  display: block;
}

.status-title {
  display: block;
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #20304a;
}

.status-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #7a8798;
  line-height: 1.6;
}

.resubmit-btn {
  margin-top: 40rpx;
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #1f6feb;
  color: #fff;
  font-size: 28rpx;
  border: none;
}

.resubmit-btn::after {
  border: none;
}

.form-header {
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1f6feb 0%, #5b9df9 100%);
  margin-bottom: 22rpx;
}

.form-title {
  display: block;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}

.form-section {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
}

.section-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #20304a;
  margin-bottom: 18rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf2fb;
}

.form-item:last-child {
  border-bottom: none;
}

.item-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #51657f;
  flex-shrink: 0;
}

.item-input {
  flex: 1;
  font-size: 26rpx;
  color: #20304a;
}

.upload-block {
  margin-bottom: 24rpx;
}

.upload-label {
  display: block;
  font-size: 26rpx;
  color: #51657f;
  margin-bottom: 14rpx;
}

.required {
  color: #d93025;
}

.upload-preview {
  position: relative;
  width: 240rpx;
  height: 180rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.preview-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-add {
  width: 240rpx;
  height: 180rpx;
  border-radius: 14rpx;
  background: #f6f9ff;
  border: 2rpx dashed #ccd3dc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 48rpx;
  color: #8a96a8;
  line-height: 1;
}

.add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a96a8;
}

.form-tip {
  padding: 20rpx 24rpx;
  font-size: 22rpx;
  color: #8a96a8;
  line-height: 1.6;
}

.submit-btn {
  margin-top: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #1f6feb 0%, #5b9df9 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #b0bec5;
  color: #fff;
}
