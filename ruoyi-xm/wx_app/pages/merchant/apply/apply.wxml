<view class="apply-page">
  <view wx:if="{{applyStatus === 'pending'}}" class="status-card pending">
    <view class="status-icon pending-icon"></view>
    <text class="status-title">审核中</text>
    <text class="status-desc">您的入驻申请已提交，平台将在 1-3 个工作日内完成审核，请耐心等待。</text>
  </view>

  <view wx:elif="{{applyStatus === 'rejected'}}" class="status-card rejected">
    <view class="status-icon rejected-icon"></view>
    <text class="status-title">审核未通过</text>
    <text class="status-desc">原因：{{reviewResult || '资质信息不符合要求'}}</text>
    <button class="resubmit-btn" bindtap="onResubmit">重新提交</button>
  </view>

  <view wx:else class="form-wrap">
    <view class="form-header">
      <text class="form-title">商家入驻申请</text>
    </view>

    <view class="form-section">
      <text class="section-label">基本信息</text>
      <view class="form-item">
        <text class="item-label">店铺名称</text>
        <input class="item-input" placeholder="请输入店铺名称" value="{{form.storeName}}" bindinput="onInput" data-field="storeName" />
      </view>
      <view class="form-item">
        <text class="item-label">联系人</text>
        <input class="item-input" placeholder="请输入联系人姓名" value="{{form.contactName}}" bindinput="onInput" data-field="contactName" />
      </view>
      <view class="form-item">
        <text class="item-label">联系电话</text>
        <input class="item-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{form.contactPhone}}" bindinput="onInput" data-field="contactPhone" />
      </view>
      <view class="form-item">
        <text class="item-label">店铺地址</text>
        <input class="item-input" placeholder="请输入详细地址" value="{{form.address}}" bindinput="onInput" data-field="address" />
      </view>
    </view>

    <view class="form-section">
      <text class="section-label">资质材料</text>

      <view class="upload-block">
        <text class="upload-label">营业执照 <text class="required">*</text></text>
        <view wx:if="{{form.licenseImage}}" class="upload-preview">
          <image src="{{form.licenseImage}}" class="preview-img" mode="aspectFill"></image>
          <view class="preview-remove" bindtap="onRemoveImage" data-field="licenseImage">×</view>
        </view>
        <view wx:else class="upload-add" bindtap="onChooseImage" data-field="licenseImage">
          <text class="add-icon">+</text>
          <text class="add-text">上传营业执照</text>
        </view>
      </view>

      <view class="upload-block">
        <text class="upload-label">法人身份证正面 <text class="required">*</text></text>
        <view wx:if="{{form.idCardFrontImage}}" class="upload-preview">
          <image src="{{form.idCardFrontImage}}" class="preview-img" mode="aspectFill"></image>
          <view class="preview-remove" bindtap="onRemoveImage" data-field="idCardFrontImage">×</view>
        </view>
        <view wx:else class="upload-add" bindtap="onChooseImage" data-field="idCardFrontImage">
          <text class="add-icon">+</text>
          <text class="add-text">上传身份证正面</text>
        </view>
      </view>

      <view class="upload-block">
        <text class="upload-label">法人身份证反面</text>
        <view wx:if="{{form.idCardBackImage}}" class="upload-preview">
          <image src="{{form.idCardBackImage}}" class="preview-img" mode="aspectFill"></image>
          <view class="preview-remove" bindtap="onRemoveImage" data-field="idCardBackImage">×</view>
        </view>
        <view wx:else class="upload-add" bindtap="onChooseImage" data-field="idCardBackImage">
          <text class="add-icon">+</text>
          <text class="add-text">上传身份证反面</text>
        </view>
      </view>

      <view class="upload-block">
        <text class="upload-label">门头照片 <text class="required">*</text></text>
        <view wx:if="{{form.storeFrontImage}}" class="upload-preview">
          <image src="{{form.storeFrontImage}}" class="preview-img" mode="aspectFill"></image>
          <view class="preview-remove" bindtap="onRemoveImage" data-field="storeFrontImage">×</view>
        </view>
        <view wx:else class="upload-add" bindtap="onChooseImage" data-field="storeFrontImage">
          <text class="add-icon">+</text>
          <text class="add-text">上传门头照片</text>
        </view>
      </view>
    </view>

    <view class="form-tip">
      <text>提交后平台将在 1-3 个工作日内完成审核，审核通过后即可登录使用商家端。</text>
    </view>

    <button class="submit-btn" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交入驻申请'}}
    </button>
  </view>
</view>
