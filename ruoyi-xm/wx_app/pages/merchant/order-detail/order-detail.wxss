.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 140rpx;
  background: #faf8f3;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border-radius: 36rpx;
  border: 1px solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 18rpx 48rpx rgba(32, 28, 22, 0.06);
  box-sizing: border-box;
}

.primary-btn,
.ghost-btn {
  height: 76rpx;
  margin: 0;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.primary-btn {
  background: #1d1d1f;
  color: #ffffff;
}

.ghost-btn {
  background: #f7f5f0;
  color: #3a3a3c;
  border: 1px solid #e8e5de;
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

/* 状态头部 */
.status-hero {
  padding: 36rpx 30rpx;
  border-radius: 36rpx;
  background: #1d1d1f;
  box-shadow: 0 24rpx 56rpx rgba(0, 0, 0, 0.12);
}

.status-hero.orange {
  background: #c8a46a;
  box-shadow: 0 24rpx 56rpx rgba(200, 164, 106, 0.22);
}

.status-hero.green {
  background: #2f6f47;
  box-shadow: 0 24rpx 56rpx rgba(47, 111, 71, 0.2);
}

.status-hero.gray {
  background: #746f66;
  box-shadow: 0 24rpx 56rpx rgba(116, 111, 102, 0.18);
}

.status-hero-text {
  display: block;
  font-size: 40rpx;
  color: #fff;
  font-weight: 700;
}

.status-hero-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.6;
}

/* 详情卡片 */
.detail-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.detail-section-title {
  display: block;
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.detail-title {
  display: block;
  font-size: 34rpx;
  color: #1d1d1f;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.detail-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.detail-label {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #8a8a8e;
  min-width: 120rpx;
}

.detail-value {
  font-size: 26rpx;
  color: #1d1d1f;
  text-align: right;
  word-break: break-all;
}

.detail-value.price {
  font-size: 30rpx;
  color: #1d1d1f;
  font-weight: 700;
}

.detail-value.code {
  font-size: 30rpx;
  color: #2f6f47;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.detail-value.remark {
  color: #746f66;
  font-style: italic;
}

/* 时间轴 */
.timeline {
  padding-left: 8rpx;
}

.timeline-item {
  display: flex;
  gap: 18rpx;
  padding-bottom: 28rpx;
  position: relative;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 30rpx;
  bottom: 0;
  width: 2rpx;
  background: #e8e5de;
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  flex-shrink: 0;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #c8a46a;
  margin-top: 6rpx;
  position: relative;
  z-index: 1;
}

.timeline-item.done .timeline-dot {
  background: #2f6f47;
}

.timeline-item.failed .timeline-dot {
  background: #a3482f;
}

.timeline-content {
  flex: 1;
}

.timeline-label {
  display: block;
  font-size: 26rpx;
  color: #1d1d1f;
  font-weight: 600;
}

.timeline-time {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.timeline-reason {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #746f66;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(250, 248, 243, 0.96);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -4rpx 20rpx rgba(32, 28, 22, 0.06);
  z-index: 100;
}

.action-btn {
  flex: 1;
}

.reject-style {
  background: #f7f0e4;
  color: #8b6a32;
}

.cancel-style {
  background: #f7f5f0;
  color: #746f66;
}

.refund-approve {
  background: #c8a46a;
}

.cancel-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(29, 29, 31, 0.32);
  box-sizing: border-box;
}

.cancel-modal-card {
  width: 100%;
  padding: 34rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 80rpx rgba(32, 28, 22, 0.16);
  box-sizing: border-box;
}

.cancel-modal-title {
  display: block;
  font-size: 34rpx;
  color: #1d1d1f;
  font-weight: 700;
}

.cancel-modal-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a8a8e;
  line-height: 1.6;
}

.cancel-reason-input {
  margin-top: 24rpx;
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #faf8f3;
  color: #1d1d1f;
  font-size: 28rpx;
  box-sizing: border-box;
}

.cancel-modal-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.cancel-modal-btn {
  flex: 1;
  height: 78rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  font-size: 28rpx;
  margin: 0;
  border: none;
  padding: 0;
}

.cancel-modal-btn::after {
  border: none;
}

.cancel-modal-btn.secondary {
  background: #f7f5f0;
  color: #3a3a3c;
}

.cancel-modal-btn.primary {
  background: #1d1d1f;
  color: #ffffff;
}

.cancel-modal-btn.success {
  background: #c8a46a;
  color: #ffffff;
}

