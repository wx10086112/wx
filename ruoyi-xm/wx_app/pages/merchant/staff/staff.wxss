.staff-panel {
  padding: 28rpx;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.add-staff-btn {
  width: auto;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.staff-row {
  margin-top: 18rpx;
  padding: 18rpx 16rpx;
  border-radius: 14rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  background: #f8fbff;
}

.staff-main {
  flex: 1;
}

.staff-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.staff-name {
  font-size: 30rpx;
  color: #1f2a37;
  font-weight: 600;
}

.staff-role-tag {
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #eef4ff;
  color: #1f6feb;
  font-size: 20rpx;
}

.staff-meta,
.staff-summary {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7a8798;
}

.staff-summary {
  line-height: 1.6;
}

.staff-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.staff-btn-group {
  display: flex;
  gap: 8rpx;
}

.mini-btn {
  width: auto;
  min-width: 100rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  font-size: 22rpx;
  padding: 0 16rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-panel {
  width: 600rpx;
  padding: 36rpx;
  border-radius: 22rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  display: block;
  font-size: 34rpx;
  color: #1f2a37;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.modal-field {
  margin-top: 20rpx;
}

.modal-field .field-label {
  display: block;
  font-size: 24rpx;
  color: #7a8798;
}

.modal-field .field-input {
  margin-top: 12rpx;
  width: 100%;
  height: 84rpx;
  border-radius: 16rpx;
  background: #f6f9ff;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1f2a37;
}

.picker-display {
  display: flex;
  align-items: center;
}

.readonly-field {
  display: flex;
  align-items: center;
  color: #516070;
}

.role-tip {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f4f7fd;
  color: #607089;
  font-size: 24rpx;
  line-height: 1.7;
}

.modal-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

.empty-card {
  margin-top: 18rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  background: #f8fbff;
}

.empty-card-text {
  font-size: 24rpx;
  color: #7a8798;
  line-height: 1.7;
}
