.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 42%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.panel {
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.76)),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
}

.primary-btn,
.ghost-btn {
  height: 72rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 680;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.primary-btn {
  color: #237bc7;
  border-color: rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
}

.ghost-btn {
  color: #475467;
  border-color: rgba(148, 163, 184, 0.18);
  background: rgba(255, 255, 255, 0.58);
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 660;
}

.status-tag.green {
  background: #e9f8f1;
  color: #168257;
}

.status-tag.gray {
  background: #edf2f7;
  color: #667085;
}

.staff-panel {
  padding: 28rpx;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.section-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 780;
}

.add-staff-btn {
  flex: none;
  width: 168rpx;
  min-width: 0;
  height: 62rpx;
  padding: 0;
  box-sizing: border-box;
  color: #237bc7;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
}

.staff-card {
  margin-top: 18rpx;
  padding: 24rpx 22rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #f1f7fd;
}

.staff-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.staff-identity {
  flex: 1;
  min-width: 0;
}

.staff-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.staff-name {
  flex-shrink: 1;
  min-width: 0;
  color: #111827;
  font-size: 30rpx;
  font-weight: 720;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.staff-role-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e7f4ff;
  color: #237bc7;
  font-size: 20rpx;
}

.staff-meta-grid {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.staff-meta {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.staff-permission {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.72);
}

.permission-label {
  display: block;
  color: #237bc7;
  font-size: 22rpx;
  font-weight: 700;
}

.staff-summary {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.staff-btn-group {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}

.mini-btn {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-panel {
  width: 600rpx;
  max-height: 80vh;
  padding: 36rpx;
  border-radius: 36rpx;
  overflow-y: auto;
}

.modal-title {
  display: block;
  margin-bottom: 24rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 760;
}

.modal-field {
  margin-top: 20rpx;
}

.modal-field .field-label {
  display: block;
  color: #667085;
  font-size: 24rpx;
}

.modal-field .field-input {
  width: 100%;
  height: 84rpx;
  margin-top: 12rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: #f1f7fd;
  color: #111827;
  font-size: 28rpx;
}

.picker-display,
.readonly-field {
  display: flex;
  align-items: center;
}

.readonly-field {
  color: #667085;
}

.role-tip {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: #e7f4ff;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.7;
}

.modal-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
}

.empty-card {
  margin-top: 18rpx;
  padding: 28rpx 24rpx;
  border-radius: 26rpx;
  background: #f1f7fd;
}

.empty-card-text {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.7;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  color: #667085;
  font-size: 26rpx;
}
