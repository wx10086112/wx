.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  background: #faf8f3;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border-radius: 36rpx;
  border: 1px solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 18rpx 48rpx rgba(32, 28, 22, 0.06);
  box-sizing: border-box;
}

.primary-btn,
.ghost-btn {
  height: 72rpx;
  margin: 0;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.primary-btn {
  background: #1d1d1f;
  color: #ffffff;
}

.ghost-btn {
  background: #f7f5f0;
  color: #3a3a3c;
  border: 1px solid #e8e5de;
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.green {
  background: #eaf7ee;
  color: #287a3e;
}

.status-tag.gray {
  background: #f1f0ec;
  color: #8a8a8e;
}

.staff-panel {
  padding: 28rpx;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.add-staff-btn {
  width: auto;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.staff-row {
  margin-top: 18rpx;
  padding: 22rpx 20rpx;
  border-radius: 24rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  background: #faf8f3;
}

.staff-main {
  flex: 1;
}

.staff-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.staff-name {
  font-size: 30rpx;
  color: #1d1d1f;
  font-weight: 600;
}

.staff-role-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fff4de;
  color: #8b6a32;
  font-size: 20rpx;
}

.staff-meta,
.staff-summary {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.staff-summary {
  line-height: 1.6;
}

.staff-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.staff-btn-group {
  display: flex;
  gap: 8rpx;
}

.mini-btn {
  width: auto;
  min-width: 100rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  font-size: 22rpx;
  padding: 0 16rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(29, 29, 31, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-panel {
  width: 600rpx;
  padding: 36rpx;
  border-radius: 32rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  display: block;
  font-size: 34rpx;
  color: #1d1d1f;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.modal-field {
  margin-top: 20rpx;
}

.modal-field .field-label {
  display: block;
  font-size: 24rpx;
  color: #8a8a8e;
}

.modal-field .field-input {
  margin-top: 12rpx;
  width: 100%;
  height: 84rpx;
  border-radius: 24rpx;
  background: #faf8f3;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1d1d1f;
}

.picker-display {
  display: flex;
  align-items: center;
}

.readonly-field {
  display: flex;
  align-items: center;
  color: #746f66;
}

.role-tip {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: #f7f5f0;
  color: #746f66;
  font-size: 24rpx;
  line-height: 1.7;
}

.modal-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

.empty-card {
  margin-top: 18rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #faf8f3;
}

.empty-card-text {
  font-size: 24rpx;
  color: #8a8a8e;
  line-height: 1.7;
}

.section-title,
.empty-text {
  color: #1d1d1f;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
