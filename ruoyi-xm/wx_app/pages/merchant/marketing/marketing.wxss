.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  background: #faf8f3;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border-radius: 32rpx;
  border: 1px solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 28, 22, 0.06);
  box-sizing: border-box;
}

.primary-btn,
.ghost-btn {
  height: 72rpx;
  margin: 0;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.primary-btn {
  background: #1d1d1f;
  color: #ffffff;
}

.ghost-btn {
  background: #f7f5f0;
  color: #3a3a3c;
  border: 1px solid #e8e5de;
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.green {
  background: #eaf7ee;
  color: #287a3e;
}

.status-tag.gray {
  background: #f1f0ec;
  color: #8a8a8e;
}

.tabs {
  padding: 10rpx;
  display: flex;
  gap: 12rpx;
}

.tab-item {
  flex: 1;
  height: 68rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8a8e;
  font-size: 24rpx;
}

.tab-item.active {
  background: #1d1d1f;
  color: #ffffff;
  font-weight: 600;
}

.add-btn {
  width: 100%;
  margin-top: 18rpx;
  font-weight: 600;
}

.marketing-card {
  position: relative;
  margin-top: 18rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.compact-card {
  min-height: auto;
}

.coupon-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  max-width: 240rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #1d1d1f;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
}

.promo-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  max-width: 360rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #c8a46a;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
}

.card-status {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
}

.card-title {
  display: block;
  margin-top: 16rpx;
  font-size: 30rpx;
  color: #1d1d1f;
  font-weight: 600;
}

.card-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.card-actions {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
}

.edit-action-btn,
.status-action-btn {
  width: 104rpx;
  height: 52rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  padding: 0;
}

.edit-action-btn {
  background: #f7f5f0;
  color: #3a3a3c;
}

.status-action-btn.danger {
  background: #f7f0e4;
  color: #8b6a32;
}

.status-action-btn.success {
  background: #eaf7ee;
  color: #287a3e;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(29, 29, 31, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-panel {
  width: 600rpx;
  padding: 36rpx;
  border-radius: 32rpx;
}

.modal-title {
  display: block;
  font-size: 34rpx;
  color: #1d1d1f;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.modal-field {
  margin-top: 20rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #8a8a8e;
}

.field-input {
  margin-top: 12rpx;
  width: 100%;
  height: 84rpx;
  border-radius: 24rpx;
  background: #faf8f3;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1d1d1f;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #8a8a8e;
}

.modal-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0;
}
