.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 42%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.panel {
  border-radius: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.76)),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
}

.primary-btn,
.ghost-btn {
  height: 72rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 680;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.primary-btn {
  color: #237bc7;
  border-color: rgba(45, 143, 232, 0.24);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 255, 0.92)),
    #e7f4ff;
}

.ghost-btn {
  color: #475467;
  border-color: rgba(148, 163, 184, 0.18);
  background: rgba(255, 255, 255, 0.58);
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 660;
}

.status-tag.green {
  background: #e9f8f1;
  color: #168257;
}

.status-tag.gray {
  background: #edf2f7;
  color: #667085;
}

.tabs {
  padding: 8rpx;
  display: flex;
  gap: 10rpx;
}

.tab-item {
  flex: 1;
  height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #667085;
  font-size: 24rpx;
}

.tab-item.active {
  color: #237bc7;
  background: #ffffff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.84), 0 8rpx 18rpx rgba(34, 73, 116, 0.08);
  font-weight: 680;
}

.add-btn {
  width: 100%;
  margin-top: 18rpx;
}

.marketing-card {
  position: relative;
  margin-top: 18rpx;
  padding: 28rpx;
}

.compact-card {
  min-height: auto;
}

.coupon-badge,
.promo-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  border-radius: 999rpx;
  color: #ffffff;
  line-height: 1.2;
  white-space: nowrap;
}

.coupon-badge {
  max-width: 240rpx;
  padding: 8rpx 20rpx;
  background: linear-gradient(145deg, #78c3ff 0%, #2d8fe8 100%);
  font-size: 32rpx;
  font-weight: 760;
}

.promo-badge {
  max-width: 360rpx;
  padding: 8rpx 20rpx;
  background: linear-gradient(145deg, #ffbd74 0%, #e58a19 100%);
  font-size: 26rpx;
  font-weight: 760;
}

.card-status {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
}

.card-title {
  display: block;
  margin-top: 16rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 720;
}

.card-meta {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.card-actions {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
}

.edit-action-btn,
.status-action-btn {
  width: 104rpx;
  height: 52rpx;
  padding: 0;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 660;
}

.edit-action-btn {
  background: rgba(255, 255, 255, 0.58);
  border-color: rgba(148, 163, 184, 0.18);
  color: #475467;
}

.status-action-btn.danger {
  border-color: rgba(217, 75, 75, 0.22);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(255, 240, 240, 0.92)),
    #fff0f0;
  color: #d94b4b;
}

.status-action-btn.success {
  border-color: rgba(22, 163, 106, 0.22);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(233, 248, 241, 0.94)),
    #e9f8f1;
  color: #168257;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-panel {
  width: 600rpx;
  padding: 36rpx;
  border-radius: 36rpx;
}

.modal-title {
  display: block;
  margin-bottom: 24rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 760;
}

.modal-field {
  margin-top: 20rpx;
}

.field-label {
  display: block;
  color: #667085;
  font-size: 24rpx;
}

.field-input {
  width: 100%;
  height: 84rpx;
  margin-top: 12rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: #f1f7fd;
  color: #111827;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  color: #667085;
  font-size: 26rpx;
}

.modal-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  height: 74rpx;
  padding: 0;
}
