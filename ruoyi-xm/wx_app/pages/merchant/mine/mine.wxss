.mine-page {
  padding-bottom: 160rpx;
  background: #FAF8F3;
  min-height: 100vh;
}

.profile-card {
  padding: 36rpx;
  border-radius: 40rpx;
  background: #1D1D1F;
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.1);
  margin: 24rpx;
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #C8A46A;
  color: #1D1D1F;
  font-size: 36rpx;
  font-weight: 700;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-name {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: 700;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-pill,
.status-pill {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #1D1D1F;
  background: #C8A46A;
}

.status-pill {
  background: #3A3A3C;
  color: #F7F5F0;
  border: none;
}

.user-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8A8A8E;
}

.store-block {
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #3A3A3C;
}

.store-name {
  display: block;
  font-size: 32rpx;
  color: #F7F5F0;
  font-weight: 600;
}

.store-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8A8A8E;
}

.section-card {
  margin: 32rpx 24rpx 0;
  padding: 24rpx 32rpx;
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(32, 28, 22, 0.06);
  border: 1px solid rgba(232, 229, 222, 0.9);
}

.section-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #8A8A8E;
}

.menu-item {
  min-height: 112rpx;
  padding: 24rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #E8E5DE;
  transition: opacity 0.2s;
}

.menu-item:active {
  opacity: 0.7;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-label {
  display: block;
  font-size: 32rpx;
  color: #1D1D1F;
  font-weight: 500;
}

.menu-arrow {
  margin-left: 20rpx;
  font-size: 40rpx;
  color: #8A8A8E;
  font-weight: 300;
}

.logout-btn {
  margin: 48rpx 24rpx 0;
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1D1D1F;
  background: #F7F5F0;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  transition: all 0.2s ease;
}

.logout-btn:active {
  background: #E8E5DE;
  transform: scale(0.98);
}

.logout-btn::after {
  border: none;
}

.merchant-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 108rpx;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 0;
  padding: 8rpx 18rpx calc(8rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid #f3efe6;
  box-sizing: border-box;
  z-index: 90;
}

.merchant-tabbar__item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
}

.merchant-tabbar__label {
  font-size: 22rpx;
  color: #9a9a9e;
  font-weight: 500;
}

.merchant-tabbar__item.active .merchant-tabbar__label {
  color: #c8a46a;
  font-weight: 600;
}
