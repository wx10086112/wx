.merchant-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 140rpx;
  background: #faf8f3;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border-radius: 32rpx;
  border: 1px solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 28, 22, 0.06);
  box-sizing: border-box;
}

.workbench-card {
  padding: 32rpx;
  border-radius: 40rpx;
}

.workbench-greeting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.greeting-text {
  flex: 1;
  min-width: 0;
  color: #1d1d1f;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.workbench-store-name {
  display: block;
  margin-top: 18rpx;
  color: #3a3a3c;
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.workbench-role {
  display: block;
  margin-top: 8rpx;
  color: #8a8a8e;
  font-size: 23rpx;
}

.tappable {
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.tappable--hover {
  opacity: 0.7;
  transform: scale(0.96);
}

.mine-status-switch {
  flex-shrink: 0;
  min-width: 138rpx;
  height: 52rpx;
  margin: 0;
  padding: 0 18rpx;
  border: none;
  border-radius: 999rpx;
  background: #f7f5f0;
  color: #746f66;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 52rpx;
}

.mine-status-switch::after {
  border: none;
}

.income-card {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #1d1d1f 0%, #2e2a24 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
}

.income-card::after {
  content: '';
  position: absolute;
  right: -56rpx;
  top: -56rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: rgba(200, 164, 106, 0.18);
}

.income-main {
  position: relative;
  z-index: 1;
}

.income-label {
  display: block;
  color: #b8b1a6;
  font-size: 23rpx;
}

.income-value {
  display: block;
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.05;
}


.hero-top,
.hero-sales-row,
.menu-item,
.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-store,
.hero-sales-value {
  display: block;
  color: #f7f5f0;
  font-size: 38rpx;
  font-weight: 700;
}

.hero-role,
.hero-sales-label {
  display: block;
  margin-top: 10rpx;
  color: #b8b1a6;
  font-size: 24rpx;
}

.hero-sales-row {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(247, 245, 240, 0.14);
}

.hero-sales-value {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 50rpx;
}

.primary-btn,
.ghost-btn,
.hero-switch {
  height: 72rpx;
  margin: 0;
  padding: 0 26rpx;
  border: none;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.primary-btn {
  background: #1d1d1f;
  color: #ffffff;
}

.ghost-btn,
.hero-switch {
  background: #f7f5f0;
  color: #3a3a3c;
}

.income-card .hero-switch {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 24rpx;
  background: #f7f5f0;
}

.primary-btn::after,
.ghost-btn::after,
.hero-switch::after {
  border: none;
}

.status-tag,
.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.green,
.status-pill {
  background: #eaf7ee;
  color: #287a3e;
}

.status-tag.gray {
  background: #f1f0ec;
  color: #8a8a8e;
}

.status-tag.blue,
.status-tag.orange {
  background: #fff4de;
  color: #8b6a32;
}

.alert-section,
.stats-grid,
.section,
.tabs,
.order-card,
.result-panel {
  margin-top: 18rpx;
}

.alert-item {
  padding: 20rpx 24rpx;
  border-radius: 26rpx;
  background: #fff4de;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.alert-text,
.alert-arrow {
  color: #8b6a32;
  font-size: 24rpx;
  font-weight: 600;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.stats-card {
  min-height: 140rpx;
  padding: 26rpx;
  text-align: left;
}

.stats-card.highlight {
  background: #fff8ec;
  border: 1px solid #ecd5ae;
}

.stats-value {
  display: block;
  color: #1d1d1f;
  font-size: 42rpx;
  font-weight: 700;
}

.stats-label,
.row-meta,
.order-meta,
.empty-text {
  display: block;
  margin-top: 8rpx;
  color: #8a8a8e;
  font-size: 24rpx;
}

.section {
  padding: 28rpx;
}

.section-headline {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.section-subtitle {
  color: #8a8a8e;
  font-size: 23rpx;
}

.section-title,
.row-title,
.menu-label {
  display: block;
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 700;
}

.section-title.light {
  color: #f7f5f0;
}

.quick-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.quick-item {
  min-height: 104rpx;
  border-radius: 28rpx;
  background: #faf8f3;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #eee7db;
}

.quick-label {
  color: #3a3a3c;
  font-size: 24rpx;
  font-weight: 600;
}

.list-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #efeae0;
}

.list-row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-side {
  flex-shrink: 0;
  text-align: right;
}

.row-price,
.order-amount,
.merchant-goods-card__price {
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 700;
}

.tabs {
  padding: 10rpx;
  display: flex;
  gap: 12rpx;
}

.tab-item {
  flex: 1;
  height: 68rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8a8e;
  font-size: 24rpx;
}

.tab-item.active {
  background: #1d1d1f;
  color: #ffffff;
  font-weight: 600;
}

.order-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.order-main {
  flex: 1;
  min-width: 0;
}

.order-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  text-align: right;
}

.order-title {
  display: block;
  color: #1d1d1f;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
}

.order-no {
  display: block;
  margin-top: 10rpx;
  color: #8a8a8e;
  font-size: 22rpx;
}

.order-time {
  color: #8a8a8e;
  font-size: 22rpx;
  line-height: 1.4;
}

.order-meta {
  margin-top: 14rpx;
}

.order-bottom {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.order-card,
.result-panel {
  padding: 28rpx;
}

.mini-btn {
  height: 64rpx;
  min-width: 128rpx;
}

.verify-header {
  margin-top: 18rpx;
}

.verify-page-title {
  display: block;
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 700;
}

.scan-card {
  margin-top: 18rpx;
  min-height: 176rpx;
  padding: 30rpx 28rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #1d1d1f 0%, #302b24 100%);
  box-shadow: 0 18rpx 44rpx rgba(29, 29, 31, 0.16);
  box-sizing: border-box;
}

.scan-card--hover {
  opacity: 0.92;
}

.scan-card__icon {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.scan-card__corner {
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  border-color: #c8a46a;
  box-sizing: border-box;
}

.scan-card__corner--tl {
  left: 0;
  top: 0;
  border-left: 6rpx solid #c8a46a;
  border-top: 6rpx solid #c8a46a;
  border-top-left-radius: 10rpx;
}

.scan-card__corner--tr {
  right: 0;
  top: 0;
  border-right: 6rpx solid #c8a46a;
  border-top: 6rpx solid #c8a46a;
  border-top-right-radius: 10rpx;
}

.scan-card__corner--bl {
  left: 0;
  bottom: 0;
  border-left: 6rpx solid #c8a46a;
  border-bottom: 6rpx solid #c8a46a;
  border-bottom-left-radius: 10rpx;
}

.scan-card__corner--br {
  right: 0;
  bottom: 0;
  border-right: 6rpx solid #c8a46a;
  border-bottom: 6rpx solid #c8a46a;
  border-bottom-right-radius: 10rpx;
}

.scan-card__line {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  top: 50%;
  height: 4rpx;
  margin-top: -2rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(200, 164, 106, 0.18) 0%, #c8a46a 50%, rgba(200, 164, 106, 0.18) 100%);
}

.scan-card__body {
  flex: 1;
  min-width: 0;
}

.scan-card__title {
  display: block;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.scan-card__desc {
  display: block;
  margin-top: 10rpx;
  color: #c8c1b7;
  font-size: 24rpx;
  line-height: 1.55;
}

.scan-card__arrow {
  flex-shrink: 0;
  color: #c8a46a;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
}

.manual-panel {
  margin-top: 18rpx;
  padding: 28rpx;
}

.manual-panel__head {
  min-width: 0;
}

.manual-panel__title {
  display: block;
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 700;
}

.manual-panel__input {
  margin-top: 18rpx;
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #faf8f3;
  color: #1d1d1f;
  font-size: 28rpx;
  box-sizing: border-box;
}

.manual-panel__action {
  margin-top: 18rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f5f0;
  border: 1px solid #e8e5de;
  color: #5f5950;
  font-size: 26rpx;
  font-weight: 600;
}

.merchant-goods-filter {
  padding: 10rpx;
  display: flex;
  gap: 12rpx;
}

.merchant-goods-filter__item {
  flex: 1;
  height: 68rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8a8e;
  font-size: 24rpx;
  font-weight: 500;
}

.merchant-goods-filter__item.is-active {
  background: #1d1d1f;
  color: #ffffff;
  font-weight: 600;
}

.merchant-goods-toolbar {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.merchant-goods-toolbar__intro {
  flex: 1;
  min-width: 0;
}

.merchant-goods-toolbar__title {
  display: block;
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 700;
}

.merchant-goods-toolbar__desc {
  display: block;
  margin-top: 6rpx;
  color: #8a8a8e;
  font-size: 22rpx;
}

.merchant-goods-toolbar__action {
  min-width: 144rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #fff8ec;
  border: 1px solid #ecd5ae;
  color: #8b6a32;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1;
  flex-shrink: 0;
}

.merchant-goods-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.merchant-goods-card {
  padding: 28rpx;
}

.merchant-goods-card__cover {
  position: relative;
  height: 228rpx;
  margin-bottom: 22rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background: #f3efe6;
}

.merchant-goods-card__cover.is-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.merchant-goods-card__cover-image {
  position: absolute;
  left: -15%;
  top: -15%;
  width: 130%;
  height: 130%;
}

.merchant-goods-card__cover-empty {
  color: #a1a1a7;
  font-size: 24rpx;
}

.merchant-goods-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.merchant-goods-card__summary {
  flex: 1;
  min-width: 0;
}

.merchant-goods-card__title {
  display: block;
  color: #1d1d1f;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 700;
}

.merchant-goods-card__meta,
.merchant-goods-card__subtitle {
  display: block;
  margin-top: 10rpx;
  color: #8a8a8e;
  font-size: 24rpx;
  line-height: 1.55;
}

.merchant-goods-card__status {
  flex-shrink: 0;
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.merchant-goods-card__status.is-on {
  background: #eaf7ee;
  color: #287a3e;
}

.merchant-goods-card__status.is-off {
  background: #f1f0ec;
  color: #8a8a8e;
}

.merchant-goods-card__footer {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.merchant-goods-card__price-block {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
}

.merchant-goods-card__action {
  min-width: 92rpx;
  height: 50rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #f7f5f0;
  border: 1px solid #e8e5de;
  color: #5f5950;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  flex-shrink: 0;
}

.merchant-goods-card__origin {
  color: #b0b0b5;
  font-size: 22rpx;
  text-decoration: line-through;
}

.menu-item {
  min-height: 96rpx;
  border-bottom: 1px solid #e8e5de;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-arrow {
  color: #8a8a8e;
  font-size: 40rpx;
}

/* 我的页 - 用户资料卡 */
.mine-profile {
  margin-top: 4rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.mine-profile__main {
  flex: 1;
  min-width: 0;
}

.mine-profile__name {
  display: block;
  color: #1d1d1f;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.mine-profile__meta {
  display: block;
  margin-top: 8rpx;
  color: #8a8a8e;
  font-size: 24rpx;
}

.mine-profile__switch {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #f7f5f0;
  border: 1px solid #e8e5de;
  color: #746f66;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.mine-profile__switch--hover {
  opacity: 0.7;
  transform: scale(0.96);
}

/* 我的页 - 店铺信息卡 */
.mine-store {
  margin-top: 18rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mine-store__main {
  flex: 1;
  min-width: 0;
}

.mine-store__name {
  display: block;
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mine-store__desc {
  display: block;
  margin-top: 8rpx;
  color: #8a8a8e;
  font-size: 23rpx;
}

.mine-store__status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.mine-store__status.is-on {
  background: #eaf7ee;
  color: #287a3e;
}

.mine-store__status.is-off {
  background: #f1f0ec;
  color: #8a8a8e;
}

.mine-store__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

/* 我的页 - 菜单分组 */
.mine-group {
  margin-top: 28rpx;
}

.mine-group__title {
  display: block;
  margin: 0 8rpx 12rpx;
  color: #a8a8ad;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.mine-group .section {
  margin-top: 0;
}

/* 我的页 - 退出登录（降权幽灵样式） */
.logout-btn {
  width: 100%;
  box-sizing: border-box;
  margin: 40rpx 0 0;
  height: 88rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #c14a3a;
  border: 1px solid #e8d5d1;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.logout-btn--hover {
  opacity: 0.75;
  transform: scale(0.98);
}

.logout-btn::after {
  border: none;
}

.empty-state,
.empty-inline {
  padding: 60rpx 0;
  text-align: center;
}

.merchant-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 112rpx;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  padding: 8rpx 14rpx calc(8rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid #f3efe6;
  box-sizing: border-box;
  z-index: 90;
}

.merchant-tabbar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  gap: 6rpx;
}

.merchant-tabbar__icon {
  width: 44rpx;
  height: 44rpx;
  background-color: #9a9a9e;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 44rpx 44rpx;
}

.merchant-tabbar__item.active .merchant-tabbar__icon {
  background-color: #c8a46a;
