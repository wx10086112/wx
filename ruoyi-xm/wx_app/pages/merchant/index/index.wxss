.merchant-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 140rpx;
  background: #faf8f3;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border-radius: 32rpx;
  border: 1px solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 28, 22, 0.06);
  box-sizing: border-box;
}

.profile-card {
  padding: 34rpx;
  border-radius: 40rpx;
  background: #1d1d1f;
  box-shadow: 0 24rpx 56rpx rgba(0, 0, 0, 0.12);
}

.workbench-card {
  padding: 32rpx;
  border-radius: 40rpx;
}

.store-headline {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.store-avatar-mark {
  width: 104rpx;
  height: 104rpx;
  border-radius: 30rpx;
  background: #f0ede6;
  color: #8b6a32;
  font-size: 38rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.store-headline-main {
  flex: 1;
  min-width: 0;
}

.store-name-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.workbench-store-name {
  flex: 1;
  min-width: 0;
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.workbench-role {
  display: block;
  margin-top: 12rpx;
  color: #8a8a8e;
  font-size: 24rpx;
}

.mine-status-switch {
  flex-shrink: 0;
  min-width: 138rpx;
  height: 52rpx;
  margin: 0;
  padding: 0 18rpx;
  border: none;
  border-radius: 999rpx;
  background: #f7f5f0;
  color: #746f66;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 52rpx;
}

.mine-status-switch::after {
  border: none;
}

.income-card {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #1d1d1f 0%, #2e2a24 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
}

.income-card::after {
  content: '';
  position: absolute;
  right: -56rpx;
  top: -56rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: rgba(200, 164, 106, 0.18);
}

.income-main {
  position: relative;
  z-index: 1;
}

.income-label {
  display: block;
  color: #b8b1a6;
  font-size: 23rpx;
}

.income-value {
  display: block;
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.05;
}


.hero-top,
.hero-sales-row,
.order-top,
.order-bottom,
.goods-top,
.goods-actions,
.profile-top,
.menu-item,
.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-store,
.hero-sales-value,
.user-name,
.store-name {
  display: block;
  color: #f7f5f0;
  font-size: 38rpx;
  font-weight: 700;
}

.hero-role,
.hero-sales-label,
.store-desc,
.user-meta {
  display: block;
  margin-top: 10rpx;
  color: #b8b1a6;
  font-size: 24rpx;
}

.hero-sales-row {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(247, 245, 240, 0.14);
}

.hero-sales-value {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 50rpx;
}

.primary-btn,
.ghost-btn,
.hero-switch,
.logout-btn {
  height: 72rpx;
  margin: 0;
  padding: 0 26rpx;
  border: none;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.primary-btn,
.logout-btn {
  background: #1d1d1f;
  color: #ffffff;
}

.ghost-btn,
.hero-switch {
  background: #f7f5f0;
  color: #3a3a3c;
}

.income-card .hero-switch {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 24rpx;
  background: #f7f5f0;
}

.primary-btn::after,
.ghost-btn::after,
.hero-switch::after,
.logout-btn::after {
  border: none;
}

.status-tag,
.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.green,
.status-pill {
  background: #eaf7ee;
  color: #287a3e;
}

.status-tag.gray {
  background: #f1f0ec;
  color: #8a8a8e;
}

.status-tag.blue,
.status-tag.orange {
  background: #fff4de;
  color: #8b6a32;
}

.alert-section,
.stats-grid,
.section,
.tabs,
.toolbar,
.order-card,
.goods-card,
.input-panel,
.result-panel {
  margin-top: 18rpx;
}

.alert-item {
  padding: 20rpx 24rpx;
  border-radius: 26rpx;
  background: #fff4de;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.alert-text,
.alert-arrow {
  color: #8b6a32;
  font-size: 24rpx;
  font-weight: 600;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.stats-card {
  min-height: 140rpx;
  padding: 26rpx;
  text-align: left;
}

.stats-card.highlight {
  background: #fff8ec;
  border: 1px solid #ecd5ae;
}

.stats-value {
  display: block;
  color: #1d1d1f;
  font-size: 42rpx;
  font-weight: 700;
}

.stats-label,
.row-meta,
.order-meta,
.order-code,
.goods-meta,
.goods-subtitle,
.empty-text {
  display: block;
  margin-top: 8rpx;
  color: #8a8a8e;
  font-size: 24rpx;
}

.section {
  padding: 28rpx;
}

.section-headline {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.section-subtitle {
  color: #8a8a8e;
  font-size: 23rpx;
}

.section-title,
.row-title,
.order-title,
.goods-title,
.menu-label {
  display: block;
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 700;
}

.section-title.light {
  color: #f7f5f0;
}

.quick-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.quick-item {
  min-height: 104rpx;
  border-radius: 28rpx;
  background: #faf8f3;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #eee7db;
}

.quick-label {
  color: #3a3a3c;
  font-size: 24rpx;
  font-weight: 600;
}

.list-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #efeae0;
}

.list-row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-side {
  flex-shrink: 0;
  text-align: right;
}

.row-price,
.order-amount,
.goods-price {
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 700;
}

.tabs {
  padding: 10rpx;
  display: flex;
  gap: 12rpx;
}

.tab-item {
  flex: 1;
  height: 68rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8a8e;
  font-size: 24rpx;
}

.tab-item.active {
  background: #1d1d1f;
  color: #ffffff;
  font-weight: 600;
}

.order-card,
.goods-card,
.input-panel,
.result-panel,
.verify-hero {
  padding: 28rpx;
}

.mini-btn {
  height: 64rpx;
  min-width: 128rpx;
}

.verify-hero {
  background: #1d1d1f;
}

.code-input {
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #faf8f3;
  font-size: 28rpx;
}

.action-row {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}

.half-btn,
.toolbar-btn {
  flex: 1;
}

.goods-cover {
  position: relative;
  margin-bottom: 20rpx;
  height: 230rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f3efe6;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8a8e;
  font-size: 24rpx;
}

.goods-cover-image {
  position: absolute;
  left: -15%;
  top: -15%;
  width: 130%;
  height: 130%;
}

.goods-actions {
  margin-top: 20rpx;
}

.avatar-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  background: #c8a46a;
  color: #1d1d1f;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.store-block {
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #3a3a3c;
}

.menu-item {
  min-height: 96rpx;
  border-bottom: 1px solid #e8e5de;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-arrow {
  color: #8a8a8e;
  font-size: 40rpx;
}

.logout-btn {
  width: 100%;
  margin-top: 32rpx;
  height: 88rpx;
}

.empty-state,
.empty-inline {
  padding: 60rpx 0;
  text-align: center;
}

.merchant-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 112rpx;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  padding: 8rpx 14rpx calc(8rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid #f3efe6;
  box-sizing: border-box;
  z-index: 90;
}

.merchant-tabbar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  gap: 6rpx;
}

.merchant-tabbar__icon {
  width: 44rpx;
  height: 44rpx;
  background-color: #9a9a9e;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 44rpx 44rpx;
}

.merchant-tabbar__item.active .merchant-tabbar__icon {
  background-color: #c8a46a;
}

