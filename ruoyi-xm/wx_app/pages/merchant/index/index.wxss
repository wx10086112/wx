.merchant-index-redirect {
  min-height: 100vh;
  padding: 28rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 42%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
  display: flex;
  align-items: center;
  justify-content: center;
}

.redirect-card {
  min-width: 360rpx;
  padding: 42rpx 36rpx;
  border-radius: 38rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.redirect-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(45, 143, 232, 0.16);
  border-top-color: #2d8fe8;
}

.redirect-title {
  display: block;
  margin-top: 22rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}
