.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  background: #faf8f3;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border-radius: 32rpx;
  border: 1px solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 28, 22, 0.06);
  box-sizing: border-box;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.green {
  background: #eaf7ee;
  color: #287a3e;
}

.status-tag.orange {
  background: #fff4de;
  color: #8b6a32;
}

.status-tag.gray {
  background: #f1f0ec;
  color: #8a8a8e;
}

.tabs {
  padding: 10rpx;
  display: flex;
  gap: 12rpx;
}

.tab-item {
  flex: 1;
  height: 68rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8a8e;
  font-size: 24rpx;
}

.tab-item.active {
  background: #1d1d1f;
  color: #ffffff;
  font-weight: 600;
}

.record-card {
  margin-top: 18rpx;
  padding: 28rpx;
}

.record-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.record-main {
  flex: 1;
}

.record-title {
  display: block;
  font-size: 30rpx;
  color: #1d1d1f;
  font-weight: 600;
}

.record-meta,
.record-grid,
.record-error {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a8a8e;
  line-height: 1.6;
}

.record-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx 16rpx;
}

.record-error {
  display: block;
  color: #8b6a32;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #8a8a8e;
}
