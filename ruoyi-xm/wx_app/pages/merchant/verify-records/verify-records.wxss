.tabs {
  padding: 10rpx;
  display: flex;
  gap: 10rpx;
}

.tab-item {
  flex: 1;
  height: 68rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6f7d91;
  font-size: 24rpx;
}

.tab-item.active {
  background: #eaf2ff;
  color: #1f6feb;
  font-weight: 600;
}

.record-card {
  margin-top: 18rpx;
  padding: 24rpx;
}

.record-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.record-main {
  flex: 1;
}

.record-title {
  display: block;
  font-size: 30rpx;
  color: #1f2a37;
  font-weight: 600;
}

.record-meta,
.record-grid,
.record-error {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7a8798;
  line-height: 1.6;
}

.record-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx 16rpx;
}

.record-error {
  display: block;
  color: #d26b00;
}
