.merchant-login-page {
  min-height: 100vh;
  background: #FAF8F3;
  padding-bottom: 48rpx;
}

.page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 8rpx 8rpx 0;
}

.page-title {
  color: #1D1D1F;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #F1E7D2;
  color: #8B6A32;
  font-size: 22rpx;
  line-height: 1.2;
}

.store-card {
  padding: 32rpx;
  border-radius: 40rpx;
  background: #1D1D1F;
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.1);
}

.store-card__label {
  display: block;
  color: #C8A46A;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.store-card__body,
.store-card__empty {
  margin-top: 18rpx;
}

.store-card__name {
  display: block;
  color: #F7F5F0;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}

.store-card__meta-group {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.store-card__meta {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(247, 245, 240, 0.1);
  color: #D6D1C7;
  font-size: 22rpx;
  line-height: 1.3;
}

.store-card__empty-text {
  display: block;
  color: #D6D1C7;
  font-size: 28rpx;
  line-height: 1.6;
}

.form-panel {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.04);
}

.field-group + .field-group {
  margin-top: 20rpx;
}

.panel-label {
  display: block;
  margin-bottom: 12rpx;
  color: #8A8A8E;
  font-size: 24rpx;
  line-height: 1.4;
}

.login-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  border: 1px solid #E8E5DE;
  background: #FFFFFF;
  color: #1D1D1F;
  font-size: 28rpx;
  box-sizing: border-box;
}

.agreement-wrap {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1px solid #E8E5DE;
}

.login-btn {
  width: 100%;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #1D1D1F;
}

.login-btn[disabled] {
  opacity: 0.7;
}

.preview-btn {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 999rpx;
  border: 1px solid #D6C3A0;
  background: #FFF8EC;
  color: #8B6A32;
  font-size: 28rpx;
  line-height: 88rpx;
}

.login-tip {
  display: block;
  margin-top: 20rpx;
  color: #8A8A8E;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}
