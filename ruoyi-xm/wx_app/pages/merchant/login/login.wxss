.login-page {
  min-height: 100vh;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top right, rgba(59, 130, 246, 0.24), transparent 34%),
    linear-gradient(180deg, #edf4ff 0%, #f5f7fb 100%);
}

.hero-block {
  padding: 44rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1f6feb 0%, #3b82f6 100%);
  box-shadow: 0 18rpx 44rpx rgba(31, 111, 235, 0.18);
}

.hero-title {
  display: block;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  line-height: 1.6;
}

.entry-card {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(31, 51, 73, 0.06);
}

.entry-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.entry-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2a37;
}

.entry-card__status {
  font-size: 22rpx;
  color: #1f6feb;
}

.entry-card__body,
.entry-card__empty {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.entry-card__name {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.entry-card__meta,
.entry-card__empty {
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748b;
}

.login-panel {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.login-panel {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(31, 51, 73, 0.06);
}

.panel-label {
  display: block;
  font-size: 24rpx;
  color: #7a8798;
  margin-bottom: 12rpx;
}

.login-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #dce3eb;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1f2a37;
  box-sizing: border-box;
}

.login-btn {
  margin-top: 28rpx;
}

.login-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a8798;
  line-height: 1.7;
}

.apply-entry {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #7a8798;
}

.apply-link {
  color: #1f6feb;
  margin-left: 8rpx;
}
