.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  background: #faf8f3;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border-radius: 32rpx;
  border: 1px solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 16rpx 40rpx rgba(32, 28, 22, 0.06);
  box-sizing: border-box;
}

.primary-btn,
.ghost-btn {
  height: 72rpx;
  margin: 0;
  padding: 0 26rpx;
  border: none;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.primary-btn {
  background: #1d1d1f;
  color: #ffffff;
}

.ghost-btn {
  background: #f7f5f0;
  color: #3a3a3c;
  border: 1px solid #e8e5de;
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.blue {
  background: #fff4de;
  color: #a96f17;
}

.status-tag.green {
  background: #eaf7ee;
  color: #287a3e;
}

.status-tag.orange {
  background: #f7f0e4;
  color: #8b6a32;
}

.status-tag.gray {
  background: #f1f0ec;
  color: #8a8a8e;
}

.tabs-scroll {
  white-space: nowrap;
}

.tabs {
  padding: 10rpx;
  display: inline-flex;
  gap: 12rpx;
  min-width: 100%;
}

.tab-item {
  flex-shrink: 0;
  min-width: 120rpx;
  height: 68rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8a8e;
  font-size: 24rpx;
  padding: 0 20rpx;
}

.tab-item.active {
  background: #1d1d1f;
  color: #ffffff;
  font-weight: 600;
}

.order-card {
  margin-top: 18rpx;
  padding: 28rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.order-main {
  flex: 1;
  min-width: 0;
}

.order-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  text-align: right;
}

.order-no {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a8a8e;
}

.order-title {
  font-size: 32rpx;
  color: #1d1d1f;
  font-weight: 600;
}

.order-time {
  color: #8a8a8e;
  font-size: 22rpx;
  line-height: 1.4;
}

.order-meta {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.order-remark {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #746f66;
  font-style: italic;
}

.order-bottom {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-amount {
  font-size: 32rpx;
  color: #1d1d1f;
  font-weight: 700;
}

.order-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.action-btn {
  min-width: 132rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  font-size: 24rpx;
  padding: 0 20rpx;
}

.cancel-btn {
  background: #f7f5f0;
  color: #746f66;
}

.refund-btn {
  background: #c8a46a;
  color: #ffffff;
}

.cancel-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(29, 29, 31, 0.32);
  box-sizing: border-box;
}

.cancel-modal-card {
  width: 100%;
  padding: 34rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 80rpx rgba(32, 28, 22, 0.16);
  box-sizing: border-box;
}

.cancel-modal-title {
  display: block;
  font-size: 34rpx;
  color: #1d1d1f;
  font-weight: 700;
}

.cancel-modal-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a8a8e;
  line-height: 1.6;
}

.cancel-reason-input {
  margin-top: 24rpx;
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #faf8f3;
  color: #1d1d1f;
  font-size: 28rpx;
  box-sizing: border-box;
}

.cancel-modal-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.cancel-modal-btn {
  flex: 1;
  height: 78rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  font-size: 28rpx;
  margin: 0;
  border: none;
  padding: 0;
}

.cancel-modal-btn::after {
  border: none;
}

.cancel-modal-btn.secondary {
  background: #f7f5f0;
  color: #3a3a3c;
}

.cancel-modal-btn.primary {
  background: #1d1d1f;
  color: #ffffff;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #8a8a8e;
}

.merchant-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 108rpx;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 0;
  padding: 8rpx 18rpx calc(8rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid #f3efe6;
  box-sizing: border-box;
  z-index: 90;
}

.merchant-tabbar__item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
}

.merchant-tabbar__label {
  font-size: 22rpx;
  color: #9a9a9e;
  font-weight: 500;
}

.merchant-tabbar__item.active .merchant-tabbar__label {
  color: #c8a46a;
  font-weight: 600;
}
