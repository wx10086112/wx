<view class="page-shell">
  <scroll-view scroll-x class="tabs-scroll">
    <view class="tabs panel">
      <view
        wx:for="{{tabs}}"
        wx:key="value"
        class="tab-item {{currentTab === item.value ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="{{item.value}}"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{orderList.length}}">
    <view wx:for="{{orderList}}" wx:key="orderNo" class="order-card panel" bindtap="goOrderDetail" data-orderno="{{item.orderNo}}">
      <view class="order-top">
        <view class="order-main">
          <text class="order-title">{{item.title}}</text>
          <text class="order-no">订单号 {{item.orderNo}}</text>
        </view>
        <view class="order-side">
          <view class="status-tag {{item.statusMeta.className}}">{{item.statusMeta.text}}</view>
          <text class="order-time">{{item.payTimeText}}</text>
        </view>
      </view>
      <text class="order-meta">{{item.customerName}} · {{item.customerPhone}}</text>
      <text wx:if="{{item.remark}}" class="order-remark">{{item.remark}}</text>
      <view class="order-bottom">
        <text class="order-amount">¥{{item.payAmountText}}</text>
        <view class="order-actions">
          <button
            wx:if="{{item.status === 'PENDING_VERIFY'}}"
            class="ghost-btn action-btn cancel-btn"
            catchtap="handleCancelOrder"
            data-orderno="{{item.orderNo}}"
          >取消订单</button>
          <button
            wx:if="{{item.status === 'REFUNDING'}}"
            class="primary-btn action-btn refund-btn"
            catchtap="goRefundReview"
            data-orderno="{{item.orderNo}}"
          >退款审核</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-text">当前筛选条件下没有订单</text>
  </view>

  <view wx:if="{{cancelModalVisible}}" class="cancel-modal-mask">
    <view class="cancel-modal-card">
      <text class="cancel-modal-title">取消订单</text>
      <text class="cancel-modal-desc">请填写取消原因，便于后续对账和售后查看。</text>
      <textarea
        class="cancel-reason-input"
        value="{{cancelReason}}"
        bindinput="handleCancelReasonInput"
        placeholder="例如：客户临时无法到店"
        maxlength="80"
        auto-focus
      ></textarea>
      <view class="cancel-modal-actions">
        <button class="cancel-modal-btn secondary" bindtap="closeCancelModal">再想想</button>
        <button class="cancel-modal-btn primary" bindtap="confirmCancelOrder">确认取消</button>
      </view>
    </view>
  </view>

  <view class="merchant-tabbar safe-area-bottom">
    <view
      wx:for="{{merchantNavList}}"
      wx:key="key"
      class="merchant-tabbar__item {{item.active ? 'active' : ''}}"
      bindtap="goMerchantTab"
      data-url="{{item.url}}"
    >
      <text class="merchant-tabbar__label">{{item.label}}</text>
    </view>
  </view>
</view>
