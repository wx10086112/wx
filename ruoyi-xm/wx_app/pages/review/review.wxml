<view class="review-page">
  <view wx:if="{{submitted}}" class="success-state">
    <view class="success-icon">✅</view>
    <text class="success-title">评价提交成功</text>
    <text class="success-desc">感谢您的评价，您的反馈对我们非常重要</text>
    <button class="done-btn" bindtap="onDone">完成</button>
  </view>

  <view wx:else>
    <view class="review-product-card">
      <image src="{{order.image}}" class="review-product-image" mode="aspectFill"></image>
      <view class="review-product-info">
        <text class="review-product-title text-ellipsis-2">{{order.title}}</text>
        <text class="review-product-merchant text-muted">{{order.merchantName}}</text>
      </view>
    </view>

    <view class="review-section">
      <text class="section-label">服务评分</text>
      <view class="star-row">
        <text
          wx:for="{{[1,2,3,4,5]}}"
          wx:key="*this"
          class="star {{rating >= item ? 'star-active' : ''}}"
          bindtap="onStarTap"
          data-rating="{{item}}"
        >★</text>
        <text class="rating-text">{{ratingText}}</text>
      </view>
    </view>

    <view class="review-section">
      <text class="section-label">评价内容</text>
      <textarea
        class="review-textarea"
        placeholder="分享您的服务体验，帮助其他人做出选择..."
        maxlength="500"
        bindinput="onContentInput"
        value="{{content}}"
      />
      <text class="textarea-count">{{content.length}}/500</text>
    </view>

    <view class="review-section">
      <text class="section-label">上传图片（可选，最多3张）</text>
      <view class="image-grid">
        <view wx:for="{{imageList}}" wx:key="*this" class="image-item">
          <image src="{{item}}" class="review-image" mode="aspectFill"></image>
          <view class="image-remove" catchtap="onRemoveImage" data-index="{{index}}">×</view>
        </view>
        <view wx:if="{{imageList.length < 3}}" class="image-add" bindtap="onChooseImage">
          <text class="add-icon">+</text>
          <text class="add-text">添加图片</text>
        </view>
      </view>
    </view>

    <button
      class="submit-btn"
      bindtap="onSubmit"
      disabled="{{submitting}}"
    >
      {{submitting ? '提交中...' : '提交评价'}}
    </button>
  </view>
</view>
