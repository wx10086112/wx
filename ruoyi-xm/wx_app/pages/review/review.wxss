.review-page {
  min-height: 100vh;
  background: #f3f7fd;
  padding: 24rpx;
  box-sizing: border-box;
}

.review-product-card {
  display: flex;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 32rpx rgba(20, 69, 138, 0.06);
}

.review-product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.review-product-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.review-product-title {
  font-size: 28rpx;
  color: #20304a;
  font-weight: 600;
  line-height: 1.4;
}

.review-product-merchant {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a96a8;
}

.review-section {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 32rpx rgba(20, 69, 138, 0.06);
}

.section-label {
  display: block;
  font-size: 28rpx;
  color: #20304a;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.star-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.star {
  font-size: 52rpx;
  color: #d0d7de;
  transition: color 0.15s;
}

.star-active {
  color: #ffac33;
}

.rating-text {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #ff6f23;
  font-weight: 600;
}

.review-textarea {
  width: 100%;
  height: 240rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #f7f9fc;
  font-size: 28rpx;
  color: #20304a;
  line-height: 1.6;
}

.textarea-count {
  display: block;
  text-align: right;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b0bec5;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.review-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #f7f9fc;
  border: 2rpx dashed #d0d7de;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 52rpx;
  color: #b0bec5;
  line-height: 1;
}

.add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b0bec5;
}

.submit-btn {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #1677ff 0%, #64b1ff 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 16rpx 40rpx rgba(22, 119, 255, 0.2);
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #c0c4cc;
  color: #fff;
  box-shadow: none;
}

/* Success state */
.success-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx 0;
}

.success-icon {
  font-size: 120rpx;
}

.success-title {
  margin-top: 32rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #20304a;
}

.success-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8a96a8;
  text-align: center;
}

.done-btn {
  margin-top: 60rpx;
  width: 400rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #1677ff 0%, #64b1ff 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.done-btn::after {
  border: none;
}
