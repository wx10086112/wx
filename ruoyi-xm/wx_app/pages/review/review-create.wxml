<view class="simple-page">
  <view class="simple-card">
    <text class="simple-title">订单评价</text>
    <text class="simple-subtitle">订单号：{{orderNo}}</text>
  </view>

  <view class="simple-card">
    <text class="simple-title">本次体验评分</text>
    <slider min="1" max="5" step="1" value="{{score}}" show-value bindchange="onScoreChange" activeColor="#1677ff" />
    <text class="score-text">{{score}} 分</text>
  </view>

  <view class="simple-card">
    <text class="simple-title">评价标签</text>
    <view class="tag-list">
      <text
        wx:for="{{tagOptions}}"
        wx:key="index"
        class="tag-item {{item.selected ? 'active' : ''}}"
        data-tag="{{item.label}}"
        bindtap="toggleTag"
      >{{item.label}}</text>
    </view>
  </view>

  <view class="simple-card">
    <text class="simple-title">评价内容</text>
    <textarea
      class="review-textarea"
      maxlength="200"
      placeholder="说说本次到店体验"
      value="{{content}}"
      bindinput="onContentInput"
    ></textarea>
  </view>

  <button class="submit-btn" bindtap="submitReview">提交评价</button>
</view>
