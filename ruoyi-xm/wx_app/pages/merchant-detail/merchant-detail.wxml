<view class="merchant-detail-page">
  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{loadFailed}}" class="empty-state">
    <text class="empty-title">暂未获取到商家信息</text>
    <text class="empty-desc">请稍后刷新，或返回首页重新进入</text>
  </view>

  <view wx:else class="detail-content">
    <view class="store-card">
      <view class="store-main">
        <image wx:if="{{merchant.avatar || merchant.coverImage}}" src="{{merchant.avatar || merchant.coverImage}}" class="store-avatar" mode="aspectFill"></image>
        <view wx:else class="store-avatar placeholder">
          <text>店</text>
        </view>
        <view class="store-info">
          <view class="store-name-row">
            <text class="store-name">{{merchant.name || '暂无商家名称'}}</text>
            <view class="store-status {{merchant.businessStatus ? 'open' : 'closed'}}">
              {{merchant.businessStatusText}}
            </view>
          </view>
          <view class="store-sales-row">
            <text>月售{{merchant.sales || 0}}</text>
          </view>
          <view wx:if="{{merchant.displayTags.length}}" class="store-tag-row">
            <text wx:for="{{merchant.displayTags}}" wx:key="index" class="store-tag">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="store-time-row">
        <text class="time-strong">今日 {{merchant.businessHours || '暂无营业时间'}}</text>
        <text class="mini-tag">{{merchant.bookingText}}</text>
      </view>

      <view class="store-address-row">
        <view class="address-main">
          <text class="store-address">{{merchant.address || '暂无门店地址'}}</text>
          <text wx:if="{{merchant.distance}}" class="distance-text">距您 {{merchant.distance}}</text>
        </view>
        <view class="store-actions">
          <view class="store-action" catchtap="viewLocation">
            <text class="action-icon">⌖</text>
            <text>导航</text>
          </view>
          <view class="store-action" catchtap="makePhoneCall">
            <text class="action-icon">☎</text>
            <text>电话</text>
          </view>
        </view>
      </view>
    </view>

    <view class="detail-card">
      <view class="card-title-row">
        <text class="card-title">营业时间</text>
        <text class="card-tag">{{merchant.businessStatusText}}</text>
      </view>
      <text class="primary-text">{{merchant.businessHoursText || merchant.businessHours || '暂无营业时间'}}</text>
      <text class="muted-text">具体接待情况以门店实时确认为准</text>
    </view>

    <view wx:if="{{merchant.description}}" class="detail-card">
      <view class="card-title-row">
        <text class="card-title">商家简介</text>
      </view>
      <text class="primary-text">{{merchant.description}}</text>
    </view>

    <view class="detail-card">
      <view class="card-title-row">
        <text class="card-title">门店地址</text>
        <text wx:if="{{merchant.distance}}" class="distance-pill">距您 {{merchant.distance}}</text>
      </view>
      <text class="primary-text">{{merchant.address || '暂无门店地址'}}</text>
    </view>

    <view class="detail-card">
      <view class="card-title-row">
        <text class="card-title">服务能力</text>
      </view>
      <view wx:if="{{merchant.serviceAbilityTags.length}}" class="ability-block">
        <text class="ability-title">服务</text>
        <view class="tag-grid">
          <text wx:for="{{merchant.serviceAbilityTags}}" wx:key="index" class="ability-tag">{{item}}</text>
        </view>
      </view>
      <view wx:if="{{merchant.facilityTags.length}}" class="ability-block">
        <text class="ability-title">设施</text>
        <view class="tag-grid">
          <text wx:for="{{merchant.facilityTags}}" wx:key="index" class="ability-tag facility">{{item}}</text>
        </view>
      </view>
      <text wx:if="{{!merchant.serviceAbilityTags.length && !merchant.facilityTags.length}}" class="muted-text no-margin">暂无服务能力说明</text>
    </view>

    <view class="detail-card">
      <view class="card-title-row">
        <text class="card-title">门店相册</text>
        <text class="muted-inline">{{albumList.length}} 张</text>
      </view>
      <view wx:if="{{albumList.length}}" class="album-grid">
        <view wx:for="{{albumList}}" wx:key="index" class="album-item" bindtap="previewAlbum" data-index="{{index}}">
          <image src="{{item}}" class="album-image" mode="aspectFill"></image>
        </view>
      </view>
      <text wx:else class="muted-text no-margin">暂无门店图片</text>
    </view>

    <view wx:if="{{storeList.length}}" class="detail-card">
      <view class="card-title-row">
        <text class="card-title">门店列表</text>
        <text class="muted-inline">{{storeList.length}} 家</text>
      </view>
      <view wx:for="{{storeList}}" wx:key="id" class="store-list-item">
        <view class="store-list-name-row">
          <text class="primary-text">{{item.name}}</text>
          <text wx:if="{{item.isMain === 1}}" class="mini-tag">主门店</text>
        </view>
        <text class="muted-text no-margin">{{item.address || '暂无地址'}}</text>
        <text class="muted-text no-margin">{{item.phone || '暂无电话'}} · {{item.businessHours || '暂无营业时间'}}</text>
      </view>
    </view>
  </view>
</view>
