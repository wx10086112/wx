<view class="merchant-detail-page">
  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:else class="detail-content">
    <view class="detail-header">
      <text class="page-title">门店详情</text>
    </view>

    <view class="detail-card">
      <view class="card-title-row">
        <text class="card-title">营业时间</text>
        <text class="card-tag">{{merchant.businessStatus ? '营业中' : '休息中'}}</text>
      </view>
      <text class="primary-text">{{merchant.businessHoursText || merchant.businessHours}}</text>
      <text class="muted-text">具体接待情况以门店实时确认为准</text>
    </view>

    <view class="detail-card">
      <view class="card-title-row">
        <text class="card-title">门店地址</text>
        <text class="distance-pill">距您 {{merchant.distance}}</text>
      </view>
      <text class="primary-text">{{merchant.address}}</text>
      <view class="action-row">
        <view class="action-button" bindtap="viewLocation">
          <text class="action-icon">⌖</text>
          <text>导航</text>
        </view>
        <view class="action-button" bindtap="makePhoneCall">
          <text class="action-icon">☎</text>
          <text>电话</text>
        </view>
      </view>
    </view>

    <view class="detail-card">
      <view class="card-title-row">
        <text class="card-title">服务能力</text>
      </view>
      <view class="ability-block">
        <text class="ability-title">服务</text>
        <view class="tag-grid">
          <text wx:for="{{merchant.serviceAbilityTags}}" wx:key="index" class="ability-tag">{{item}}</text>
        </view>
      </view>
      <view class="ability-block">
        <text class="ability-title">设施</text>
        <view class="tag-grid">
          <text wx:for="{{merchant.facilityTags}}" wx:key="index" class="ability-tag facility">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="detail-card">
      <view class="card-title-row">
        <text class="card-title">门店相册</text>
        <text class="muted-inline">{{albumList.length}} 张</text>
      </view>
      <view class="album-grid">
        <view wx:for="{{albumList}}" wx:key="index" class="album-item" bindtap="previewAlbum" data-index="{{index}}">
          <image src="{{item}}" class="album-image" mode="aspectFill"></image>
        </view>
      </view>
    </view>
  </view>
</view>
