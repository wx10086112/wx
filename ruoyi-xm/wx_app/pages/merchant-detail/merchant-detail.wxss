.merchant-detail-page {
  min-height: 100vh;
  background: #F6F4EF;
  padding: 24rpx 24rpx 44rpx;
  box-sizing: border-box;
}

.loading-state,
.empty-state {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-text,
.empty-desc {
  color: #8A8A8E;
  font-size: 26rpx;
}

.empty-title {
  color: #1D1D1F;
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.hero-section {
  position: relative;
  padding-bottom: 44rpx;
}

.hero-media {
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 34rpx;
  overflow: hidden;
  background: #EDE7DB;
  box-shadow: 0 18rpx 46rpx rgba(32, 28, 22, 0.08);
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-image.placeholder {
  background: linear-gradient(135deg, #EEE6D4 0%, #F7F2E8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  padding: 0 40rpx;
  color: #A08A63;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.hero-card {
  margin: -54rpx 18rpx 0;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1px solid rgba(232, 229, 222, 0.9);
  box-shadow: 0 20rpx 44rpx rgba(32, 28, 22, 0.08);
  position: relative;
  z-index: 2;
  box-sizing: border-box;
}

.hero-card-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.hero-title-block {
  flex: 1;
  min-width: 0;
}

.hero-title {
  display: block;
  color: #171717;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.28;
}

.hero-meta-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hero-status {
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.hero-status.open {
  color: #287A3E;
  background: #EAF7EE;
}

.hero-status.closed {
  color: #8A8A8E;
  background: #F1F0EC;
}

.hero-meta-text {
  color: #746F66;
  font-size: 24rpx;
  line-height: 1.4;
}

.hero-nav-action {
  width: 120rpx;
  min-height: 120rpx;
  border-radius: 24rpx;
  background: #CFA06D;
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-nav-action:active,
.hero-phone-action:active {
  opacity: 0.8;
}

.hero-nav-icon {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.hero-nav-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-tag-row {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hero-tag,
.mini-tag {
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #F6F4EF;
  color: #746F66;
  font-size: 22rpx;
  line-height: 38rpx;
}

.hero-tag.highlight {
  background: #FFF4DE;
  color: #A96F17;
}

.hero-address-row {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #FAF8F3;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.hero-address-main {
  flex: 1;
  min-width: 0;
}

.hero-address {
  display: block;
  color: #1D1D1F;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.5;
}

.hero-hours {
  display: block;
  margin-top: 10rpx;
  color: #8A8A8E;
  font-size: 24rpx;
  line-height: 1.4;
}

.hero-phone-action {
  width: 120rpx;
  min-height: 96rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  border: 1px solid rgba(232, 229, 222, 0.95);
  color: #1D1D1F;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-phone-icon {
  font-size: 30rpx;
  line-height: 1;
}

.hero-phone-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}

.detail-card {
  margin-top: 22rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 1px solid rgba(232, 229, 222, 0.88);
  box-shadow: 0 12rpx 36rpx rgba(32, 28, 22, 0.05);
  box-sizing: border-box;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.card-title {
  color: #1D1D1F;
  font-size: 34rpx;
  font-weight: 800;
}

.primary-text {
  display: block;
  color: #202A3C;
  font-size: 30rpx;
  line-height: 1.55;
  font-weight: 650;
}

.muted-text {
  display: block;
  margin-top: 14rpx;
  color: #8A8A8E;
  font-size: 24rpx;
  line-height: 1.55;
}

.muted-text.no-margin {
  margin-top: 0;
}

.ability-block {
  margin-top: 22rpx;
}

.ability-block:first-of-type {
  margin-top: 0;
}

.ability-title {
  display: block;
  color: #3A4860;
  font-size: 28rpx;
  font-weight: 750;
  margin-bottom: 14rpx;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ability-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #A96F17;
  background: #FFF4DE;
  font-size: 24rpx;
  font-weight: 650;
}

.ability-tag.facility {
  color: #426C9E;
  background: #EEF5FF;
}

.store-list-item + .store-list-item {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1px solid #EFEAE0;
}

.store-list-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
