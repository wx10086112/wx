.merchant-detail-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 88% 6%, rgba(22, 119, 255, 0.16), transparent 30%),
    linear-gradient(180deg, #f4f8ff 0%, #f7f8fb 48%, #f3f5f8 100%);
  padding: 24rpx 24rpx 44rpx;
  box-sizing: border-box;
}

.loading-state,
.empty-state {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-text,
.empty-desc {
  color: #8a96a8;
  font-size: 26rpx;
}

.empty-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.store-card {
  padding: 26rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 24rpx 68rpx rgba(20, 55, 105, 0.14);
}

.store-main {
  display: flex;
  align-items: flex-start;
}

.store-avatar {
  width: 142rpx;
  height: 142rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  box-shadow: 0 12rpx 26rpx rgba(20, 55, 105, 0.16);
}

.store-avatar.placeholder {
  background: linear-gradient(135deg, #e9f3ff 0%, #f5f8ff 100%);
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
}

.store-info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.store-name-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.store-name {
  flex: 1;
  color: #161d2f;
  font-size: 38rpx;
  line-height: 1.22;
  font-weight: 800;
}

.store-status {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.store-status.open {
  color: #0b9b61;
  background: rgba(11, 155, 97, 0.1);
}

.store-status.closed {
  color: #8a96a8;
  background: #eef1f5;
}

.store-sales-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  color: #7b8798;
  font-size: 23rpx;
}

.store-tag-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.store-tag,
.mini-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #4c6f9d;
  background: #edf5ff;
  font-size: 22rpx;
}

.store-time-row {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eef1f6;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  color: #5c6573;
  font-size: 25rpx;
}

.time-strong {
  color: #1f2a3d;
  font-weight: 700;
}

.store-address-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.address-main {
  flex: 1;
  min-width: 0;
}

.store-address {
  display: block;
  color: #1f2a3d;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.45;
}

.distance-text {
  display: block;
  margin-top: 8rpx;
  color: #8a96a8;
  font-size: 24rpx;
}

.store-actions {
  display: flex;
  gap: 14rpx;
}

.store-action {
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  background: #f4f7fb;
  color: #20293b;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
}

.action-icon {
  margin-bottom: 4rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.detail-card {
  margin-top: 22rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 42rpx rgba(20, 55, 105, 0.07);
  box-sizing: border-box;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.card-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 800;
}

.card-tag,
.distance-pill {
  flex-shrink: 0;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  color: #1677ff;
  background: #eef6ff;
  font-size: 22rpx;
  font-weight: 650;
}

.primary-text {
  display: block;
  color: #202a3c;
  font-size: 30rpx;
  line-height: 1.55;
  font-weight: 650;
}

.muted-text {
  display: block;
  margin-top: 14rpx;
  color: #8a96a8;
  font-size: 24rpx;
}

.muted-text.no-margin {
  margin-top: 0;
}

.muted-inline {
  color: #8a96a8;
  font-size: 24rpx;
}

.ability-block {
  margin-top: 22rpx;
}

.ability-block:first-of-type {
  margin-top: 0;
}

.ability-title {
  display: block;
  color: #3a4860;
  font-size: 28rpx;
  font-weight: 750;
  margin-bottom: 14rpx;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ability-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #ff6f23;
  background: #fff3ec;
  font-size: 24rpx;
  font-weight: 650;
}

.ability-tag.facility {
  color: #426c9e;
  background: #eef5ff;
}

.album-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.album-item {
  height: 190rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #eef2f7;
}

.album-image {
  width: 100%;
  height: 100%;
}
