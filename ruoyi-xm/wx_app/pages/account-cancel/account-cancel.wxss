.account-cancel-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 64rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.94) 0%, rgba(231, 244, 255, 0.9) 42%, rgba(245, 249, 253, 0.98) 100%),
    #eef5fb;
}

.warning-card {
  padding: 48rpx 40rpx;
  border-radius: 38rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 18rpx 54rpx rgba(34, 73, 116, 0.09);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.warning-icon {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #fff0f0;
  border: 2rpx solid #f5a6a6;
}

.warning-line {
  position: absolute;
  left: 39rpx;
  top: 22rpx;
  width: 6rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #d94b4b;
}

.warning-dot {
  position: absolute;
  left: 38rpx;
  bottom: 20rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #d94b4b;
}

.warning-title {
  margin-top: 28rpx;
  color: #111827;
  font-size: 38rpx;
  font-weight: 780;
  line-height: 1.35;
}

.warning-desc {
  margin-top: 14rpx;
  color: #667085;
  font-size: 27rpx;
  line-height: 1.65;
}

.notice-card {
  margin-top: 28rpx;
  padding: 10rpx 0;
  border-radius: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 44rpx rgba(34, 73, 116, 0.08);
  overflow: hidden;
}

.notice-item {
  min-height: 118rpx;
  padding: 26rpx 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(20, 54, 91, 0.08);
}

.notice-item:last-child {
  border-bottom: none;
}

.notice-index {
  width: 36rpx;
  height: 36rpx;
  margin-top: 3rpx;
  border-radius: 50%;
  background: #fff0f0;
  color: #d94b4b;
  font-size: 22rpx;
  font-weight: 720;
  line-height: 36rpx;
  text-align: center;
  flex-shrink: 0;
}

.notice-text {
  flex: 1;
  color: #344054;
  font-size: 28rpx;
  line-height: 1.55;
}

.danger-btn {
  width: 100%;
  height: 82rpx;
  margin: 56rpx 0 0;
  padding: 0;
  border: 1rpx solid rgba(217, 75, 75, 0.22);
  border-radius: 999rpx;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.92), rgba(255, 240, 240, 0.92)),
    #fff0f0;
  color: #d94b4b;
  font-size: 28rpx;
  font-weight: 720;
  line-height: 82rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.danger-btn::after {
  border: none;
}

.danger-btn:active {
  transform: translateY(1rpx) scale(0.985);
  opacity: 0.9;
}

.danger-btn[disabled] {
  border-color: rgba(148, 163, 184, 0.12);
  background: #e4edf5;
  color: #98a2b3;
  box-shadow: none;
}
