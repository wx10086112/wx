.account-cancel-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 64rpx;
  background: #FAF8F3;
  box-sizing: border-box;
}

.warning-card {
  padding: 48rpx 40rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  box-shadow: 0 18rpx 54rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
}

.warning-icon {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #FEF3F2;
  border: 2rpx solid #FDA29B;
  box-sizing: border-box;
}

.warning-line {
  position: absolute;
  left: 39rpx;
  top: 22rpx;
  width: 6rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #D92D20;
}

.warning-dot {
  position: absolute;
  left: 38rpx;
  bottom: 20rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #D92D20;
}

.warning-title {
  margin-top: 28rpx;
  color: #1D1D1F;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.warning-desc {
  margin-top: 14rpx;
  color: #6F6F73;
  font-size: 27rpx;
  line-height: 1.65;
}

.notice-card {
  margin-top: 28rpx;
  padding: 10rpx 0;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.notice-item {
  min-height: 118rpx;
  padding: 26rpx 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  border-bottom: 1px solid #EDE9E1;
  box-sizing: border-box;
}

.notice-item:last-child {
  border-bottom: none;
}

.notice-index {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #FFF3F0;
  color: #D92D20;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
  flex-shrink: 0;
  margin-top: 3rpx;
}

.notice-text {
  flex: 1;
  color: #3A3A3C;
  font-size: 28rpx;
  line-height: 1.55;
}

.danger-btn {
  width: 100%;
  height: 96rpx;
  margin: 56rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  background: #D92D20;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 96rpx;
  box-shadow: 0 18rpx 36rpx rgba(217, 45, 32, 0.18);
}

.danger-btn::after {
  border: none;
}

.danger-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.danger-btn[disabled] {
  background: #F2B8B5;
  color: #FFFFFF;
  box-shadow: none;
}
