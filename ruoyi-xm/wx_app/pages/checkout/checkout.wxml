<view class="checkout-page">
  <view class="card">
    <view class="section-title">{{checkoutConfig.productSectionTitle}}</view>
    <view class="product-row">
      <image src="{{product.image}}" class="product-image" mode="aspectFill"></image>
      <view class="product-info">
        <text class="product-title">{{product.title}}</text>
        <text class="product-meta">{{merchant.name}}</text>
        <text class="product-price">¥{{product.price / 100}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">{{checkoutConfig.infoSectionTitle}}</view>
    <view class="line-row">
      <text>{{checkoutConfig.quantityLabel}}</text>
      <view class="quantity-box">
        <view class="quantity-btn" bindtap="changeQuantity" data-delta="-1">-</view>
        <text class="quantity-value">{{quantity}}</text>
        <view class="quantity-btn" bindtap="changeQuantity" data-delta="1">+</view>
      </view>
    </view>
    <view class="line-row">
      <text>{{checkoutConfig.phoneLabel}}</text>
      <input class="phone-input" type="number" maxlength="11" value="{{phone}}" bindinput="handlePhoneInput" placeholder="请输入手机号" />
    </view>
    <view class="line-row">
      <text>到店门店</text>
      <view class="line-value-group">
        <text>{{merchant.shortName || merchant.name}}</text>
        <text class="line-value-tip">{{merchant.distance}}</text>
      </view>
    </view>
    <view class="line-row">
      <text>{{checkoutConfig.couponLabel}}</text>
      <picker mode="selector" range="{{couponOptionList}}" bindchange="onCouponChange" value="{{couponIndex}}">
        <view class="picker-text">{{couponOptionList[couponIndex] || '暂无可用优惠券'}}</view>
      </picker>
    </view>
    <text class="coupon-hint">{{couponHintText}}</text>
  </view>

  <view class="card">
    <view class="section-title">{{checkoutConfig.priceSectionTitle}}</view>
    <view class="line-row">
      <text>{{checkoutConfig.subtotalLabel}}</text>
      <text>¥{{subtotalText}}</text>
    </view>
    <view class="line-row">
      <text>{{checkoutConfig.discountLabel}}</text>
      <text class="discount-text">-¥{{couponAmountText}}</text>
    </view>
    <view class="line-row total-row">
      <text>{{checkoutConfig.totalLabel}}</text>
      <text class="pay-text">¥{{payAmountText}}</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">{{checkoutConfig.useRuleSectionTitle}}</view>
    <view wx:for="{{useRuleList}}" wx:key="index" class="rule-line">{{item}}</view>
    <view class="notice-strip">
      <text class="notice-text">支付成功后自动生成到店核销码，可在订单中心随时查看。</text>
    </view>
    <text class="login-hint">{{checkoutConfig.loginHintText}}</text>
  </view>

  <view class="pay-bar safe-area-bottom">
    <view class="pay-summary">
      <text class="summary-label">{{checkoutConfig.paySummaryLabel}}</text>
      <text class="summary-price">¥{{payAmountText}}</text>
    </view>
    <button class="pay-btn" bindtap="submitOrder">{{checkoutConfig.submitButtonText}}</button>
  </view>
</view>
