.profile-edit-page {
  min-height: 100vh;
  background: #FAF8F3;
  padding: 24rpx 24rpx 64rpx;
  box-sizing: border-box;
}

.edit-section {
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.75);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  overflow: hidden;
}

.edit-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
  border-bottom: 1px solid #E8E5DE;
}

.edit-item:last-child {
  border-bottom: none;
}

.edit-item-avatar {
  padding: 24rpx 36rpx;
}

.edit-label {
  font-size: 32rpx;
  font-weight: 500;
  color: #1D1D1F;
  flex-shrink: 0;
  width: 140rpx;
}

.edit-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.avatar-btn {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  background: transparent;
  padding: 0;
  margin: 0 !important;
  border: none;
  line-height: normal;
  width: 100% !important;
}

.avatar-btn::after {
  border: none;
}

.edit-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F7F5F0;
  border: 1px solid #E8E5DE;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.edit-arrow {
  margin-left: 16rpx;
  font-size: 40rpx;
  color: #8A8A8E;
  font-weight: 300;
}

.edit-input {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
  color: #3A3A3C;
}

.edit-phone {
  font-size: 32rpx;
  color: #8A8A8E;
}

.edit-tip {
  margin-top: 24rpx;
  padding: 0 16rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #8A8A8E;
  line-height: 1.6;
}

.save-section {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  align-items: center;
  justify-content: center;
}

.profile-agreement {
  width: 100%;
}

.save-btn {
  width: 224rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #1D1D1F;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.save-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  background: #E8E5DE;
  color: #8A8A8E;
  box-shadow: none;
}

.account-section {
  margin-top: 64rpx;
}

.section-title {
  display: block;
  margin: 0 16rpx 16rpx;
  color: #8A8A8E;
  font-size: 24rpx;
  line-height: 1.4;
}

.account-card {
  min-height: 104rpx;
  padding: 0 36rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.65);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.account-card:active {
  opacity: 0.72;
}

.account-danger {
  color: #D92D20;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.account-arrow {
  color: #C3BFB7;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 300;
}
