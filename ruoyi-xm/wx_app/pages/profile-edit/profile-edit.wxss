.profile-edit-page {
  min-height: 100vh;
  background: #f3f7fd;
  padding: 24rpx;
  box-sizing: border-box;
}

.edit-section {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 40rpx rgba(20, 69, 138, 0.07);
  overflow: hidden;
}

.edit-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #edf2fb;
}

.edit-item:last-child {
  border-bottom: none;
}

.edit-item-avatar {
  padding: 20rpx 30rpx;
}

.edit-label {
  font-size: 30rpx;
  color: #20304a;
  flex-shrink: 0;
  width: 120rpx;
}

.edit-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.avatar-btn {
  display: flex;
  align-items: center;
  background: transparent;
  padding: 0;
  margin: 0;
  border: none;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.edit-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
}

.edit-arrow {
  margin-left: 12rpx;
  font-size: 32rpx;
  color: #b0bec5;
}

.edit-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #20304a;
}

.edit-phone {
  font-size: 28rpx;
  color: #8a96a8;
}

.edit-tip {
  margin-top: 24rpx;
  padding: 0 12rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #a0aab4;
  line-height: 1.6;
}

.save-section {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  align-items: center;
  justify-content: center;
}

.profile-agreement {
  width: 100%;
}

.save-btn {
  width: 238rpx;
  height: 88rpx;
  line-height: normal;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #1677ff 0%, #64b1ff 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 16rpx 40rpx rgba(22, 119, 255, 0.2);
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  background: #c0c4cc;
  color: #fff;
  box-shadow: none;
}
