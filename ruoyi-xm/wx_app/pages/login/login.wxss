.login-page {
  min-height: 100vh;
  padding: 120rpx 48rpx 58rpx;
  box-sizing: border-box;
  background: #FAF8F3;
  display: flex;
  flex-direction: column;
}

.login-hero {
  flex: 1;
  min-height: 620rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.brand-mark {
  width: 144rpx;
  height: 144rpx;
  border-radius: 40rpx;
  background: #1D1D1F;
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-mark__text {
  color: #C8A46A;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
}

.brand-title {
  display: block;
  max-width: 620rpx;
  margin-top: 54rpx;
  color: #1D1D1F;
  font-size: 48rpx;
  line-height: 1.2;
  font-weight: 800;
}

.brand-subtitle {
  display: block;
  max-width: 560rpx;
  margin-top: 24rpx;
  color: #8A8A8E;
  font-size: 28rpx;
  line-height: 1.6;
}

.login-actions {
  width: 100%;
}

.wechat-login-btn {
  width: 100%;
  height: 104rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  border: 1px solid rgba(255, 255, 255, 0.65);
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  color: #1D1D1F;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.wechat-login-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.wechat-login-btn::after,
.modal-btn::after {
  border: none;
}

.wechat-icon {
  width: 56rpx;
  height: 46rpx;
  margin-right: 16rpx;
}

.agreement-line {
  min-height: 56rpx;
  margin-top: 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 0 16rpx;
}

.agreement-check {
  width: 32rpx;
  height: 32rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  border: 1px solid #B0B0B5;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.agreement-check.checked {
  border-color: #1D1D1F;
  background: #1D1D1F;
}

.agreement-copy {
  flex: 1;
  min-width: 0;
  color: #8A8A8E;
  font-size: 24rpx;
  line-height: 1.65;
}

.agreement-link {
  color: #1D1D1F;
  font-weight: 600;
}

.login-footer {
  height: 72rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 18rpx;
  color: #8A8A8E;
  font-size: 26rpx;
}

.login-footer__link {
  line-height: 1.5;
}

.login-footer__divider {
  color: #D4D0C8;
  line-height: 1.5;
}

.agreement-modal {
  position: fixed;
  inset: 0;
  z-index: 1600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.modal-card {
  position: relative;
  width: 100%;
  padding: 56rpx 48rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  box-shadow: 0 32rpx 64rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
  text-align: center;
}

.modal-title {
  display: block;
  color: #1D1D1F;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.35;
}

.modal-content {
  margin-top: 34rpx;
  color: #3A3A3C;
  font-size: 28rpx;
  line-height: 1.65;
}

.modal-link {
  color: #1D1D1F;
  font-weight: 600;
}

.modal-actions {
  margin-top: 48rpx;
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 96rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.modal-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.modal-btn--secondary {
  color: #3A3A3C;
  background: #F7F5F0;
}

.modal-btn--primary {
  color: #FFFFFF;
  background: #1D1D1F;
}
