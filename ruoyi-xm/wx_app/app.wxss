page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.flex {
  display: flex;
}

.flex-col {
  flex-direction: column;
}

.flex-center {
  justify-content: center;
  align-items: center;
}

.flex-between {
  justify-content: space-between;
}

.flex-around {
  justify-content: space-around;
}

.flex-align-center {
  align-items: center;
}

.flex-1 {
  flex: 1;
}

.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

.text-bold {
  font-weight: bold;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.text-danger {
  color: #ff6b6b;
}

.text-success {
  color: #52c41a;
}

.text-warning {
  color: #faad14;
}

.text-muted {
  color: #999;
}

.bg-white {
  background-color: #fff;
}

.bg-gray {
  background-color: #f5f5f5;
}

.bg-danger {
  background-color: #ff6b6b;
}

.p-0 {
  padding: 0;
}

.p-24 {
  padding: 24rpx;
}

.p-32 {
  padding: 32rpx;
}

.pt-0 {
  padding-top: 0;
}

.pt-24 {
  padding-top: 24rpx;
}

.pb-24 {
  padding-bottom: 24rpx;
}

.px-24 {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.py-24 {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.m-0 {
  margin: 0;
}

.m-24 {
  margin: 24rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.mt-32 {
  margin-top: 32rpx;
}

.mb-16 {
  margin-bottom: 16rpx;
}

.mb-24 {
  margin-bottom: 24rpx;
}

.mr-16 {
  margin-right: 16rpx;
}

.mr-24 {
  margin-right: 24rpx;
}

.ml-16 {
  margin-left: 16rpx;
}

.fs-24 {
  font-size: 24rpx;
}

.fs-28 {
  font-size: 28rpx;
}

.fs-32 {
  font-size: 32rpx;
}

.fs-36 {
  font-size: 36rpx;
}

.fs-40 {
  font-size: 40rpx;
}

.fs-48 {
  font-size: 48rpx;
}

.radius-8 {
  border-radius: 8rpx;
}

.radius-12 {
  border-radius: 12rpx;
}

.radius-16 {
  border-radius: 16rpx;
}

.border-bottom {
  border-bottom: 1rpx solid #eee;
}

.border-top {
  border-top: 1rpx solid #eee;
}

.shadow-sm {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.shadow {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #fff;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-outline {
  background: #fff;
  color: #ff6b6b;
  border: 2rpx solid #ff6b6b;
}

.btn-outline:active {
  background: #fff5f5;
}

.btn-small {
  height: 64rpx;
  font-size: 28rpx;
  padding: 0 32rpx;
}

.btn-large {
  height: 96rpx;
  font-size: 36rpx;
}

.btn-disabled {
  background: #ccc;
  color: #fff;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-state-text {
  font-size: 28rpx;
  color: #999;
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.loading-text {
  margin-left: 16rpx;
  color: #999;
  font-size: 28rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  border-radius: 4rpx;
}

.tag-danger {
  background: #fff1f0;
  color: #ff6b6b;
}

.tag-success {
  background: #f6ffed;
  color: #52c41a;
}

.tag-warning {
  background: #fffbe6;
  color: #faad14;
}

.tag-default {
  background: #f5f5f5;
  color: #666;
}

.divider {
  height: 24rpx;
  background: #f5f5f5;
  width: 100%;
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.price {
  color: #ff6b6b;
  font-weight: bold;
}

.original-price {
  color: #999;
  text-decoration: line-through;
  font-size: 24rpx;
}

.status-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.status-pending {
  background: rgba(200, 164, 106, 0.1);
  color: #C8A46A;
}

.status-paid {
  background: rgba(29, 29, 31, 0.05);
  color: #1D1D1F;
}

.status-completed {
  background: #F7F5F0;
  color: #8A8A8E;
}

.status-cancelled {
  background: transparent;
  color: #B0B0B5;
  border: 1px solid #E8E5DE;
}

.status-refunding {
  background: rgba(200, 164, 106, 0.1);
  color: #C8A46A;
}

.page-shell {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.panel {
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 10rpx 30rpx rgba(31, 51, 73, 0.06);
}

.section-title {
  font-size: 32rpx;
  color: #1f2a37;
  font-weight: 600;
}

.section-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a8798;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status-tag.blue {
  background: #e7f0ff;
  color: #1f6feb;
}

.status-tag.green {
  background: #e8f8ee;
  color: #1a8f4b;
}

.status-tag.orange {
  background: #fff3e8;
  color: #d26b00;
}

.status-tag.gray {
  background: #edf1f5;
  color: #6f7d91;
}

.primary-btn,
.ghost-btn {
  height: 78rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  margin: 0;
  padding: 0 24rpx;
  border: none;
  line-height: 1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn {
  background: linear-gradient(135deg, #1f6feb 0%, #3b82f6 100%);
  color: #fff;
}

.ghost-btn {
  background: #eef4ff;
  color: #1f6feb;
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.empty-text {
  font-size: 26rpx;
  color: #7a8798;
}
