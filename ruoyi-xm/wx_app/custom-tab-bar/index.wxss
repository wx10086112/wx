.custom-tabbar {
  height: 112rpx;
  padding: 8rpx 24rpx calc(8rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid #f3efe6;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.tabbar-item {
  min-height: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tabbar-icon {
  width: 46rpx;
  height: 46rpx;
  background-color: #9a9a9e;
}

.tabbar-item.active .tabbar-icon {
  background-color: #c8a46a;
}

.tabbar-text {
  color: #9a9a9e;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1;
}

.tabbar-item.active .tabbar-text {
  color: #c8a46a;
  font-weight: 600;
}

