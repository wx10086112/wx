.mine-page {
  padding-bottom: 48rpx;
}

.profile-card {
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1f6feb 0%, #3b82f6 58%, #60a5fa 100%);
  box-shadow: 0 20rpx 52rpx rgba(31, 111, 235, 0.22);
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-mark {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-name {
  font-size: 38rpx;
  color: #ffffff;
  font-weight: 700;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-pill,
.status-pill {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
}

.status-pill {
  background: rgba(16, 185, 129, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
}

.user-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.store-block {
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.14);
}

.store-name {
  display: block;
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 600;
}

.store-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.section-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
}

.menu-item {
  min-height: 104rpx;
  padding: 20rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #edf1f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-label {
  display: block;
  font-size: 30rpx;
  color: #1f2a37;
  font-weight: 600;
}

.menu-arrow {
  margin-left: 20rpx;
  font-size: 34rpx;
  color: #a2adbd;
}

.logout-btn {
  margin-top: 28rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  color: #ef4444;
  background: #fff1f2;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  padding: 0;
}

.logout-btn::after {
  border: none;
}
