<view class="page-shell">
  <view class="tabs panel">
    <view
      wx:for="{{tabs}}"
      wx:key="value"
      class="tab-item {{currentTab === item.value ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="{{item.value}}"
    >
      {{item.label}}
    </view>
  </view>

  <view wx:if="{{canManageGoods}}">
    <!-- 顶部操作栏 -->
    <view class="toolbar">
      <button class="primary-btn toolbar-btn" bindtap="goAddGoods">+ 新增套餐</button>
      <button class="ghost-btn toolbar-btn" bindtap="toggleBatchMode">
        {{batchMode ? '退出批量' : '批量管理'}}
      </button>
    </view>

    <!-- 批量操作栏 -->
    <view wx:if="{{batchMode}}" class="batch-panel panel">
      <view class="batch-summary">
        <view class="batch-info">
          <text class="batch-title">批量管理</text>
          <text class="batch-count">已选 {{selectedIds.length}} / {{goodsList.length}} 项</text>
        </view>
        <button class="ghost-btn select-btn" bindtap="selectAll">
          {{selectedIds.length === goodsList.length ? '取消全选' : '全选'}}
        </button>
      </view>
      <view class="batch-actions">
        <button class="ghost-btn batch-action-btn" bindtap="batchOnShelf">批量上架</button>
        <button class="ghost-btn batch-action-btn danger" bindtap="batchOffShelf">批量下架</button>
      </view>
    </view>

    <!-- 商品列表 -->
    <view wx:for="{{goodsList}}" wx:key="goodsId" class="goods-card panel {{item.lowStock ? 'low-stock-card' : ''}}">
      <view wx:if="{{batchMode}}" class="goods-checkbox" bindtap="toggleSelectGoods" data-id="{{item.goodsId}}">
        <view class="checkbox-icon {{item.selected ? 'checked' : ''}}"></view>
      </view>
      <view class="goods-body">
        <view class="goods-cover {{item.imageUrl ? '' : 'empty'}}">
          <image wx:if="{{item.imageUrl}}" class="goods-cover-image" src="{{item.imageUrl}}" mode="aspectFill" style="{{item.imageCropStyle}}"></image>
          <text wx:else>暂无图片</text>
        </view>
        <view class="goods-top">
          <view>
            <text class="goods-title">{{item.title}}</text>
            <text class="goods-meta">{{item.categoryName}} · 库存 {{item.stock}} · 销量 {{item.sales}}</text>
            <text wx:if="{{item.lowStock}}" class="low-stock-tag">⚠️ 库存不足</text>
          </view>
          <view class="status-tag {{item.status === 'ON_SHELF' ? 'green' : 'gray'}}">
            {{item.status === 'ON_SHELF' ? '上架中' : '已下架'}}
          </view>
        </view>
        <text class="goods-subtitle">{{item.subtitle}}</text>
        <text class="goods-price">¥{{item.priceText}} <text class="goods-origin">¥{{item.originalPriceText}}</text></text>
        <view wx:if="{{!batchMode}}" class="goods-actions">
          <button class="ghost-btn mini-btn" bindtap="toggleGoodsStatus" data-id="{{item.goodsId}}">
            {{item.status === 'ON_SHELF' ? '下架' : '上架'}}
          </button>
          <button class="primary-btn mini-btn" bindtap="goEditGoods" data-id="{{item.goodsId}}">编辑</button>
        </view>
      </view>
    </view>

    <view wx:if="{{!goodsList.length}}" class="empty-state">
      <text class="empty-text">当前筛选条件下没有商品</text>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-text">当前账号没有商品管理权限</text>
  </view>

  <view wx:if="{{confirmModalVisible}}" class="confirm-modal-mask">
    <view class="confirm-modal-card">
      <text class="confirm-modal-title">{{confirmModal.title}}</text>
      <text class="confirm-modal-desc">{{confirmModal.desc}}</text>
      <view class="confirm-modal-actions">
        <button class="confirm-modal-btn secondary" bindtap="closeConfirmModal">取消</button>
        <button class="confirm-modal-btn primary" bindtap="confirmBatchAction">确认</button>
      </view>
    </view>
  </view>
</view>
