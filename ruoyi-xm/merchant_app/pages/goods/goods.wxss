.tabs {
  padding: 10rpx;
  display: flex;
  gap: 10rpx;
}

.tab-item {
  flex: 1;
  height: 68rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6f7d91;
  font-size: 24rpx;
}

.tab-item.active {
  background: #eaf2ff;
  color: #1f6feb;
  font-weight: 600;
}

.add-btn {
  margin-top: 18rpx;
}

.goods-card {
  margin-top: 18rpx;
  padding: 24rpx;
}

.goods-cover {
  height: 220rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eef4ff;
}

.goods-cover image {
  width: 100%;
  height: 100%;
}

.goods-cover.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7a8798;
  font-size: 24rpx;
}

.goods-top,
.goods-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.goods-title {
  display: block;
  font-size: 30rpx;
  color: #1f2a37;
  font-weight: 600;
}

.goods-meta,
.goods-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7a8798;
  line-height: 1.6;
}

.goods-price {
  display: block;
  margin-top: 18rpx;
  font-size: 32rpx;
  color: #1f6feb;
  font-weight: 700;
}

.goods-origin {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #9aa6b6;
  text-decoration: line-through;
}

.goods-actions {
  margin-top: 20rpx;
}

.mini-btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 24rpx;
}
