.finance-hero {
  padding: 34rpx 30rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  box-shadow: 0 18rpx 44rpx rgba(20, 184, 166, 0.18);
}

.hero-label,
.hero-meta {
  display: block;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.hero-amount {
  display: block;
  margin-top: 12rpx;
  color: #fff;
  font-size: 58rpx;
  font-weight: 700;
}

.hero-meta {
  margin-top: 10rpx;
}

.stats-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.stats-card {
  padding: 24rpx;
}

.stats-value {
  display: block;
  font-size: 32rpx;
  color: #1f2a37;
  font-weight: 700;
}

.stats-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a8798;
}

.account-panel,
.section-panel {
  margin-top: 22rpx;
  padding: 28rpx;
}

.account-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0 0;
}

.account-label {
  color: #7a8798;
  font-size: 24rpx;
}

.account-value {
  color: #1f2a37;
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
}

.account-status {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #059669;
  font-size: 22rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.filter-tabs {
  display: flex;
  gap: 8rpx;
}

.filter-tab {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #6f7d91;
  background: #f6f9ff;
}

.filter-tab.active {
  background: #1f6feb;
  color: #fff;
}

.ledger-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf1f5;
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.ledger-row:last-child {
  border-bottom: none;
}

.ledger-main {
  flex: 1;
}

.ledger-title {
  display: block;
  font-size: 28rpx;
  color: #1f2a37;
  font-weight: 600;
}

.ledger-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a8798;
  line-height: 1.5;
}

.ledger-side {
  text-align: right;
}

.ledger-amount {
  display: block;
  font-size: 28rpx;
  color: #0f766e;
  font-weight: 700;
}

.ledger-fee {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa6b6;
}

.ledger-status {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7a8798;
}

.ledger-status.processing {
  color: #d97706;
}

.ledger-status.done {
  color: #059669;
}

.ledger-status.failed {
  color: #dc2626;
}

.empty-inline {
  padding: 48rpx 0 12rpx;
  text-align: center;
}
