<view class="page-shell">
  <view class="settlement-hero">
    <text class="hero-kicker">结算中心</text>
    <text class="hero-label">待自动到账</text>
    <text class="hero-amount">¥{{overview.pendingAutoTransferText}}</text>
    <text class="hero-meta">微信官方 {{overview.autoTransferMode || 'T+1'}} 自动打款</text>
    <text class="hero-meta">预计下一次处理：{{overview.nextAutoTransferTimeText}}</text>
  </view>

  <view class="stats-grid">
    <view class="stats-card panel">
      <text class="stats-value">¥{{overview.settledAmountText}}</text>
      <text class="stats-label">已到账</text>
    </view>
    <view class="stats-card panel">
      <text class="stats-value">¥{{overview.processingAmountText}}</text>
      <text class="stats-label">打款中</text>
    </view>
    <view class="stats-card panel">
      <text class="stats-value">¥{{overview.pendingSettleText}}</text>
      <text class="stats-label">待结算</text>
    </view>
    <view class="stats-card panel">
      <text class="stats-value">{{overview.completedOrderCount || 0}}</text>
      <text class="stats-label">完成订单</text>
    </view>
  </view>

  <view class="panel section-panel account-panel">
    <view class="section-head account-head">
      <view>
        <text class="section-title">结算账户</text>
        <text class="section-subtitle">当前门店微信支付自动打款账户</text>
      </view>
      <text class="account-status {{settlementAccount.status === 'VERIFIED' ? 'verified' : 'pending'}}">
        {{settlementAccount.status === 'VERIFIED' ? '已验证' : '待确认'}}
      </text>
    </view>
    <view class="account-grid">
      <view class="account-item">
        <text class="account-label">账户名称</text>
        <text class="account-value">{{settlementAccount.accountName || '--'}}</text>
      </view>
      <view class="account-item">
        <text class="account-label">到账方式</text>
        <text class="account-value">{{settlementAccount.bankName || '--'}} 尾号 {{settlementAccount.accountNoTail || '--'}}</text>
      </view>
    </view>
  </view>

  <view class="panel section-panel">
    <view class="section-head">
      <text class="section-title">到账记录</text>
      <view class="filter-tabs">
        <text
          wx:for="{{filterTabs}}"
          wx:key="value"
          class="filter-tab {{currentFilter === item.value ? 'active' : ''}}"
          bindtap="switchFilter"
          data-filter="{{item.value}}"
        >{{item.label}}</text>
      </view>
    </view>
    <view wx:if="{{settlementRecordList.length}}">
      <view wx:for="{{settlementRecordList}}" wx:key="settlementId" class="ledger-row">
        <view class="ledger-main">
          <text class="ledger-title">{{item.title}}</text>
          <text wx:if="{{item.orderNo}}" class="ledger-meta">{{item.orderNo}}</text>
          <text class="ledger-meta">
            {{item.status === 'ARRIVED' ? '到账时间' : '预计到账'}}：
            {{item.status === 'ARRIVED' ? item.arriveTimeText : item.expectedTransferTimeText}}
          </text>
          <text class="ledger-meta">{{item.remark}}</text>
        </view>
        <view class="ledger-side">
          <text class="ledger-amount">¥{{item.amountText}}</text>
          <text class="ledger-status {{item.status === 'ARRIVED' ? 'arrived' : item.status === 'FAILED' ? 'failed' : 'processing'}}">{{item.statusText}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="empty-inline">
      <text class="empty-text">当前筛选条件下暂无到账记录</text>
    </view>
  </view>

  <view class="panel section-panel">
    <view class="section-head">
      <view>
        <text class="section-title">结算流水</text>
        <text class="section-subtitle">订单核销完成后进入微信自动结算链路</text>
      </view>
    </view>
    <view wx:if="{{ledgerList.length}}">
      <view wx:for="{{ledgerList}}" wx:key="ledgerId" class="ledger-row">
        <view class="ledger-main">
          <text class="ledger-title">{{item.title}}</text>
          <text class="ledger-meta">{{item.orderNo}} · 完成于 {{item.finishTimeText}}</text>
          <text class="ledger-meta">预计打款 {{item.settleTimeText}}</text>
        </view>
        <view class="ledger-side">
          <text class="ledger-amount">¥{{item.merchantAmountText}}</text>
          <text class="ledger-fee">平台佣金 ¥{{item.platformFeeAmountText}}</text>
          <text class="ledger-status">{{item.statusText}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="empty-inline">
      <text class="empty-text">暂无结算流水</text>
    </view>
  </view>
</view>
