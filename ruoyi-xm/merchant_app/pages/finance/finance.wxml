<view class="page-shell">
  <view class="finance-hero">
    <text class="hero-label">待自动到账金额</text>
    <text class="hero-amount">¥{{overview.pendingAutoTransferText}}</text>
    <text class="hero-meta">微信官方 {{overview.autoTransferMode || 'T+1'}} 自动打款 · 已扣除平台佣金 ¥{{overview.platformFeeText}}</text>
  </view>

  <view class="stats-grid">
    <view class="stats-card panel">
      <text class="stats-value">¥{{overview.todayIncomeText}}</text>
      <text class="stats-label">今日收益</text>
    </view>
    <view class="stats-card panel">
      <text class="stats-value">¥{{overview.monthIncomeText}}</text>
      <text class="stats-label">本月收益</text>
    </view>
    <view class="stats-card panel">
      <text class="stats-value">¥{{overview.pendingSettleText}}</text>
      <text class="stats-label">待T+1</text>
    </view>
    <view class="stats-card panel">
      <text class="stats-value">¥{{overview.settledText}}</text>
      <text class="stats-label">已到账</text>
    </view>
  </view>

  <view class="panel account-panel">
    <view class="section-head">
      <text class="section-title">结算账户</text>
      <text class="account-status">{{overview.settlementAccount.status || 'PENDING'}}</text>
    </view>
    <view class="account-row">
      <text class="account-label">结算主体</text>
      <text class="account-value">{{overview.settlementAccount.accountName || '-'}}</text>
    </view>
    <view class="account-row">
      <text class="account-label">结算银行</text>
      <text class="account-value">{{overview.settlementAccount.bankName || '-'}}</text>
    </view>
    <view class="account-row">
      <text class="account-label">银行卡尾号</text>
      <text class="account-value">{{overview.settlementAccount.accountNoTail || '-'}}</text>
    </view>
  </view>

  <view class="panel section-panel">
    <view class="section-head">
      <text class="section-title">订单结算流水</text>
      <view class="filter-tabs">
        <text
          wx:for="{{filterTabs}}"
          wx:key="value"
          class="filter-tab {{currentFilter === item.value ? 'active' : ''}}"
          bindtap="switchFilter"
          data-filter="{{item.value}}"
        >{{item.label}}</text>
      </view>
    </view>
    <view wx:if="{{ledgerList.length}}">
      <view wx:for="{{ledgerList}}" wx:key="ledgerId" class="ledger-row">
        <view class="ledger-main">
          <text class="ledger-title">{{item.title}}</text>
          <text class="ledger-meta">{{item.orderNo}} · {{item.finishTimeText}}</text>
          <text class="ledger-meta">预计到账 {{item.settleTimeText}}</text>
        </view>
        <view class="ledger-side">
          <text class="ledger-amount">¥{{item.merchantAmountText}}</text>
          <text class="ledger-fee">佣金 ¥{{item.platformFeeAmountText}}</text>
          <text class="ledger-status">{{item.statusText}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="empty-inline">
      <text class="empty-text">暂无分账流水</text>
    </view>
  </view>

  <view class="panel section-panel">
    <text class="section-title">到账记录</text>
    <view wx:if="{{settlementRecordList.length}}">
      <view wx:for="{{settlementRecordList}}" wx:key="settlementId" class="ledger-row">
        <view class="ledger-main">
          <text class="ledger-title">{{item.title}}</text>
          <text class="ledger-meta">{{item.orderNo || item.settlementId}} · 预计 {{item.expectedTransferTimeText}}</text>
          <text class="ledger-meta">{{item.remark}}</text>
        </view>
        <view class="ledger-side">
          <text class="ledger-amount">¥{{item.amountText}}</text>
          <text class="ledger-status {{item.status === 'TRANSFERRING' ? 'processing' : item.status === 'ARRIVED' ? 'done' : item.status === 'FAILED' ? 'failed' : ''}}">{{item.statusText}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="empty-inline">
      <text class="empty-text">暂无到账记录</text>
    </view>
  </view>
</view>
