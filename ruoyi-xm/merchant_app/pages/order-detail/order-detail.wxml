<view class="page-shell">
  <!-- 状态头部 -->
  <view class="status-hero {{order.statusMeta.className}}">
    <text class="status-hero-text">{{order.statusMeta.text}}</text>
    <text wx:if="{{order.status === 'PENDING_ACCEPT'}}" class="status-hero-tip">请尽快处理，超时未接单将自动取消</text>
    <text wx:if="{{order.status === 'ACCEPTED'}}" class="status-hero-tip">订单已接受，请尽快备货发出</text>
    <text wx:if="{{order.status === 'SHIPPING'}}" class="status-hero-tip">订单正在配送中，等待客户确认收货</text>
    <text wx:if="{{order.status === 'PENDING_VERIFY'}}" class="status-hero-tip">等待客户到店出示核销码使用</text>
    <text wx:if="{{order.status === 'COMPLETED'}}" class="status-hero-tip">订单已完成</text>
    <text wx:if="{{order.status === 'REJECTED'}}" class="status-hero-tip">该订单已被拒绝</text>
    <text wx:if="{{order.status === 'REFUNDING'}}" class="status-hero-tip">客户申请退款，等待处理</text>
  </view>

  <!-- 订单信息 -->
  <view class="detail-card panel">
    <text class="detail-section-title">商品信息</text>
    <text class="detail-title">{{order.title}}</text>
    <view class="detail-grid">
      <view class="detail-row">
        <text class="detail-label">订单编号</text>
        <text class="detail-value">{{order.orderNo}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">数量</text>
        <text class="detail-value">{{order.quantity}} 份</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">金额</text>
        <text class="detail-value price">¥{{order.payAmountText}}</text>
      </view>
      <view wx:if="{{order.writeOffCode}}" class="detail-row">
        <text class="detail-label">核销码</text>
        <text class="detail-value code">{{order.writeOffCode}}</text>
      </view>
    </view>
  </view>

  <!-- 客户信息 -->
  <view class="detail-card panel">
    <text class="detail-section-title">客户信息</text>
    <view class="detail-grid">
      <view class="detail-row">
        <text class="detail-label">客户</text>
        <text class="detail-value">{{order.customerName}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">电话</text>
        <text class="detail-value">{{order.customerPhone}}</text>
      </view>
      <view wx:if="{{order.deliveryAddress}}" class="detail-row">
        <text class="detail-label">配送地址</text>
        <text class="detail-value">{{order.deliveryAddress}}</text>
      </view>
      <view wx:if="{{order.deliveryPhone}}" class="detail-row">
        <text class="detail-label">配送电话</text>
        <text class="detail-value">{{order.deliveryPhone}}</text>
      </view>
      <view wx:if="{{order.remark}}" class="detail-row">
        <text class="detail-label">备注</text>
        <text class="detail-value remark">{{order.remark}}</text>
      </view>
    </view>
  </view>

  <!-- 时间轴 -->
  <view class="detail-card panel">
    <text class="detail-section-title">订单进度</text>
    <view class="timeline">
      <view class="timeline-item done">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-label">创建订单</text>
          <text class="timeline-time">{{order.createTimeText}}</text>
        </view>
      </view>
      <view class="timeline-item done">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-label">支付完成</text>
          <text class="timeline-time">{{order.payTimeText}}</text>
        </view>
      </view>
      <view wx:if="{{order.acceptTimeText}}" class="timeline-item done">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-label">商家接单</text>
          <text class="timeline-time">{{order.acceptTimeText}}</text>
        </view>
      </view>
      <view wx:if="{{order.rejectTimeText}}" class="timeline-item failed">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-label">商家拒单</text>
          <text class="timeline-time">{{order.rejectTimeText}}</text>
          <text wx:if="{{order.rejectReason}}" class="timeline-reason">原因：{{order.rejectReason}}</text>
        </view>
      </view>
      <view wx:if="{{order.shipTimeText}}" class="timeline-item done">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-label">商家发货</text>
          <text class="timeline-time">{{order.shipTimeText}}</text>
        </view>
      </view>
      <view wx:if="{{order.verifyTimeText}}" class="timeline-item done">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-label">核销完成</text>
          <text class="timeline-time">{{order.verifyTimeText}}</text>
          <text wx:if="{{order.verifyStaffName}}" class="timeline-reason">核销人：{{order.verifyStaffName}}</text>
        </view>
      </view>
      <view wx:if="{{order.completeTimeText}}" class="timeline-item done">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-label">订单完成</text>
          <text class="timeline-time">{{order.completeTimeText}}</text>
        </view>
      </view>
      <view wx:if="{{order.refundReason}}" class="timeline-item failed">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-label">退款申请</text>
          <text class="timeline-reason">原因：{{order.refundReason}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮区域 -->
  <view class="action-bar safe-area-bottom">
    <!-- 待接单 -->
    <block wx:if="{{order.status === 'PENDING_ACCEPT'}}">
      <button class="ghost-btn action-btn reject-style" bindtap="handleRejectOrder">拒单</button>
      <button class="primary-btn action-btn" bindtap="handleAcceptOrder">接单</button>
    </block>
    <!-- 已接单 -->
    <block wx:if="{{order.status === 'ACCEPTED'}}">
      <button class="ghost-btn action-btn cancel-style" bindtap="handleCancelOrder">取消订单</button>
      <button class="primary-btn action-btn" bindtap="handleShipOrder">确认发货</button>
    </block>
    <!-- 配送中 -->
    <button wx:if="{{order.status === 'SHIPPING'}}" class="primary-btn action-btn" bindtap="handleCompleteOrder">确认送达</button>
    <!-- 待核销 -->
    <block wx:if="{{order.status === 'PENDING_VERIFY'}}">
      <button class="ghost-btn action-btn cancel-style" bindtap="handleCancelOrder">取消订单</button>
      <button class="primary-btn action-btn" bindtap="goVerify">去核销</button>
    </block>
    <!-- 退款中：审核 -->
    <block wx:if="{{order.status === 'REFUNDING'}}">
      <button class="ghost-btn action-btn reject-style" bindtap="handleRejectRefund">拒绝退款</button>
      <button class="primary-btn action-btn refund-approve" bindtap="handleApproveRefund">同意退款</button>
    </block>
  </view>
</view>

