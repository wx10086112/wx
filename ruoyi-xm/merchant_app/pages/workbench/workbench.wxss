.hero-card {
  padding: 28rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #1f6feb 0%, #3b82f6 100%);
  box-shadow: 0 18rpx 44rpx rgba(31, 111, 235, 0.18);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-store {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.hero-role,
.hero-notice {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.6;
}

.hero-switch {
  margin-top: 22rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 18rpx;
  border: none;
  color: #1f6feb;
  background: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
}

.hero-switch::after {
  border: none;
}

.stats-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.stats-card {
  padding: 26rpx 24rpx;
}

.stats-value {
  display: block;
  font-size: 40rpx;
  color: #1f2a37;
  font-weight: 700;
}

.stats-label {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7a8798;
}

.section {
  margin-top: 22rpx;
  padding: 28rpx;
}

.quick-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.quick-item {
  min-height: 112rpx;
  border-radius: 16rpx;
  background: #f6f9ff;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 20rpx;
}

.quick-label {
  font-size: 26rpx;
  color: #304256;
  font-weight: 600;
}

.pending-row {
  margin-top: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf1f5;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.pending-row:last-child {
  border-bottom: none;
}

.pending-main {
  flex: 1;
}

.pending-title {
  display: block;
  font-size: 28rpx;
  color: #1f2a37;
  font-weight: 600;
}

.pending-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7a8798;
}

.pending-side {
  text-align: right;
}

.pending-price {
  display: block;
  font-size: 28rpx;
  color: #1f6feb;
  font-weight: 600;
}

.pending-code {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7a8798;
}

.empty-inline {
  padding: 48rpx 0 20rpx;
  text-align: center;
}
