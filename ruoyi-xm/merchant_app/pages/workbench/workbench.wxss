.hero-card {
  padding: 28rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #1f6feb 0%, #3b82f6 100%);
  box-shadow: 0 18rpx 44rpx rgba(31, 111, 235, 0.18);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-store {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.hero-role {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.hero-sales-row {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.hero-sales-label {
  display: block;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.hero-sales-value {
  display: block;
  margin-top: 6rpx;
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
}

.hero-switch {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  border: none;
  color: #1f6feb;
  background: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  margin: 0;
}

.hero-switch::after {
  border: none;
}

/* 提醒区域 */
.alert-section {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.alert-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
}

.alert-item.urgent {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
}

.alert-item.warning {
  background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
}

.alert-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.alert-text {
  flex: 1;
  font-size: 24rpx;
  color: #92400e;
  font-weight: 600;
}

.alert-item.warning .alert-text {
  color: #991b1b;
}

.alert-arrow {
  font-size: 28rpx;
  color: #92400e;
  flex-shrink: 0;
}

/* 数据网格 */
.stats-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.stats-card {
  padding: 22rpx 20rpx;
  text-align: center;
}

.stats-card.highlight {
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  border: 2rpx solid #93c5fd;
}

.stats-card.warn {
  background: linear-gradient(135deg, #fefce8 0%, #fef9c3 100%);
  border: 2rpx solid #fde047;
}

.stats-value {
  display: block;
  font-size: 38rpx;
  color: #1f2a37;
  font-weight: 700;
}

.stats-card.highlight .stats-value {
  color: #1f6feb;
}

.stats-card.warn .stats-value {
  color: #d97706;
}

.stats-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7a8798;
}

/* 区块 */
.section {
  margin-top: 18rpx;
  padding: 24rpx;
}

.quick-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 18rpx 10rpx;
  border-radius: 16rpx;
  background: #f6f9ff;
  min-height: 120rpx;
}

.quick-icon {
  font-size: 40rpx;
  line-height: 1;
}

.quick-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #304256;
  font-weight: 600;
}

/* 待处理订单 */
.pending-row {
  margin-top: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f5;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.pending-row:last-child {
  border-bottom: none;
}

.pending-main {
  flex: 1;
}

.pending-title {
  display: block;
  font-size: 28rpx;
  color: #1f2a37;
  font-weight: 600;
}

.pending-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a8798;
}

.pending-side {
  text-align: right;
}

.pending-price {
  display: block;
  font-size: 28rpx;
  color: #1f6feb;
  font-weight: 600;
}

.pending-code {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7a8798;
}

.mini-tag {
  font-size: 20rpx;
  margin-top: 6rpx;
  padding: 4rpx 10rpx;
}

.empty-inline {
  padding: 48rpx 0 20rpx;
  text-align: center;
}
