<view class="page-shell">
  <view wx:if="{{canManageStaff}}">
    <!-- 员工列表 -->
    <view class="panel staff-panel">
      <view class="panel-header">
        <text class="section-title">员工列表</text>
        <button class="ghost-btn add-staff-btn" bindtap="showAddStaff">+ 添加员工</button>
      </view>
      <view wx:for="{{staffList}}" wx:key="staffId" class="staff-row {{selectedStaffId === item.staffId ? 'active' : ''}}" bindtap="selectStaff" data-id="{{item.staffId}}">
        <view class="staff-main">
          <view class="staff-name-row">
            <text class="staff-name">{{item.name}}</text>
            <text class="staff-role-tag">{{item.roleName}}</text>
          </view>
          <text class="staff-meta">{{item.phone}}</text>
        </view>
        <view class="staff-side">
          <view class="status-tag {{item.status === 'ACTIVE' ? 'green' : 'gray'}}">
            {{item.status === 'ACTIVE' ? '启用中' : '已停用'}}
          </view>
          <view class="staff-btn-group">
            <button class="ghost-btn mini-btn" catchtap="showEditStaff" data-id="{{item.staffId}}">编辑</button>
            <button class="ghost-btn mini-btn" catchtap="toggleStaffStatus" data-id="{{item.staffId}}">
              {{item.status === 'ACTIVE' ? '停用' : '启用'}}
            </button>
          </view>
        </view>
      </view>
    </view>

    <!-- 权限配置 -->
    <view class="panel permission-panel">
      <text class="section-title">权限配置</text>
      <checkbox-group bindchange="handlePermissionChange">
        <label wx:for="{{permissionOptions}}" wx:key="value" class="permission-row">
          <view class="permission-main">
            <text class="permission-title">{{item.label}}</text>
            <text class="permission-code">{{item.value}}</text>
          </view>
          <checkbox value="{{item.value}}" checked="{{selectedPermissionList.indexOf(item.value) > -1}}" color="#1f6feb"></checkbox>
        </label>
      </checkbox-group>
      <button class="primary-btn save-btn" bindtap="savePermission">保存权限</button>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-text">当前账号没有员工权限管理能力</text>
  </view>

  <!-- 添加员工弹窗 -->
  <view wx:if="{{showAddPanel}}" class="modal-mask" bindtap="hideAddPanel">
    <view class="modal-panel panel" catchtap="">
      <text class="modal-title">添加新员工</text>
      <view class="modal-field">
        <text class="field-label">姓名</text>
        <input class="field-input" value="{{newStaff.name}}" data-key="name" bindinput="handleNewStaffInput" placeholder="请输入姓名" />
      </view>
      <view class="modal-field">
        <text class="field-label">手机号</text>
        <input class="field-input" type="number" value="{{newStaff.phone}}" data-key="phone" bindinput="handleNewStaffInput" placeholder="请输入手机号" />
      </view>
      <view class="modal-field">
        <text class="field-label">角色</text>
        <picker bindchange="handleNewStaffRole" value="{{newStaff.roleKey === 'manager' ? 0 : 1}}" range="{{roleOptions}}" range-key="label">
          <view class="field-input picker-display">{{newStaff.roleKey === 'manager' ? '店长' : '店员'}}</view>
        </picker>
      </view>
      <view class="modal-actions">
        <button class="ghost-btn modal-btn" bindtap="hideAddPanel">取消</button>
        <button class="primary-btn modal-btn" bindtap="submitAddStaff">确定添加</button>
      </view>
    </view>
  </view>

  <!-- 编辑员工弹窗 -->
  <view wx:if="{{showEditPanel}}" class="modal-mask" bindtap="hideEditPanel">
    <view class="modal-panel panel" catchtap="">
      <text class="modal-title">编辑员工信息</text>
      <view class="modal-field">
        <text class="field-label">姓名</text>
        <input class="field-input" value="{{editStaff.name}}" data-key="name" bindinput="handleEditStaffInput" placeholder="请输入姓名" />
      </view>
      <view class="modal-field">
        <text class="field-label">手机号</text>
        <input class="field-input" type="number" value="{{editStaff.phone}}" data-key="phone" bindinput="handleEditStaffInput" placeholder="请输入手机号" />
      </view>
      <view class="modal-actions">
        <button class="ghost-btn modal-btn" bindtap="hideEditPanel">取消</button>
        <button class="primary-btn modal-btn" bindtap="submitEditStaff">保存修改</button>
      </view>
    </view>
  </view>
</view>
