.form-panel {
  padding: 28rpx;
}

.panel-title {
  display: block;
  font-size: 30rpx;
  color: #1f2a37;
  font-weight: 700;
}

.panel-title.separator {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #edf1f5;
}

.field {
  margin-top: 20rpx;
}

.field:first-child {
  margin-top: 0;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #7a8798;
}

.field-input,
.field-textarea {
  margin-top: 12rpx;
  width: 100%;
  border-radius: 16rpx;
  background: #f6f9ff;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1f2a37;
}

.field-input {
  height: 84rpx;
}

.field-textarea {
  min-height: 160rpx;
  padding-top: 18rpx;
}

.two-col {
  display: flex;
  gap: 14rpx;
}

.field-half {
  flex: 1;
}

.switch-row {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.field-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9aa6b6;
  line-height: 1.5;
}

.save-btn {
  margin-top: 30rpx;
}

